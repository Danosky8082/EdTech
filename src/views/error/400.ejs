<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= title || 'Bad Request' %> - EdTech
    </title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <style>
        body {
            background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
            min-height: 100vh;
        }

        .error-container {
            min-height: calc(100vh - 76px);
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
        }

        .error-card {
            background: white;
            border-radius: 15px;
            padding: 40px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
            border-top: 5px solid #dc3545;
            max-width: 600px;
            width: 100%;
        }

        .error-code {
            font-size: 6rem;
            font-weight: 800;
            color: #dc3545;
            line-height: 1;
            margin-bottom: 20px;
            text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.1);
        }

        .error-icon {
            font-size: 4rem;
            color: #ffc107;
            margin-bottom: 20px;
        }

        .error-title {
            color: #2c3e50;
            font-weight: 700;
            margin-bottom: 20px;
        }

        .error-message {
            color: #6c757d;
            font-size: 1.1rem;
            line-height: 1.6;
            margin-bottom: 30px;
        }

        .action-buttons {
            display: flex;
            gap: 15px;
            flex-wrap: wrap;
            justify-content: center;
        }

        .btn-custom {
            padding: 12px 25px;
            border-radius: 8px;
            font-weight: 600;
            transition: all 0.3s ease;
            min-width: 150px;
        }

        .btn-home {
            background: linear-gradient(135deg, #6a11cb 0%, #2575fc 100%);
            color: white;
            border: none;
        }

        .btn-home:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(106, 17, 203, 0.3);
        }

        .btn-back {
            background: white;
            color: #495057;
            border: 2px solid #dee2e6;
        }

        .btn-back:hover {
            background: #f8f9fa;
            border-color: #6c757d;
            transform: translateY(-2px);
        }

        .btn-refresh {
            background: linear-gradient(135deg, #20c997 0%, #28a745 100%);
            color: white;
            border: none;
        }

        .btn-refresh:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(32, 201, 151, 0.3);
        }

        .error-details {
            background: #f8f9fa;
            border-radius: 8px;
            padding: 15px;
            margin-top: 25px;
            font-size: 0.9rem;
            color: #6c757d;
            display: none;
        }

        .error-details.show {
            display: block;
        }

        @media (max-width: 768px) {
            .error-container {
                padding: 15px;
            }

            .error-card {
                padding: 25px;
            }

            .error-code {
                font-size: 4rem;
            }

            .error-icon {
                font-size: 3rem;
            }

            .action-buttons {
                flex-direction: column;
            }

            .btn-custom {
                width: 100%;
            }
        }
    </style>
</head>

<body>
    <%- include('../partials/navbar') %>

        <div class="error-container">
            <div class="error-card">
                <div class="text-center">
                    <div class="error-code">400</div>

                    <div class="error-icon">
                        <i class="fas fa-exclamation-triangle"></i>
                    </div>

                    <h1 class="error-title">
                        <%= title || 'Bad Request' %>
                    </h1>

                    <div class="error-message">
                        <% if (typeof message !=='undefined' && message) { %>
                            <p>
                                <%= message %>
                            </p>
                            <% } else { %>
                                <p>Your request could not be processed. Please check your input and try again.</p>
                                <% } %>

                                    <p class="text-muted mt-3">
                                        <i class="fas fa-info-circle me-1"></i>
                                        This might be due to invalid form data, expired links, or incorrect parameters.
                                    </p>
                    </div>

                    <div class="action-buttons">
                        <a href="/" class="btn btn-custom btn-home">
                            <i class="fas fa-home me-2"></i>Go to Homepage
                        </a>

                        <a href="javascript:history.back()" class="btn btn-custom btn-back">
                            <i class="fas fa-arrow-left me-2"></i>Go Back
                        </a>

                        <button onclick="window.location.reload()" class="btn btn-custom btn-refresh">
                            <i class="fas fa-redo me-2"></i>Try Again
                        </button>
                    </div>

                    <% if (process.env.NODE_ENV==='development' && error) { %>
                        <div class="error-details show mt-4">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <h6 class="mb-0">Error Details (Development Only):</h6>
                                <button onclick="toggleErrorDetails()" class="btn btn-sm btn-outline-secondary">
                                    <i class="fas fa-chevron-up"></i>
                                </button>
                            </div>
                            <pre class="mb-0 text-danger"><%= error.stack || error %></pre>
                        </div>
                        <% } %>

                            <!-- Support contact -->
                            <div class="mt-4 pt-3 border-top">
                                <p class="text-muted small">
                                    Need help? <a href="/contact" class="text-primary">Contact Support</a> or
                                    <a href="mailto:support@edtech.com" class="text-primary">Email Us</a>
                                </p>
                            </div>
                </div>
            </div>
        </div>

        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
        <script>
            // Auto-redirect after 10 seconds
            setTimeout(() => {
                if (confirm('Would you like to go back to the homepage?')) {
                    window.location.href = '/';
                }
            }, 10000);

            function toggleErrorDetails() {
                const details = document.querySelector('.error-details');
                const button = document.querySelector('.error-details button i');

                if (details.classList.contains('show')) {
                    details.classList.remove('show');
                    button.classList.remove('fa-chevron-up');
                    button.classList.add('fa-chevron-down');
                } else {
                    details.classList.add('show');
                    button.classList.remove('fa-chevron-down');
                    button.classList.add('fa-chevron-up');
                }
            }

            // Keyboard shortcuts
            document.addEventListener('keydown', function (e) {
                // Escape key to go back
                if (e.key === 'Escape') {
                    window.history.back();
                }
                // F5 or Ctrl+R to refresh
                if (e.key === 'F5' || (e.ctrlKey && e.key === 'r')) {
                    e.preventDefault();
                    window.location.reload();
                }
                // Ctrl+H to go home
                if (e.ctrlKey && e.key === 'h') {
                    e.preventDefault();
                    window.location.href = '/';
                }
            });

            // Add page transition effect
            document.addEventListener('DOMContentLoaded', function () {
                document.body.style.opacity = '0';
                document.body.style.transition = 'opacity 0.3s ease';

                setTimeout(() => {
                    document.body.style.opacity = '1';
                }, 100);
            });
        </script>
</body>

</html>