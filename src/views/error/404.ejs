<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= title %> - EdTech
    </title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <style>
        .error-container {
            min-height: 70vh;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .error-code {
            font-size: 8rem;
            font-weight: bold;
            color: #dc3545;
        }

        .error-message {
            font-size: 1.5rem;
            margin-bottom: 2rem;
        }
    </style>
</head>

<body>
    <!-- Check if user exists before including navbar -->
    <% if (user) { %>
        <%- include('../partials/navbar', { user: user, isSuperAdmin: isSuperAdmin, userSchool: userSchool }) %>
            <% } else { %>
                <!-- Simple navbar for non-authenticated users -->
                <nav class="navbar navbar-expand-lg navbar-dark bg-primary">
                    <div class="container">
                        <a class="navbar-brand" href="/">
                            <i class="fas fa-graduation-cap me-2"></i>
                            EdTech System
                        </a>
                    </div>
                </nav>
                <% } %>

                    <div class="container mt-4">
                        <div class="error-container text-center">
                            <div>
                                <h1 class="error-code">404</h1>
                                <h2 class="error-message">Page Not Found</h2>
                                <p class="lead mb-4">The page you are looking for doesn't exist or has been moved.</p>
                                <% if (user) { %>
                                    <a href="/admin/dashboard" class="btn btn-primary btn-lg">
                                        <i class="fas fa-tachometer-alt me-2"></i>Go to Dashboard
                                    </a>
                                    <% } else { %>
                                        <a href="/auth/login" class="btn btn-primary btn-lg">
                                            <i class="fas fa-sign-in-alt me-2"></i>Go to Login
                                        </a>
                                        <% } %>
                                            <a href="/" class="btn btn-outline-primary btn-lg ms-2">
                                                <i class="fas fa-home me-2"></i>Go to Home
                                            </a>
                            </div>
                        </div>
                    </div>

                    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>