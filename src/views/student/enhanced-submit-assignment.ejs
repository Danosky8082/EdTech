<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Submit Assignment - EdTech</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <!-- Include CKEditor -->
    <script src="https://cdn.ckeditor.com/ckeditor5/40.1.0/classic/ckeditor.js"></script>
    <style>
        .assignment-card {
            border-left: 4px solid #0d6efd;
        }

        .editor-container {
            min-height: 300px;
            border: 1px solid #dee2e6;
            border-radius: 5px;
        }

        .file-upload-area {
            border: 2px dashed #007bff;
            border-radius: 10px;
            padding: 2rem;
            text-align: center;
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .file-upload-area:hover {
            border-color: #0056b3;
            background-color: #f8f9fa;
        }

        .uploaded-file {
            background-color: #f8f9fa;
            border-radius: 5px;
            padding: 10px;
            margin-top: 10px;
        }

        .word-count {
            font-size: 0.9rem;
            color: #6c757d;
        }
    </style>
</head>

<body>
    <%- include('../partials/navbar') %>

        <div class="container mt-4">
            <%- include('../partials/alerts') %>

                <!-- School info banner -->
                <div class="alert alert-info mb-4">
                    <i class="fas fa-school me-2"></i>
                    <strong>School:</strong>
                    <%= userSchool %>
                </div>

                <!-- Back Button -->
                <div class="mb-4">
                    <a href="/student/class/<%= assignment.classId %>/assignments" class="btn btn-outline-secondary">
                        <i class="fas fa-arrow-left me-1"></i> Back to Assignments
                    </a>
                </div>

                <!-- Main Content -->
                <div class="row">
                    <div class="col-lg-8">
                        <!-- Assignment Details -->
                        <div class="card assignment-card mb-4">
                            <div class="card-header">
                                <h4 class="mb-0">
                                    <i class="fas fa-tasks me-2"></i>
                                    Submit Assignment: <%= assignment.title %>
                                </h4>
                            </div>
                            <div class="card-body">
                                <!-- Assignment Info -->
                                <div class="mb-4">
                                    <% if (assignment.description) { %>
                                        <div class="mb-3">
                                            <h6>Description:</h6>
                                            <p>
                                                <%= assignment.description %>
                                            </p>
                                        </div>
                                        <% } %>

                                            <div class="row">
                                                <div class="col-md-6">
                                                    <div class="mb-3">
                                                        <h6><i class="fas fa-calendar me-2"></i>Due Date:</h6>
                                                        <p class="mb-0">
                                                            <%= new Date(assignment.dueDate).toLocaleDateString() %>
                                                                <br>
                                                                <small class="text-muted">
                                                                    <%= new
                                                                        Date(assignment.dueDate).toLocaleTimeString([],
                                                                        {hour: '2-digit' , minute:'2-digit'}) %>
                                                                </small>
                                                        </p>
                                                        <% const now=new Date(); const dueDate=new
                                                            Date(assignment.dueDate); const timeRemaining=dueDate - now;
                                                            const hoursRemaining=Math.floor(timeRemaining / (1000 * 60 *
                                                            60)); const isOverdue=timeRemaining < 0; %>
                                                            <% if (isOverdue) { %>
                                                                <span class="badge bg-danger mt-2">Overdue</span>
                                                                <% } else if (hoursRemaining < 24) { %>
                                                                    <span class="badge bg-warning mt-2">Due in <%=
                                                                            hoursRemaining %> hours</span>
                                                                    <% } %>
                                                    </div>
                                                </div>
                                                <div class="col-md-6">
                                                    <div class="mb-3">
                                                        <h6><i class="fas fa-star me-2"></i>Points:</h6>
                                                        <p class="mb-0">
                                                            <%= assignment.points || 100 %> points
                                                        </p>
                                                    </div>
                                                </div>
                                            </div>
                                </div>

                                <!-- Submission Form -->
                                <form id="submitAssignmentForm"
                                    action="/student/assignments/<%= assignment.id %>/submit" method="POST"
                                    enctype="multipart/form-data">
                                    <!-- Submission Type Tabs -->
                                    <ul class="nav nav-tabs mb-4" id="submissionTypeTabs" role="tablist">
                                        <li class="nav-item" role="presentation">
                                            <button class="nav-link <%= submissionType === 'text' ? 'active' : '' %>"
                                                id="text-tab" data-bs-toggle="tab" data-bs-target="#text" type="button">
                                                <i class="fas fa-file-alt me-1"></i> Text Submission
                                            </button>
                                        </li>
                                        <li class="nav-item" role="presentation">
                                            <button class="nav-link <%= submissionType === 'file' ? 'active' : '' %>"
                                                id="file-tab" data-bs-toggle="tab" data-bs-target="#file" type="button">
                                                <i class="fas fa-file-upload me-1"></i> File Upload
                                            </button>
                                        </li>
                                        <li class="nav-item" role="presentation">
                                            <button class="nav-link <%= submissionType === 'link' ? 'active' : '' %>"
                                                id="link-tab" data-bs-toggle="tab" data-bs-target="#link" type="button">
                                                <i class="fas fa-link me-1"></i> Link Submission
                                            </button>
                                        </li>
                                    </ul>

                                    <!-- Tab Content -->
                                    <div class="tab-content mb-4" id="submissionTypeContent">
                                        <!-- Text Submission Tab -->
                                        <div class="tab-pane fade <%= submissionType === 'text' ? 'show active' : '' %>"
                                            id="text" role="tabpanel">
                                            <div class="mb-3">
                                                <label class="form-label">Your Answer:</label>
                                                <div id="editor" class="editor-container"></div>
                                                <textarea name="answerText" id="answerText"
                                                    style="display: none;"></textarea>
                                                <div class="word-count mt-2">
                                                    <span id="wordCount">0</span> words, <span id="charCount">0</span>
                                                    characters
                                                </div>
                                            </div>
                                        </div>

                                        <!-- File Upload Tab -->
                                        <div class="tab-pane fade <%= submissionType === 'file' ? 'show active' : '' %>"
                                            id="file" role="tabpanel">
                                            <div class="mb-3">
                                                <label class="form-label">Upload Assignment File:</label>
                                                <div class="file-upload-area" id="fileUploadArea">
                                                    <i class="fas fa-cloud-upload-alt fa-3x text-primary mb-3"></i>
                                                    <h5>Drag and drop your file here</h5>
                                                    <p class="text-muted">or click to browse</p>
                                                    <input type="file" class="form-control d-none" id="assignmentFile"
                                                        name="assignmentFile">
                                                    <small class="text-muted">Max file size: 10MB</small>
                                                    <br>
                                                    <small class="text-muted">Accepted formats: PDF, DOC, DOCX, TXT,
                                                        JPG, PNG, ZIP</small>
                                                </div>
                                                <div id="filePreview" class="mt-3"></div>
                                            </div>
                                        </div>

                                        <!-- Link Submission Tab -->
                                        <div class="tab-pane fade <%= submissionType === 'link' ? 'show active' : '' %>"
                                            id="link" role="tabpanel">
                                            <div class="mb-3">
                                                <label class="form-label">Submission Link:</label>
                                                <input type="url" class="form-control" name="submissionLink"
                                                    placeholder="https://docs.google.com/document/d/..."
                                                    pattern="https?://.+" title="Please enter a valid URL">
                                                <small class="text-muted">Enter a link to your submission (Google Docs,
                                                    GitHub, etc.)</small>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Additional Notes -->
                                    <div class="mb-4">
                                        <label class="form-label">Additional Notes (Optional):</label>
                                        <textarea class="form-control" name="submissionNotes" rows="3"
                                            placeholder="Add any additional comments or notes for your teacher..."></textarea>
                                    </div>

                                    <!-- Confirmation -->
                                    <% if (isOverdue) { %>
                                        <div class="alert alert-warning">
                                            <i class="fas fa-exclamation-triangle me-2"></i>
                                            This assignment is overdue. Late submissions may receive reduced marks.
                                        </div>
                                        <% } %>

                                            <!-- Submit Button -->
                                            <div class="d-grid gap-2">
                                                <button type="submit" class="btn btn-success btn-lg">
                                                    <i class="fas fa-paper-plane me-1"></i> Submit Assignment
                                                </button>
                                                <button type="button" class="btn btn-outline-secondary"
                                                    onclick="saveDraft()">
                                                    <i class="fas fa-save me-1"></i> Save as Draft
                                                </button>
                                            </div>
                                </form>
                            </div>
                        </div>
                    </div>

                    <!-- Sidebar -->
                    <div class="col-lg-4">
                        <!-- Submission Guidelines -->
                        <div class="card mb-4">
                            <div class="card-header">
                                <h5 class="mb-0">
                                    <i class="fas fa-info-circle me-2"></i>
                                    Submission Guidelines
                                </h5>
                            </div>
                            <div class="card-body">
                                <ul class="mb-0">
                                    <li>Make sure your submission meets all requirements</li>
                                    <li>Check formatting and spelling</li>
                                    <li>Submit before the due date to avoid penalties</li>
                                    <li>You can only submit once</li>
                                    <li>Contact your teacher if you encounter issues</li>
                                </ul>
                            </div>
                        </div>

                        <!-- Word Count Guidelines -->
                        <div class="card mb-4">
                            <div class="card-header">
                                <h5 class="mb-0">
                                    <i class="fas fa-file-word me-2"></i>
                                    Word Count Guidelines
                                </h5>
                            </div>
                            <div class="card-body">
                                <div class="mb-2">
                                    <small class="text-muted">Minimum words:</small>
                                    <span class="badge bg-info float-end">500</span>
                                </div>
                                <div class="mb-2">
                                    <small class="text-muted">Recommended:</small>
                                    <span class="badge bg-success float-end">800-1200</span>
                                </div>
                                <div class="mb-2">
                                    <small class="text-muted">Maximum words:</small>
                                    <span class="badge bg-warning float-end">2000</span>
                                </div>
                                <div class="progress mb-3" style="height: 8px;">
                                    <div class="progress-bar bg-success" id="wordProgress" style="width: 0%"></div>
                                </div>
                                <small class="text-muted">Aim for comprehensive but concise answers.</small>
                            </div>
                        </div>

                        <!-- Recent Submissions -->
                        <div class="card">
                            <div class="card-header">
                                <h5 class="mb-0">
                                    <i class="fas fa-history me-2"></i>
                                    Submission History
                                </h5>
                            </div>
                            <div class="card-body">
                                <% if (assignment.submissions && assignment.submissions.length> 0) { %>
                                    <div class="alert alert-warning">
                                        <i class="fas fa-exclamation-circle me-2"></i>
                                        You have already submitted this assignment.
                                        <br>
                                        <small>Submitting again will replace your previous submission.</small>
                                    </div>
                                    <% assignment.submissions.forEach(function(submission) { %>
                                        <div class="border rounded p-2 mb-2">
                                            <small class="text-muted d-block">
                                                Submitted: <%= new Date(submission.submittedAt).toLocaleString() %>
                                            </small>
                                            <% if (submission.grade !==null) { %>
                                                <small class="text-muted d-block">
                                                    Grade: <%= submission.grade %>/<%= assignment.points || 100 %>
                                                </small>
                                                <% } %>
                                        </div>
                                        <% }); %>
                                            <% } else { %>
                                                <p class="text-muted mb-0">No previous submissions</p>
                                                <% } %>
                            </div>
                        </div>
                    </div>
                </div>
        </div>

        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
        <script>
            const assignmentId = '<%= assignment.id %>';
            let editor;

            // Initialize CKEditor
            ClassicEditor
                .create(document.querySelector('#editor'), {
                    toolbar: [
                        'heading', '|',
                        'bold', 'italic', 'underline', 'strikethrough', '|',
                        'link', 'blockQuote', 'codeBlock', '|',
                        'bulletedList', 'numberedList', '|',
                        'indent', 'outdent', '|',
                        'undo', 'redo'
                    ],
                    placeholder: 'Type your answer here...',
                    wordCount: {
                        onUpdate: stats => {
                            updateWordCount(stats.words, stats.characters);
                        }
                    }
                })
                .then(newEditor => {
                    editor = newEditor;

                    // Update the hidden textarea on form submit
                    document.getElementById('submitAssignmentForm').addEventListener('submit', function () {
                        document.getElementById('answerText').value = editor.getData();
                    });
                })
                .catch(error => {
                    console.error('Error initializing CKEditor:', error);
                });

            // Update word count
            function updateWordCount(words, characters) {
                document.getElementById('wordCount').textContent = words;
                document.getElementById('charCount').textContent = characters;

                // Update progress bar
                const progress = Math.min((words / 1200) * 100, 100);
                document.getElementById('wordProgress').style.width = progress + '%';
            }

            // File upload functionality
            const fileUploadArea = document.getElementById('fileUploadArea');
            const fileInput = document.getElementById('assignmentFile');
            const filePreview = document.getElementById('filePreview');

            if (fileUploadArea && fileInput) {
                // Click to upload
                fileUploadArea.addEventListener('click', () => {
                    fileInput.click();
                });

                // File selected
                fileInput.addEventListener('change', () => {
                    if (fileInput.files.length > 0) {
                        const file = fileInput.files[0];
                        const fileSize = (file.size / (1024 * 1024)).toFixed(2); // Convert to MB

                        // Validate file size
                        if (file.size > 10 * 1024 * 1024) { // 10MB limit
                            alert('File is too large. Maximum size is 10MB.');
                            fileInput.value = '';
                            return;
                        }

                        // Show file preview
                        filePreview.innerHTML = `
                        <div class="uploaded-file">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <i class="fas fa-file fa-lg text-primary me-2"></i>
                                    <strong>${file.name}</strong>
                                </div>
                                <button type="button" class="btn btn-sm btn-outline-danger" onclick="removeFile()">
                                    <i class="fas fa-times"></i>
                                </button>
                            </div>
                            <small class="text-muted d-block mt-2">
                                Size: ${fileSize} MB | Type: ${file.type || 'Unknown'}
                            </small>
                        </div>
                    `;
                    }
                });

                // Drag and drop
                fileUploadArea.addEventListener('dragover', (e) => {
                    e.preventDefault();
                    fileUploadArea.style.borderColor = '#0056b3';
                    fileUploadArea.style.backgroundColor = '#e9ecef';
                });

                fileUploadArea.addEventListener('dragleave', () => {
                    fileUploadArea.style.borderColor = '#007bff';
                    fileUploadArea.style.backgroundColor = '';
                });

                fileUploadArea.addEventListener('drop', (e) => {
                    e.preventDefault();
                    fileUploadArea.style.borderColor = '#007bff';
                    fileUploadArea.style.backgroundColor = '';

                    if (e.dataTransfer.files.length) {
                        fileInput.files = e.dataTransfer.files;
                        fileInput.dispatchEvent(new Event('change'));
                    }
                });
            }

            // Remove file
            function removeFile() {
                fileInput.value = '';
                filePreview.innerHTML = '';
            }

            // Save draft
            function saveDraft() {
                    const formData = new FormData();
                    const submissionType = document.querySelector('.nav-link.active').getAttribute('data-bs-target').replace('#', '');

                    if (submissionType === 'text' && editor) {
                        formData.append('answerText', editor.getData());
                    } else if (submissionType === 'file' && fileInput.files.length > 0) {
                        formData.append('assignmentFile', fileInput.files[0]);
                    }

                    console.log('Saving draft...');
                    alert('Draft saved locally. Note: This is a demo. In production, this would save to the server.');

                    // Fixed: Use the assignmentId variable
                    localStorage.setItem(`draft_${assignmentId}`, JSON.stringify({
                        answerText: editor ? editor.getData() : '',
                        timestamp: new Date().toISOString()
                    }));
                }

        // Load draft on page load
        document.addEventListener('DOMContentLoaded', function () {
                // Fixed: Use the assignmentId variable
                const draft = localStorage.getItem(`draft_${assignmentId}`);
                if (draft) {
                    try {
                        const draftData = JSON.parse(draft);
                        const savedTime = new Date(draftData.timestamp);
                        const now = new Date();
                        const hoursDiff = Math.abs(now - savedTime) / 36e5; // hours

                        if (hoursDiff < 24) { // Only load drafts less than 24 hours old
                            if (confirm('You have a saved draft from ' + savedTime.toLocaleString() + '. Would you like to load it?')) {
                                if (editor && draftData.answerText) {
                                    editor.setData(draftData.answerText);
                                }
                            }
                        } else {
                            localStorage.removeItem(`draft_${assignmentId}`);
                        }
                    } catch (e) {
                        console.error('Error loading draft:', e);
                    }
                }
            });

        // Form validation
        document.getElementById('submitAssignmentForm').addEventListener('submit', function(e) {
            const activeTab = document.querySelector('.tab-pane.active');
            const tabId = activeTab ? activeTab.id : '';
            
            // Validate based on submission type
            if (tabId === 'text') {
                const textContent = editor ? editor.getData().trim() : '';
                if (!textContent) {
                    e.preventDefault();
                    alert('Please enter your answer before submitting.');
                    return;
                }
                
                // Check minimum word count
                const wordCount = textContent.split(/\s+/).length;
                if (wordCount < 100) {
                    if (!confirm('Your answer is very short (less than 100 words). Are you sure you want to submit?')) {
                        e.preventDefault();
                        return;
                    }
                }
            } else if (tabId === 'file') {
                if (!fileInput.files.length) {
                    e.preventDefault();
                    alert('Please select a file to upload.');
                    return;
                }
            } else if (tabId === 'link') {
                const linkInput = document.querySelector('input[name="submissionLink"]');
                if (!linkInput.value.trim()) {
                    e.preventDefault();
                    alert('Please enter a submission link.');
                    return;
                }
            }
            
            // Show loading state
            const submitBtn = this.querySelector('button[type="submit"]');
            submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin me-1"></i> Submitting...';
            submitBtn.disabled = true;
            
            // Remove draft after successful submission
           localStorage.removeItem(`draft_${assignmentId}`);
        });
        </script>
</body>

</html>