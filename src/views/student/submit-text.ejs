<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Submit Assignment - EdTech</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <!-- Quill Editor CSS -->
    <link href="https://cdn.quilljs.com/1.3.7/quill.snow.css" rel="stylesheet">
    <style>
        /* Your CSS styles remain the same */
    </style>
</head>

<body>
    <%- include('../partials/navbar') %>

        <div class="container mt-4">
            <%- include('../partials/alerts') %>

                <div class="row justify-content-center">
                    <div class="col-md-12 col-lg-10">
                        <div class="card shadow-lg">
                            <div class="card-header bg-gradient-primary text-white">
                                <h4 class="mb-0 d-flex align-items-center">
                                    <i class="fas fa-edit me-3"></i>
                                    Submit Assignment: <%= assignment.title %>
                                </h4>
                            </div>

                            <div class="card-body">
                                <!-- Assignment Info -->
                                <div class="assignment-info card mb-4 border-primary">
                                    <div class="card-body">
                                        <h5 class="card-title text-primary">
                                            <i class="fas fa-info-circle me-2"></i>Assignment Details
                                        </h5>
                                        <div class="row">
                                            <div class="col-md-6">
                                                <p class="mb-2"><strong><i
                                                            class="fas fa-school me-2"></i>Class:</strong>
                                                    <%= assignment.class.name %>
                                                </p>
                                                <p class="mb-2"><strong><i class="fas fa-clock me-2"></i>Due
                                                        Date:</strong>
                                                    <span
                                                        class="<%= new Date(assignment.dueDate) < new Date() ? 'text-danger' : '' %>">
                                                        <%= new Date(assignment.dueDate).toLocaleString() %>
                                                    </span>
                                                </p>
                                            </div>
                                            <div class="col-md-6">
                                                <% if (assignment.points) { %>
                                                    <p class="mb-2"><strong><i
                                                                class="fas fa-star me-2"></i>Points:</strong>
                                                        <span class="badge bg-warning text-dark">
                                                            <%= assignment.points %>
                                                        </span>
                                                    </p>
                                                    <% } %>
                                                        <p class="mb-0"><strong><i
                                                                    class="fas fa-file-alt me-2"></i>Type:</strong>
                                                            <span class="badge bg-info">Text Submission</span>
                                                        </p>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Description -->
                                <% if (assignment.description) { %>
                                    <div class="mb-4">
                                        <h5 class="text-secondary">
                                            <i class="fas fa-align-left me-2"></i>Description
                                        </h5>
                                        <div class="p-4 bg-light rounded border-start border-4 border-primary">
                                            <%= assignment.description %>
                                        </div>
                                    </div>
                                    <% } %>

                                        <!-- Submission Form -->
                                        <form id="submissionForm"
                                            action="/student/assignments/<%= assignment.id %>/submit-text" method="POST"
                                            enctype="multipart/form-data">

                                            <!-- Submission Title -->
                                            <div class="mb-4">
                                                <label for="title" class="form-label fw-bold">
                                                    <i class="fas fa-heading me-2"></i>Submission Title
                                                </label>
                                                <input type="text" class="form-control form-control-lg" id="title"
                                                    name="title"
                                                    placeholder="Enter a descriptive title for your submission" required
                                                    <% if (hasSubmission && assignment.submissions[0].textTitle) { %>
                                                value="<%= assignment.submissions[0].textTitle %>"
                                                    <% } %>
                                                        maxlength="100">
                                                        <div class="form-text">Maximum 100 characters</div>
                                            </div>

                                            <!-- Rich Text Editor -->
                                            <div class="mb-4">
                                                <label
                                                    class="form-label fw-bold d-flex justify-content-between align-items-center">
                                                    <span><i class="fas fa-edit me-2"></i>Your Answer</span>
                                                    <button type="button" id="fullscreenBtn"
                                                        class="btn btn-sm btn-outline-primary">
                                                        <i class="fas fa-expand"></i> Fullscreen
                                                    </button>
                                                </label>

                                                <div class="editor-container">
                                                    <!-- Hidden textarea for form submission -->
                                                    <textarea id="hiddenContent" name="content"
                                                        style="display: none;"></textarea>

                                                    <!-- Quill Editor Container -->
                                                    <div id="editor"></div>
                                                </div>

                                                <!-- Editor Statistics -->
                                                <div class="editor-stats">
                                                    <div>
                                                        <span class="word-count">Words: <span
                                                                id="wordCount">0</span></span>
                                                        <span class="character-count">Characters: <span
                                                                id="charCount">0</span></span>
                                                    </div>
                                                    <div class="auto-save-status" id="autoSaveStatus">
                                                        <i class="fas fa-save me-1"></i> Autosaved
                                                    </div>
                                                </div>
                                            </div>

                                            <!-- Formatting Tips -->
                                            <div class="formatting-tips mb-4">
                                                <h6><i class="fas fa-lightbulb me-2"></i>Formatting Tips</h6>
                                                <div class="tip-item">
                                                    <i class="fas fa-check-circle"></i> Use headings to organize your
                                                    content
                                                </div>
                                                <div class="tip-item">
                                                    <i class="fas fa-check-circle"></i> Add code blocks for programming
                                                    assignments
                                                </div>
                                                <div class="tip-item">
                                                    <i class="fas fa-check-circle"></i> Use bullet points for lists
                                                </div>
                                                <div class="tip-item">
                                                    <i class="fas fa-check-circle"></i> Attach relevant files as needed
                                                </div>
                                            </div>

                                            <!-- Action Buttons -->
                                            <div class="d-flex justify-content-between pt-4 border-top">
                                                <div>
                                                    <a href="/student/class/<%= assignment.class.id %>/assignments"
                                                        class="btn btn-outline-secondary me-2">
                                                        <i class="fas fa-times me-1"></i> Cancel
                                                    </a>
                                                    <button type="button" id="saveDraftBtn"
                                                        class="btn btn-outline-primary">
                                                        <i class="fas fa-save me-1"></i> Save Draft
                                                    </button>
                                                </div>
                                                <div>
                                                    <button type="button" id="previewBtn" class="btn btn-info me-2">
                                                        <i class="fas fa-eye me-1"></i> Preview
                                                    </button>
                                                    <button type="submit" class="btn btn-success btn-lg px-4">
                                                        <i class="fas fa-paper-plane me-1"></i> Submit Assignment
                                                    </button>
                                                </div>
                                            </div>
                                        </form>
                            </div>
                        </div>
                    </div>
                </div>
        </div>

        <!-- Bootstrap JS -->
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
        <!-- Quill Editor JS -->
        <script src="https://cdn.quilljs.com/1.3.7/quill.min.js"></script>

        <script>
            document.addEventListener('DOMContentLoaded', function () {
                // Initialize Quill Editor
                const quill = new Quill('#editor', {
                    modules: {
                        toolbar: [
                            [{ 'header': [1, 2, 3, 4, 5, 6, false] }],
                            ['bold', 'italic', 'underline', 'strike'],
                            [{ 'color': [] }, { 'background': [] }],
                            [{ 'list': 'ordered' }, { 'list': 'bullet' }],
                            [{ 'script': 'sub' }, { 'script': 'super' }],
                            [{ 'indent': '-1' }, { 'indent': '+1' }],
                            [{ 'align': [] }],
                            ['blockquote', 'code-block'],
                            ['link', 'image', 'video'],
                            ['clean']
                        ]
                    },
                    placeholder: 'Write your answer here...',
                    theme: 'snow'
                });

            // Set initial content if exists
            <% if (hasSubmission && assignment.submissions[0].content) { %>
                    quill.root.innerHTML = `<%- assignment.submissions[0].content %>`;
            <% } %>

            // Elements
            const hiddenContent = document.getElementById('hiddenContent');
                const wordCountSpan = document.getElementById('wordCount');
                const charCountSpan = document.getElementById('charCount');
                const autoSaveStatus = document.getElementById('autoSaveStatus');
                const fullscreenBtn = document.getElementById('fullscreenBtn');
                const saveDraftBtn = document.getElementById('saveDraftBtn');
                const previewBtn = document.getElementById('previewBtn');
                const form = document.getElementById('submissionForm');

                // Variables
                let isFullscreen = false;
                const assignmentId = '<%= assignment.id %>';

                // Update statistics
                function updateStatistics() {
                    const text = quill.getText().trim();
                    const words = text.length > 0 ? text.split(/\s+/).filter(word => word.length > 0).length : 0;
                    const chars = quill.getLength() - 1;

                    wordCountSpan.textContent = words;
                    charCountSpan.textContent = chars;
                    hiddenContent.value = quill.root.innerHTML;
                }

                // Auto-save functionality
                function setupAutoSave() {
                    let saveTimer;
                    quill.on('text-change', function () {
                        clearTimeout(saveTimer);
                        autoSaveStatus.innerHTML = '<i class="fas fa-sync fa-spin me-1"></i> Saving...';
                        autoSaveStatus.classList.add('saving');

                        saveTimer = setTimeout(function () {
                            saveDraft();
                            autoSaveStatus.innerHTML = '<i class="fas fa-check me-1"></i> Autosaved';
                            autoSaveStatus.classList.remove('saving');
                            setTimeout(() => {
                                autoSaveStatus.innerHTML = '<i class="fas fa-save me-1"></i> Autosaved';
                            }, 2000);
                        }, 2000);
                    });
                }

                // Save draft function
                function saveDraft() {
                    const draft = {
                        title: document.getElementById('title').value,
                        content: quill.root.innerHTML,
                        timestamp: new Date().toISOString()
                    };

                    localStorage.setItem('assignment_draft_' + assignmentId, JSON.stringify(draft));
                }

                // Load draft if exists
                function loadDraft() {
                    const draftKey = 'assignment_draft_' + assignmentId;
                    const draft = localStorage.getItem(draftKey);
                    if (draft) {
                        try {
                            const data = JSON.parse(draft);
                            if (data.title) {
                                document.getElementById('title').value = data.title;
                            }
                            if (data.content) {
                                quill.root.innerHTML = data.content;
                            }

                            if (quill.getText().trim().length === 0 || confirm('A saved draft was found. Do you want to restore it?')) {
                                updateStatistics();
                            } else {
                                localStorage.removeItem(draftKey);
                            }
                        } catch (e) {
                            console.error('Error loading draft:', e);
                            localStorage.removeItem(draftKey);
                        }
                    }
                }

                // Fullscreen functionality
                function toggleFullscreen() {
                    const editorContainer = document.querySelector('.editor-container');
                    const toolbar = document.querySelector('.ql-toolbar');

                    if (!isFullscreen) {
                        editorContainer.classList.add('fullscreen-mode');
                        toolbar.style.borderRadius = '0';
                        fullscreenBtn.innerHTML = '<i class="fas fa-compress"></i> Exit Fullscreen';
                        document.body.style.overflow = 'hidden';
                    } else {
                        editorContainer.classList.remove('fullscreen-mode');
                        toolbar.style.borderRadius = '8px 8px 0 0';
                        fullscreenBtn.innerHTML = '<i class="fas fa-expand"></i> Fullscreen';
                        document.body.style.overflow = '';
                    }

                    isFullscreen = !isFullscreen;
                    quill.focus();
                }

                // Initialize
                function initialize() {
                    updateStatistics();
                    setupAutoSave();
                    loadDraft();

                    // Set up event listeners
                    quill.on('text-change', updateStatistics);

                    document.getElementById('title').addEventListener('input', function () {
                        if (this.value.length > 100) {
                            this.value = this.value.substring(0, 100);
                        }
                    });

                    // Fullscreen button
                    fullscreenBtn.addEventListener('click', toggleFullscreen);

                    // Save draft button
                    saveDraftBtn.addEventListener('click', function () {
                        saveDraft();
                        const originalHTML = this.innerHTML;
                        this.innerHTML = '<i class="fas fa-check me-1"></i> Saved!';
                        this.disabled = true;

                        setTimeout(() => {
                            this.innerHTML = originalHTML;
                            this.disabled = false;
                        }, 2000);
                    });

                    // Preview button
                    previewBtn.addEventListener('click', function () {
                        const previewWindow = window.open('', '_blank');
                        const content = quill.root.innerHTML;
                        const title = document.getElementById('title').value || 'Untitled';

                        previewWindow.document.write(`
                        <html>
                            <head>
                                <title>Preview - ${title}</title>
                                <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
                                <style>
                                    body { padding: 20px; }
                                    .preview-content { max-width: 800px; margin: 0 auto; }
                                </style>
                            </head>
                            <body>
                                <div class="preview-content">
                                    <h2>${title}</h2>
                                    <hr>
                                    <div>${content}</div>
                                </div>
                            </body>
                        </html>
                    `);
                        previewWindow.document.close();
                    });

                    // Form submission
                    form.addEventListener('submit', async function (e) {
                        e.preventDefault();

                        // Update hidden content
                        hiddenContent.value = quill.root.innerHTML;

                        // Validate content
                        if (quill.getText().trim().length === 0) {
                            alert('Please enter your answer before submitting.');
                            quill.focus();
                            return;
                        }

                        // Validate title
                        const title = document.getElementById('title').value.trim();
                        if (!title) {
                            alert('Please enter a title for your submission.');
                            document.getElementById('title').focus();
                            return;
                        }

                        // Show loading state
                        const submitBtn = this.querySelector('button[type="submit"]');
                        const originalText = submitBtn.innerHTML;
                        submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin me-1"></i> Submitting...';
                        submitBtn.disabled = true;

                        // Create FormData
                        const formData = new FormData(this);

                        try {
                            const response = await fetch(this.action, {
                                method: 'POST',
                                body: formData,
                                headers: {
                                    'Accept': 'application/json'
                                }
                            });

                            const data = await response.json();

                            if (data.success) {
                                // Remove draft on successful submission
                                localStorage.removeItem('assignment_draft_' + assignmentId);

                                // Show success message
                                alert(data.message || 'Assignment submitted successfully!');
                                window.location.href = data.redirectUrl || '/student/classes';
                            } else {
                                alert('Error: ' + (data.message || 'Submission failed. Please try again.'));
                                submitBtn.innerHTML = originalText;
                                submitBtn.disabled = false;
                            }
                        } catch (error) {
                            console.error('Error:', error);
                            alert('An error occurred. Please check your connection and try again.');
                            submitBtn.innerHTML = originalText;
                            submitBtn.disabled = false;
                        }
                    });
                }

                // Initialize everything
                initialize();
            });
        </script>
</body>

</html>