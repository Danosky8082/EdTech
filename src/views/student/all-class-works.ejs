<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Class Works - Student Dashboard</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <style>
        .class-card {
            transition: transform 0.3s ease, box-shadow 0.3s ease;
            border-radius: 10px;
            overflow: hidden;
        }

        .class-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 8px 25px rgba(0, 0, 0, 0.15);
        }

        .badge-new {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            animation: pulse 2s infinite;
        }

        @keyframes pulse {
            0% {
                opacity: 1;
            }

            50% {
                opacity: 0.8;
            }

            100% {
                opacity: 1;
            }
        }
    </style>
</head>

<body>
    <%- include('../partials/navbar') %>

        <div class="container mt-4">
            <%- include('../partials/alerts') %>

                <div class="row mb-4">
                    <div class="col-12">
                        <div class="d-flex justify-content-between align-items-center">
                            <h2>My Class Works</h2>
                            <div>
                                <a href="/student/dashboard" class="btn btn-outline-secondary">
                                    <i class="fas fa-arrow-left me-1"></i> Back to Dashboard
                                </a>
                            </div>
                        </div>
                        <p class="text-muted">Select a class to view and submit class works</p>
                    </div>
                </div>

                <% if (enrollments && enrollments.length> 0) { %>
                    <div class="row">
                        <% enrollments.forEach(enrollment=> { %>
                            <div class="col-md-4 mb-4">
                                <div class="card class-card h-100">
                                    <div class="card-header bg-primary text-white">
                                        <h5 class="mb-0">
                                            <%= enrollment.class.name %>
                                        </h5>
                                    </div>
                                    <div class="card-body">
                                        <p class="card-text">
                                            <strong>Grade:</strong>
                                            <%= enrollment.class.grade %> - <%= enrollment.class.section %><br>
                                                    <strong>Teacher:</strong>
                                                    <%= enrollment.class.teacher.user.firstName %>
                                                        <%= enrollment.class.teacher.user.lastName %>
                                        </p>

                                        <!-- Class Works Stats -->
                                        <% if (classWorksStats && classWorksStats[enrollment.class.id]) { const
                                            stats=classWorksStats[enrollment.class.id]; %>
                                            <div class="mb-3">
                                                <small class="text-muted">Class Works:</small>
                                                <div class="d-flex justify-content-between">
                                                    <span>Pending: <strong>
                                                            <%= stats.pending %>
                                                        </strong></span>
                                                    <span>Completed: <strong>
                                                            <%= stats.completed %>
                                                        </strong></span>
                                                    <span>Total: <strong>
                                                            <%= stats.total %>
                                                        </strong></span>
                                                </div>
                                            </div>
                                            <% } %>
                                    </div>
                                    <div class="card-footer bg-transparent">
                                        <div class="btn-group w-100">
                                            <a href="/student/class/<%= enrollment.class.id %>/class-works"
                                                class="btn btn-outline-primary">
                                                <i class="fas fa-tasks me-1"></i> Class Works
                                            </a>
                                            <a href="/student/class/<%= enrollment.class.id %>/live-sessions"
                                                class="btn btn-outline-info">
                                                <i class="fas fa-video me-1"></i> Live Sessions
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <% }); %>
                    </div>
                    <% } else { %>
                        <div class="alert alert-warning">
                            <i class="fas fa-exclamation-triangle me-2"></i>
                            You are not enrolled in any classes yet. Please contact your school administration.
                        </div>
                        <% } %>

                            <!-- Recent Class Works Section -->
                            <% if (recentClassWorks && recentClassWorks.length> 0) { %>
                                <div class="row mt-5">
                                    <div class="col-12">
                                        <h4>Recent Class Works</h4>
                                        <div class="table-responsive">
                                            <table class="table table-hover">
                                                <thead>
                                                    <tr>
                                                        <th>Title</th>
                                                        <th>Class</th>
                                                        <th>Type</th>
                                                        <th>Due Date</th>
                                                        <th>Status</th>
                                                        <th>Action</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    <% recentClassWorks.forEach(work=> { %>
                                                        <tr>
                                                            <td>
                                                                <%= work.title %>
                                                            </td>
                                                            <td>
                                                                <%= work.class.name %>
                                                            </td>
                                                            <td>
                                                                <span class="badge bg-<%= 
                                                work.type === 'quiz' ? 'primary' : 
                                                work.type === 'assignment' ? 'success' : 'warning' 
                                            %>">
                                                                    <%= work.type %>
                                                                </span>
                                                            </td>
                                                            <td>
                                                                <%= work.dueDate ? new
                                                                    Date(work.dueDate).toLocaleDateString()
                                                                    : 'No due date' %>
                                                            </td>
                                                            <td>
                                                                <% if (work.submissions && work.submissions.length> 0) {
                                                                    %>
                                                                    <span class="badge bg-success">Submitted</span>
                                                                    <% } else { %>
                                                                        <span class="badge bg-warning">Pending</span>
                                                                        <% } %>
                                                            </td>
                                                            <td>
                                                                <% if (work.submissions && work.submissions.length> 0) {
                                                                    %>
                                                                    <a href="/student/class-works/<%= work.id %>/results"
                                                                        class="btn btn-sm btn-outline-primary">
                                                                        View Results
                                                                    </a>
                                                                    <% } else { %>
                                                                        <a href="/student/class-works/<%= work.id %>/take"
                                                                            class="btn btn-sm btn-primary">
                                                                            Start
                                                                        </a>
                                                                        <% } %>
                                                            </td>
                                                        </tr>
                                                        <% }); %>
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>
                                </div>
                                <% } %>
        </div>

        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>