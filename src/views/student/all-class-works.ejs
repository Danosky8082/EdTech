<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= title %> - EdTech
    </title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <style>
        /* ===== GLOBAL ===== */
        body {
            background: #f0f2f5;
        }

        .page-header {
            background: linear-gradient(135deg, #6a11cb 0%, #2575fc 100%);
            color: white;
            padding: 1.5rem 0;
            border-radius: 12px;
            margin-bottom: 2rem;
        }

        .page-header h2 {
            font-weight: 700;
        }

        .page-header .breadcrumb {
            background: transparent;
            margin: 0;
            padding: 0;
        }

        .page-header .breadcrumb-item a {
            color: rgba(255, 255, 255, 0.8);
            text-decoration: none;
        }

        .page-header .breadcrumb-item.active {
            color: #fff;
        }

        /* ===== CLASS CARDS ===== */
        .class-card {
            border: none;
            border-radius: 16px;
            transition: transform 0.2s, box-shadow 0.2s;
            background: #fff;
            overflow: hidden;
            height: 100%;
            box-shadow: 0 2px 12px rgba(0, 0, 0, 0.06);
        }

        .class-card:hover {
            transform: translateY(-6px);
            box-shadow: 0 12px 28px rgba(0, 0, 0, 0.12);
        }

        .class-card .card-header {
            background: linear-gradient(135deg, #6a11cb 0%, #2575fc 100%);
            color: white;
            padding: 1rem 1.25rem;
            border: none;
        }

        .class-card .card-header h5 {
            font-weight: 600;
            margin: 0;
        }

        .class-card .card-body {
            padding: 1.25rem;
        }

        .class-card .card-body .class-meta {
            font-size: 0.9rem;
            color: #495057;
        }

        .class-card .card-body .class-meta i {
            width: 1.4rem;
            color: #6a11cb;
        }

        .class-card .stats-row {
            display: flex;
            justify-content: space-between;
            background: #f8f9fa;
            border-radius: 10px;
            padding: 0.6rem 1rem;
            margin-top: 0.8rem;
        }

        .class-card .stats-row .stat-item {
            text-align: center;
        }

        .class-card .stats-row .stat-item .stat-number {
            font-weight: 700;
            font-size: 1.1rem;
        }

        .class-card .stats-row .stat-item .stat-label {
            font-size: 0.7rem;
            text-transform: uppercase;
            color: #6c757d;
        }

        .class-card .card-footer {
            background: transparent;
            border-top: 1px solid #f0f0f0;
            padding: 0.75rem 1.25rem;
        }

        .class-card .card-footer .btn {
            border-radius: 30px;
            padding: 0.3rem 1rem;
            font-size: 0.85rem;
        }

        /* ===== RECENT CLASS WORKS TABLE ===== */
        .recent-section {
            background: #fff;
            border-radius: 16px;
            padding: 1.5rem;
            box-shadow: 0 2px 12px rgba(0, 0, 0, 0.04);
        }

        .recent-section h4 {
            font-weight: 600;
            color: #343a40;
        }

        .recent-section .table th {
            border-top: none;
            font-weight: 600;
            color: #495057;
        }

        .recent-section .table td {
            vertical-align: middle;
        }

        .recent-section .status-badge {
            padding: 0.25rem 0.75rem;
            border-radius: 30px;
            font-size: 0.75rem;
            font-weight: 600;
        }

        .empty-state {
            background: #fff;
            border-radius: 16px;
            padding: 3rem 1rem;
            box-shadow: 0 2px 12px rgba(0, 0, 0, 0.04);
            text-align: center;
        }

        .empty-state i {
            font-size: 3.5rem;
            color: #dee2e6;
        }

        .empty-state h4 {
            color: #343a40;
        }

        /* ===== RESPONSIVE ===== */
        @media (max-width: 576px) {
            .class-card .stats-row {
                flex-wrap: wrap;
                gap: 0.3rem;
            }

            .class-card .stats-row .stat-item {
                flex: 1 1 30%;
            }

            .class-card .card-footer .btn-group {
                flex-direction: column;
                gap: 0.3rem;
            }

            .class-card .card-footer .btn {
                width: 100%;
                text-align: center;
            }
        }
    </style>
</head>

<body>

    <%- include('../partials/navbar') %>

        <div class="container mt-4">

            <%- include('../partials/alerts') %>

                <!-- ===== PAGE HEADER ===== -->
                <div class="page-header px-4">
                    <div class="row align-items-center">
                        <div class="col-md-8">
                            <h2><i class="fas fa-tasks me-3"></i>My Class Works</h2>
                            <p class="mb-0 text-light">Select a class to view and submit your class works</p>
                        </div>
                        <div class="col-md-4 text-md-end mt-3 mt-md-0">
                            <a href="/student/dashboard" class="btn btn-light btn-sm">
                                <i class="fas fa-arrow-left me-1"></i> Dashboard
                            </a>
                        </div>
                    </div>
                </div>

                <!-- ===== CLASS CARDS ===== -->
                <% if (enrollments && enrollments.length> 0) { %>
                    <div class="row g-4">
                        <% enrollments.forEach(function(enrollment) { %>
                            <div class="col-md-4 col-lg-3">
                                <div class="class-card card">
                                    <div class="card-header">
                                        <h5><i class="fas fa-chalkboard me-2"></i>
                                            <%= enrollment.class.name %>
                                        </h5>
                                    </div>
                                    <div class="card-body">
                                        <div class="class-meta">
                                            <div><i class="fas fa-layer-group"></i> Grade: <strong>
                                                    <%= enrollment.class.grade %>
                                                </strong></div>
                                            <div><i class="fas fa-users"></i> Section: <strong>
                                                    <%= enrollment.class.section %>
                                                </strong></div>
                                            <div><i class="fas fa-user-tie"></i> Teacher: <strong>
                                                    <%= enrollment.class.teacher.user.firstName %>
                                                        <%= enrollment.class.teacher.user.lastName %>
                                                </strong></div>
                                        </div>

                                        <!-- Stats -->
                                        <% if (classWorksStats && classWorksStats[enrollment.class.id]) { const
                                            stats=classWorksStats[enrollment.class.id]; %>
                                            <div class="stats-row">
                                                <div class="stat-item">
                                                    <div class="stat-number">
                                                        <%= stats.total || 0 %>
                                                    </div>
                                                    <div class="stat-label">Total</div>
                                                </div>
                                                <div class="stat-item">
                                                    <div class="stat-number text-info">
                                                        <%= stats.pending || 0 %>
                                                    </div>
                                                    <div class="stat-label">Pending</div>
                                                </div>
                                                <div class="stat-item">
                                                    <div class="stat-number text-success">
                                                        <%= stats.completed || 0 %>
                                                    </div>
                                                    <div class="stat-label">Completed</div>
                                                </div>
                                            </div>
                                            <% } else { %>
                                                <div class="stats-row">
                                                    <div class="stat-item">
                                                        <div class="stat-number">—</div>
                                                        <div class="stat-label">No stats</div>
                                                    </div>
                                                </div>
                                                <% } %>
                                    </div>
                                    <div class="card-footer">
                                        <div class="btn-group w-100">
                                            <a href="/student/class/<%= enrollment.class.id %>/class-works"
                                                class="btn btn-outline-primary">
                                                <i class="fas fa-tasks me-1"></i> Class Works
                                            </a>
                                            <a href="/student/class/<%= enrollment.class.id %>/live-sessions"
                                                class="btn btn-outline-info">
                                                <i class="fas fa-video me-1"></i> Live
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <% }); %>
                    </div>
                    <% } else { %>
                        <div class="empty-state">
                            <i class="fas fa-users-slash"></i>
                            <h4 class="mt-3">No Enrollments</h4>
                            <p class="text-muted">You are not enrolled in any classes yet.</p>
                            <p class="text-muted small">Please contact your school administration.</p>
                        </div>
                        <% } %>

                            <!-- ===== RECENT CLASS WORKS SECTION ===== -->
                            <% if (recentClassWorks && recentClassWorks.length> 0) { %>
                                <div class="recent-section mt-5">
                                    <h4><i class="fas fa-clock me-2"></i>Recent Class Works</h4>
                                    <div class="table-responsive">
                                        <table class="table table-hover">
                                            <thead>
                                                <tr>
                                                    <th>Title</th>
                                                    <th>Class</th>
                                                    <th>Type</th>
                                                    <th>Due Date</th>
                                                    <th>Status</th>
                                                    <th>Action</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <% recentClassWorks.forEach(function(work) { let
                                                    hasSubmission=work.submissions && work.submissions.length> 0;
                                                    let statusText = hasSubmission ? 'Submitted' : 'Pending';
                                                    let statusColor = hasSubmission ? 'success' : 'warning';
                                                    let actionLink = hasSubmission
                                                    ? `/student/class-works/${work.id}/results`
                                                    : `/student/class-works/${work.id}/take`;
                                                    let actionText = hasSubmission ? 'View Results' : 'Start';
                                                    let actionColor = hasSubmission ? 'outline-primary' : 'primary';
                                                    %>
                                                    <tr>
                                                        <td><strong>
                                                                <%= work.title %>
                                                            </strong></td>
                                                        <td>
                                                            <%= work.class.name %>
                                                        </td>
                                                        <td><span
                                                                class="badge bg-<%= work.type === 'quiz' ? 'primary' : work.type === 'assignment' ? 'success' : 'warning' %>">
                                                                <%= work.type %>
                                                            </span></td>
                                                        <td>
                                                            <%= work.dueDate ? new
                                                                Date(work.dueDate).toLocaleDateString() : 'No due date'
                                                                %>
                                                        </td>
                                                        <td><span
                                                                class="status-badge bg-<%= statusColor %> text-white"><i
                                                                    class="fas <%= hasSubmission ? 'fa-check-circle' : 'fa-clock' %> me-1"></i>
                                                                <%= statusText %>
                                                            </span></td>
                                                        <td>
                                                            <a href="<%= actionLink %>"
                                                                class="btn btn-sm btn-<%= actionColor %>">
                                                                <%= actionText %>
                                                            </a>
                                                        </td>
                                                    </tr>
                                                    <% }); %>
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                                <% } else { %>
                                    <div class="recent-section mt-5">
                                        <h4><i class="fas fa-clock me-2"></i>Recent Class Works</h4>
                                        <p class="text-muted text-center py-3">No recent class works found.</p>
                                    </div>
                                    <% } %>

        </div>

        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>