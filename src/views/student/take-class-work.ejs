<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= title %> - EdTech
    </title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <style>
        body {
            background: #f0f2f5;
        }

        .question-card {
            background: #fff;
            border-radius: 16px;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
            margin-bottom: 1.5rem;
            padding: 1.25rem;
            border-left: 4px solid #6a11cb;
        }

        .question-number {
            font-weight: 700;
            color: #6a11cb;
        }

        .options label {
            display: block;
            padding: 0.4rem 0.8rem;
            border-radius: 8px;
            cursor: pointer;
            transition: background 0.2s;
        }

        .options label:hover {
            background: #f1f3f5;
        }

        .options input[type="radio"] {
            margin-right: 0.6rem;
        }

        .btn-submit {
            background: linear-gradient(135deg, #6a11cb, #2575fc);
            border: none;
            color: white;
            font-weight: 600;
            padding: 0.6rem 2rem;
            border-radius: 30px;
        }

        .btn-submit:hover {
            transform: scale(1.03);
            box-shadow: 0 4px 12px rgba(106, 17, 203, 0.3);
        }
    </style>
</head>

<body>
    <%- include('../partials/navbar') %>

        <div class="container mt-4">
            <div class="row justify-content-center">
                <div class="col-lg-8">
                    <div class="card shadow-sm border-0">
                        <div class="card-header bg-primary text-white">
                            <h4 class="mb-0"><i class="fas fa-pencil-alt me-2"></i>
                                <%= classWork.title %>
                            </h4>
                        </div>
                        <div class="card-body">
                            <p class="text-muted">
                                <%= classWork.class ? classWork.class.name : '' %> – <%= classWork.points || 100 %>
                                        points
                            </p>
                            <% if (classWork.description) { %>
                                <p>
                                    <%= classWork.description %>
                                </p>
                                <% } %>
                                    <% if (classWork.dueDate) { %>
                                        <p><i class="far fa-calendar-alt me-1"></i> Due: <%= new
                                                Date(classWork.dueDate).toLocaleString() %>
                                        </p>
                                        <% } %>

                                            <hr>

                                            <% if (classWork.questions && classWork.questions.length> 0) { %>
                                                <form id="classWorkForm" method="POST"
                                                    action="/student/class-works/<%= classWork.id %>/submit">
                                                    <% classWork.questions.forEach((q, idx)=> { %>
                                                        <div class="question-card">
                                                            <div class="question-number">Question <%= idx+1 %>
                                                            </div>
                                                            <p class="fw-bold">
                                                                <%= q.question %>
                                                            </p>
                                                            <div class="options">
                                                                <% if (q.type==='multiple_choice' && q.options) { %>
                                                                    <% q.options.forEach(opt=> { %>
                                                                        <label>
                                                                            <input type="radio"
                                                                                name="answers[<%= idx %>]"
                                                                                value="<%= typeof opt === 'object' ? opt.text : opt %>">
                                                                            <%= typeof opt==='object' ? opt.text : opt
                                                                                %>
                                                                        </label>
                                                                        <% }) %>
                                                                            <% } else if (q.type==='true_false' ) { %>
                                                                                <label><input type="radio"
                                                                                        name="answers[<%= idx %>]"
                                                                                        value="True"> True</label>
                                                                                <label><input type="radio"
                                                                                        name="answers[<%= idx %>]"
                                                                                        value="False"> False</label>
                                                                                <% } else { %>
                                                                                    <textarea class="form-control"
                                                                                        name="answers[<%= idx %>]"
                                                                                        rows="3"
                                                                                        placeholder="Write your answer..."></textarea>
                                                                                    <% } %>
                                                            </div>
                                                            <div class="text-muted small mt-2">
                                                                <%= q.points || 1 %> point(s)
                                                            </div>
                                                        </div>
                                                        <% }) %>
                                                            <div class="d-grid gap-2 mt-3">
                                                                <button type="submit" class="btn-submit btn-lg"><i
                                                                        class="fas fa-paper-plane me-2"></i>Submit Class
                                                                    Work</button>
                                                            </div>
                                                </form>
                                                <% } else { %>
                                                    <div class="alert alert-warning">
                                                        <i class="fas fa-exclamation-triangle me-2"></i>
                                                        This class work has no questions yet. Please contact your
                                                        teacher.
                                                    </div>
                                                    <% } %>
                        </div>
                    </div>
                    <div class="mt-3">
                        <a href="/student/class/<%= classWork.classId %>/class-works"
                            class="btn btn-outline-secondary"><i class="fas fa-arrow-left me-1"></i> Back</a>
                    </div>
                </div>
            </div>
        </div>

        <script>
            document.getElementById('classWorkForm')?.addEventListener('submit', function (e) {
                e.preventDefault();
                const btn = this.querySelector('button[type="submit"]');
                btn.disabled = true;
                btn.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i> Submitting...';

                const formData = new FormData(this);
                const answers = {};
                for (let [key, value] of formData.entries()) {
                    if (key.startsWith('answers[')) {
                        const idx = key.match(/\d+/)[0];
                        answers[idx] = value;
                    }
                }

                fetch(this.action, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ answers })
                })
                    .then(res => res.json())
                    .then(data => {
                        if (data.success) {
                            alert('✅ ' + data.message);
                            window.location.href = `/student/class-works/${data.submissionId || '<%= classWork.id %>'}/results`;
                        } else {
                            alert('❌ ' + data.message);
                            btn.disabled = false;
                            btn.innerHTML = '<i class="fas fa-paper-plane me-2"></i>Submit Class Work';
                        }
                    })
                    .catch(err => {
                        alert('Network error: ' + err.message);
                        btn.disabled = false;
                        btn.innerHTML = '<i class="fas fa-paper-plane me-2"></i>Submit Class Work';
                    });
            });
        </script>
</body>

</html>