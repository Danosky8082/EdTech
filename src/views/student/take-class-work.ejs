<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= title %> - EdTech
    </title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <style>
        .question-card {
            border-left: 4px solid #0d6efd;
            margin-bottom: 1.5rem;
            background: #f8f9fa;
        }

        .question-card .card-header {
            background: #e9ecef;
            font-weight: 600;
        }

        .option-label {
            display: block;
            padding: 8px 12px;
            border-radius: 5px;
            cursor: pointer;
            transition: background 0.2s;
        }

        .option-label:hover {
            background: #e3f2fd;
        }

        .option-label input[type="radio"] {
            margin-right: 10px;
        }

        .essay-textarea {
            width: 100%;
            min-height: 120px;
            padding: 10px;
            border: 1px solid #ced4da;
            border-radius: 5px;
        }

        .debug-box {
            background: #f8f9fa;
            border: 1px solid #ddd;
            padding: 15px;
            border-radius: 5px;
            font-family: monospace;
            font-size: 0.85rem;
            overflow-x: auto;
            white-space: pre-wrap;
        }
    </style>
</head>

<body>

    <%- include('../partials/navbar') %>

        <div class="container mt-4">
            <%- include('../partials/alerts') %>

                <div class="row">
                    <div class="col-lg-8 mx-auto">
                        <!-- Header -->
                        <div class="card mb-4">
                            <div class="card-body">
                                <h2>
                                    <%= classWork.title %>
                                </h2>
                                <p class="text-muted">
                                    <i class="fas fa-chalkboard-teacher me-1"></i>
                                    <%= classWork.class ? classWork.class.name : 'N/A' %>
                                </p>
                                <p>
                                    <strong>Type:</strong>
                                    <span class="badge bg-primary">
                                        <%= classWork.type ? classWork.type.charAt(0).toUpperCase() +
                                            classWork.type.slice(1) : 'Assignment' %>
                                    </span>
                                    <span class="badge bg-secondary ms-2">
                                        <%= classWork.points || 100 %> points
                                    </span>
                                    <% if (classWork.dueDate) { %>
                                        <span class="badge bg-warning ms-2">Due: <%= new
                                                Date(classWork.dueDate).toLocaleDateString() %></span>
                                        <% } %>
                                </p>
                                <% if (classWork.description) { %>
                                    <p class="card-text">
                                        <%= classWork.description %>
                                    </p>
                                    <% } %>
                            </div>
                        </div>

                        <!-- Questions -->
                        <% if (classWork.questions && classWork.questions.length> 0) { %>
                            <form id="classWorkForm" method="POST"
                                action="/student/class-works/<%= classWork.id %>/submit">
                                <input type="hidden" name="classWorkId" value="<%= classWork.id %>">
                                <input type="hidden" name="_csrf" value="<%= csrfToken || '' %>">

                                <% classWork.questions.forEach(function(q, index) { %>
                                    <div class="card question-card">
                                        <div class="card-header">
                                            <strong>Question <%= index + 1 %>:</strong>
                                            <% if (q.points) { %><span class="badge bg-secondary float-end">
                                                    <%= q.points %> pts
                                                </span>
                                                <% } %>
                                        </div>
                                        <div class="card-body">
                                            <p class="card-text">
                                                <%= q.question %>
                                            </p>

                                            <% if (q.type==='multiple_choice' && q.options && q.options.length> 0) { %>
                                                <div class="options">
                                                    <% q.options.forEach(function(option, optIndex) { %>
                                                        <label class="option-label">
                                                            <input type="radio" name="answers[<%= index %>]"
                                                                value="<%= option.text || option %>">
                                                            <%= option.text || option %>
                                                        </label>
                                                        <% }); %>
                                                </div>
                                                <% } else if (q.type==='true_false' ) { %>
                                                    <div class="options">
                                                        <label class="option-label">
                                                            <input type="radio" name="answers[<%= index %>]"
                                                                value="True"> True
                                                        </label>
                                                        <label class="option-label">
                                                            <input type="radio" name="answers[<%= index %>]"
                                                                value="False"> False
                                                        </label>
                                                    </div>
                                                    <% } else { %>
                                                        <!-- Essay, short answer, etc. -->
                                                        <textarea class="essay-textarea" name="answers[<%= index %>]"
                                                            placeholder="Write your answer here..."></textarea>
                                                        <% } %>
                                        </div>
                                    </div>
                                    <% }); %>

                                        <div class="d-grid gap-2 mt-4">
                                            <button type="submit" class="btn btn-primary btn-lg" id="submitBtn">
                                                <i class="fas fa-paper-plane me-1"></i> Submit Class Work
                                            </button>
                                        </div>
                            </form>
                            <% } else { %>
                                <div class="alert alert-warning">
                                    <i class="fas fa-exclamation-triangle me-2"></i>
                                    This class work has no questions yet. Please contact your teacher.
                                </div>

                                <!-- ========== DEBUG: Show raw data ========== -->
                                <div class="card mt-3">
                                    <div class="card-header bg-secondary text-white">
                                        <i class="fas fa-bug me-1"></i> Debug Information
                                    </div>
                                    <div class="card-body">
                                        <p><strong>classWork.questions (raw from DB):</strong></p>
                                        <div class="debug-box">
                                            <%= JSON.stringify(debugQuestions !==undefined ? debugQuestions :
                                                classWork.questions, null, 2) %>
                                        </div>
                                        <p class="mt-2"><strong>Parsed questions:</strong></p>
                                        <div class="debug-box">
                                            <%= JSON.stringify(debugParsed !==undefined ? debugParsed : [], null, 2) %>
                                        </div>
                                        <p class="mt-2"><strong>Type of raw questions:</strong>
                                            <%= typeof debugQuestions !==undefined ? typeof debugQuestions : typeof
                                                classWork.questions %>
                                        </p>
                                        <p><strong>Is array?</strong>
                                            <%= Array.isArray(classWork.questions) ? 'Yes' : 'No' %>
                                        </p>
                                        <p><strong>Length:</strong>
                                            <%= classWork.questions ? classWork.questions.length : 0 %>
                                        </p>
                                    </div>
                                </div>
                                <% } %>

                                    <!-- Back button -->
                                    <div class="mt-4">
                                        <a href="/student/class/<%= classWork.classId %>/class-works"
                                            class="btn btn-secondary">
                                            <i class="fas fa-arrow-left me-1"></i> Back to Class Works
                                        </a>
                                    </div>
                    </div>
                </div>
        </div>

        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
        <script>
            document.getElementById('classWorkForm')?.addEventListener('submit', function (e) {
                e.preventDefault();
                const btn = document.getElementById('submitBtn');
                btn.disabled = true;
                btn.innerHTML = '<i class="fas fa-spinner fa-spin me-1"></i> Submitting...';

                const formData = new FormData(this);
                const answers = [];
                // Collect answers from radio groups and textareas
                const inputs = this.querySelectorAll('input[type="radio"]:checked, textarea');
                inputs.forEach(input => {
                    const name = input.name.match(/\[(\d+)\]/);
                    if (name) {
                        const idx = parseInt(name[1]);
                        answers[idx] = input.value;
                    }
                });

                fetch(this.action, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'X-CSRF-Token': document.querySelector('input[name="_csrf"]')?.value || ''
                    },
                    body: JSON.stringify({ answers: answers })
                })
                    .then(response => response.json())
                    .then(data => {
                        if (data.success) {
                            alert('✅ ' + data.message);
                            window.location.href = `/student/class-works/${data.submissionId || '<%= classWork.id %>'}/results`;
                        } else {
                            alert('❌ ' + data.message);
                            btn.disabled = false;
                            btn.innerHTML = '<i class="fas fa-paper-plane me-1"></i> Submit Class Work';
                        }
                    })
                    .catch(error => {
                        alert('❌ An error occurred: ' + error.message);
                        btn.disabled = false;
                        btn.innerHTML = '<i class="fas fa-paper-plane me-1"></i> Submit Class Work';
                    });
            });
        </script>
</body>

</html>