<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= title %> - EdTech
    </title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <style>
        body {
            background: #f0f2f5;
        }

        .result-card {
            background: #fff;
            border-radius: 16px;
            box-shadow: 0 2px 12px rgba(0, 0, 0, 0.06);
        }

        .result-header {
            background: linear-gradient(135deg, #6a11cb, #2575fc);
            color: white;
            border-radius: 16px 16px 0 0;
            padding: 1.5rem;
        }

        .score-circle {
            width: 120px;
            height: 120px;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.2);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 2.5rem;
            font-weight: 700;
            margin: 0 auto;
        }

        .question-review {
            border-bottom: 1px solid #e9ecef;
            padding: 1rem 0;
        }

        .question-review:last-child {
            border-bottom: none;
        }

        .correct {
            color: #28a745;
        }

        .incorrect {
            color: #dc3545;
        }

        .feedback-box {
            background: #f8f9fa;
            border-radius: 8px;
            padding: 0.75rem;
            margin-top: 0.5rem;
        }
    </style>
</head>

<body>

    <%- include('../partials/navbar') %>

        <div class="container mt-4">
            <div class="row justify-content-center">
                <div class="col-lg-8">

                    <div class="result-card">
                        <!-- Header -->
                        <div class="result-header text-center">
                            <h4><i class="fas fa-graduation-cap me-2"></i>
                                <%= classWork.title %>
                            </h4>
                            <p class="mb-0">
                                <%= classWork.class ? classWork.class.name : '' %>
                            </p>
                        </div>

                        <!-- Score summary -->
                        <div class="card-body text-center">
                            <div class="score-circle">
                                <%= results.score %> / <%= results.totalPoints %>
                            </div>
                            <h5 class="mt-3">
                                Score: <strong>
                                    <%= results.percentage %>%
                                </strong>
                            </h5>
                            <p class="text-muted">Submitted: <%= new Date(submission.submittedAt).toLocaleString() %>
                            </p>
                            <p>
                                <span
                                    class="badge bg-<%= results.percentage >= 70 ? 'success' : results.percentage >= 50 ? 'warning' : 'danger' %>">
                                    <%= results.percentage>= 70 ? 'Passed' : results.percentage >= 50 ? 'Needs
                                        Improvement' : 'Needs Review' %>
                                </span>
                            </p>
                        </div>
                    </div>

                    <!-- Question review -->
                    <div class="result-card mt-4 p-3">
                        <h5><i class="fas fa-list-check me-2"></i>Your Answers</h5>
                        <% if (results.questions && results.questions.length> 0) { %>
                            <% results.questions.forEach((q, idx)=> {
                                const userAnswer = submission.answers ? submission.answers[idx] : null;
                                const isCorrect = q.correctAnswer && userAnswer && userAnswer === q.correctAnswer;
                                const isAutoGraded = q.type === 'multiple_choice' || q.type === 'true_false';
                                %>
                                <div class="question-review">
                                    <div class="d-flex justify-content-between">
                                        <strong>Q<%= idx+1 %>:</strong>
                                        <span
                                            class="<%= isAutoGraded ? (isCorrect ? 'correct' : 'incorrect') : 'text-muted' %>">
                                            <i
                                                class="fas <%= isAutoGraded ? (isCorrect ? 'fa-check-circle' : 'fa-times-circle') : 'fa-ellipsis-h' %> me-1"></i>
                                            <%= q.points || 1 %> pts
                                        </span>
                                    </div>
                                    <p>
                                        <%= q.question %>
                                    </p>
                                    <div>
                                        <strong>Your answer:</strong>
                                        <%= userAnswer || 'Not answered' %>
                                            <% if (isAutoGraded && q.correctAnswer) { %>
                                                <br><span class="text-muted">Correct answer: <strong>
                                                        <%= q.correctAnswer %>
                                                    </strong></span>
                                                <% } %>
                                    </div>
                                    <% if (submission.feedback) { %>
                                        <div class="feedback-box">
                                            <strong>Teacher Feedback:</strong>
                                            <%= submission.feedback %>
                                        </div>
                                        <% } %>
                                </div>
                                <% }) %>
                                    <% } else { %>
                                        <p class="text-muted">No questions found.</p>
                                        <% } %>
                    </div>

                    <div class="mt-4 d-flex justify-content-between">
                        <a href="/student/class/<%= classWork.classId %>/class-works" class="btn btn-secondary">
                            <i class="fas fa-arrow-left me-1"></i> Back to Class Works
                        </a>
                        <a href="/student/dashboard" class="btn btn-outline-primary">
                            <i class="fas fa-home me-1"></i> Dashboard
                        </a>
                    </div>

                </div>
            </div>
        </div>

        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>