<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= title %> - EdTech
    </title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <style>
        .assignment-card {
            border-left: 4px solid #0dcaf0;
            transition: all 0.3s ease;
        }

        .assignment-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 6px 20px rgba(0, 0, 0, 0.1);
        }

        .status-badge {
            font-size: 0.75rem;
            padding: 4px 10px;
        }

        .status-upcoming {
            background-color: #6c757d;
            color: white;
        }

        .status-active {
            background-color: #0d6efd;
            color: white;
        }

        .status-overdue {
            background-color: #dc3545;
            color: white;
        }

        .status-completed {
            background-color: #198754;
            color: white;
        }

        .submission-status {
            font-size: 0.8rem;
        }

        .grading-progress {
            height: 6px;
        }
    </style>
</head>

<body>
    <%- include('../partials/navbar') %>

        <div class="container mt-4">
            <%- include('../partials/alerts') %>

                <!-- School info banner -->
                <div class="alert alert-info mb-4">
                    <i class="fas fa-school me-2"></i>
                    <strong>School:</strong>
                    <%= userSchool || 'All Schools' %>
                    <% if (isSuperAdmin) { %>
                        <span class="badge bg-warning ms-2">Super Admin</span>
                    <% } %>
                </div>

                <div class="row">
                    <!-- Left Sidebar with Profile -->
                    <div class="col-md-3">
                        <div class="profile-section text-center">
                            <% if (user.avatar) { %>
                                <img src="<%= user.avatar.startsWith('/') ? user.avatar : '/' + user.avatar %>"
                                    alt="Teacher Profile" class="profile-img mb-3 avatar-img"
                                    onerror="this.onerror=null; this.src='/images/default-profile.png'">
                            <% } else { %>
                                <img src="/images/default-profile.png" alt="Teacher Profile"
                                    class="profile-img mb-3">
                            <% } %>
                            <h4>
                                <%= user.firstName %>
                                <%= user.lastName %>
                            </h4>
                            <p class="welcome-text">Assignments</p>
                            <span class="user-role">Teacher</span>
                            <div class="mt-2">
                                <small><i class="fas fa-school me-1"></i>
                                    <%= userSchool %>
                                </small>
                            </div>
                        </div>

                        <div class="card dashboard-card mb-4">
                            <div class="card-header">
                                <h5>Quick Actions</h5>
                            </div>
                            <div class="card-body">
                                <a href="/teacher/assignments" class="btn btn-outline-primary w-100 mb-2 action-btn">
                                    <i class="fas fa-tasks"></i> All Assignments
                                </a>
                                <a href="/teacher/assignments/create"
                                    class="btn btn-outline-success w-100 mb-2 action-btn">
                                    <i class="fas fa-plus"></i> Create Assignment
                                </a>
                                <a href="/teacher/grading" class="btn btn-outline-warning w-100 mb-2 action-btn">
                                    <i class="fas fa-graduation-cap"></i> Grading
                                </a>
                                <a href="/teacher/students" class="btn btn-outline-info w-100 mb-2 action-btn">
                                    <i class="fas fa-users"></i> Students
                                </a>
                                <a href="/teacher/dashboard" class="btn btn-outline-secondary w-100 mb-2 action-btn">
                                    <i class="fas fa-home"></i> Dashboard
                                </a>
                            </div>
                        </div>

                        <!-- Assignment Stats -->
                        <div class="card dashboard-card mb-4">
                            <div class="card-header">
                                <h5>Assignment Stats</h5>
                            </div>
                            <div class="card-body">
                                <% 
                                    let totalAssignments = 0;
                                    let pendingGrading = 0;
                                    let totalSubmissions = 0;
                                    if (assignments) { 
                                        totalAssignments = assignments.length;
                                        assignments.forEach(function(assignment) { 
                                            totalSubmissions += assignment.submissions ? assignment.submissions.length : 0; 
                                            if (assignment.submissions) {
                                                assignment.submissions.forEach(function(submission) { 
                                                    if (submission.grade === null) {
                                                        pendingGrading += 1; 
                                                    } 
                                                }); 
                                            } 
                                        }); 
                                    } 
                                %>
                                <div class="mb-2">
                                    <small><strong>Total Assignments:</strong></small>
                                    <span class="badge bg-primary float-end"><%= totalAssignments %></span>
                                </div>
                                <div class="mb-2">
                                    <small><strong>Total Submissions:</strong></small>
                                    <span class="badge bg-info float-end"><%= totalSubmissions %></span>
                                </div>
                                <div class="mb-2">
                                    <small><strong>Pending Grading:</strong></small>
                                    <span class="badge bg-warning float-end"><%= pendingGrading %></span>
                                </div>
                                <% if (totalSubmissions > 0) { %>
                                    <div class="mb-2">
                                        <small><strong>Grading Progress:</strong></small>
                                        <div class="progress grading-progress mt-1">
                                            <div class="progress-bar bg-success"
                                                style="width: <%= ((totalSubmissions - pendingGrading) / totalSubmissions * 100) %>%">
                                            </div>
                                        </div>
                                    </div>
                                <% } %>
                            </div>
                        </div>
                    </div>

                    <!-- Main Content -->
                    <div class="col-md-9">
                        <!-- Page Header -->
                        <div class="d-flex justify-content-between align-items-center mb-4">
                            <h2><i class="fas fa-tasks me-2"></i>
                                <%= title %>
                            </h2>
                            <div>
                                <a href="/teacher/assignments/create" class="btn btn-success">
                                    <i class="fas fa-plus me-1"></i> Create Assignment
                                </a>
                                <a href="/teacher/grading" class="btn btn-warning ms-2">
                                    <i class="fas fa-graduation-cap me-1"></i> Grading
                                </a>
                            </div>
                        </div>

                        <!-- Assignment Tabs -->
                        <ul class="nav nav-tabs mb-4" id="assignmentTabs" role="tablist">
                            <li class="nav-item" role="presentation">
                                <button class="nav-link active" id="active-tab" data-bs-toggle="tab"
                                    data-bs-target="#active" type="button">
                                    <% 
                                        let activeCount = 0; 
                                        if (assignments) { 
                                            activeCount = assignments.filter(function(a) {
                                                return new Date(a.dueDate) > new Date();
                                            }).length;
                                        }
                                    %>
                                    Active (<%= activeCount %>)
                                </button>
                            </li>
                            <li class="nav-item" role="presentation">
                                <button class="nav-link" id="completed-tab" data-bs-toggle="tab"
                                    data-bs-target="#completed" type="button">
                                    <% 
                                        let completedCount = 0; 
                                        if (assignments) {
                                            completedCount = assignments.filter(function(a) { 
                                                return new Date(a.dueDate) <= new Date(); 
                                            }).length; 
                                        } 
                                    %>
                                    Completed (<%= completedCount %>)
                                </button>
                            </li>
                        </ul>

                        <!-- Assignment Content -->
                        <div class="tab-content" id="assignmentTabContent">
                            <!-- Active Assignments -->
                            <div class="tab-pane fade show active" id="active" role="tabpanel">
                                <div class="row" id="activeAssignments">
                                    <% if (assignments) { 
                                        const activeAssignments = assignments.filter(function(a) {
                                            return new Date(a.dueDate) > new Date();
                                        });
                                        if (activeAssignments.length > 0) {
                                            activeAssignments.forEach(function(assignment) {
                                                const daysUntilDue = Math.ceil((new Date(assignment.dueDate) - new Date()) / (1000 * 60 * 60 * 24));
                                                const submissions = assignment.submissions ? assignment.submissions.length : 0;
                                                const pendingGrading = assignment.submissions ?
                                                    assignment.submissions.filter(function(s) {
                                                        return s.grade === null;
                                                    }).length : 0;
                                    %>
                                        <div class="col-md-6 col-lg-4 mb-4">
                                            <div class="card assignment-card h-100">
                                                <div class="card-body">
                                                    <div class="d-flex justify-content-between align-items-start mb-2">
                                                        <div>
                                                            <span class="badge <%= 
                                                                daysUntilDue <= 1 ? 'status-overdue' : 
                                                                daysUntilDue <= 3 ? 'status-active' : 'status-upcoming'
                                                            %> status-badge">
                                                                <% if (daysUntilDue <= 0) { %>
                                                                    Due Today
                                                                <% } else if (daysUntilDue === 1) { %>
                                                                    Due Tomorrow
                                                                <% } else { %>
                                                                    Due in <%= daysUntilDue %> days
                                                                <% } %>
                                                            </span>
                                                        </div>
                                                        <div class="dropdown">
                                                            <button
                                                                class="btn btn-sm btn-outline-secondary dropdown-toggle"
                                                                type="button" data-bs-toggle="dropdown">
                                                                <i class="fas fa-ellipsis-v"></i>
                                                            </button>
                                                            <ul class="dropdown-menu">
                                                                <li>
                                                                    <a class="dropdown-item"
                                                                        href="/teacher/assignments/view/<%= assignment.id %>">
                                                                        <i class="fas fa-eye me-2"></i>View Details
                                                                    </a>
                                                                </li>
                                                                <li>
                                                                    <button class="dropdown-item"
                                                                        onclick="editAssignment('<%= assignment.id %>')">
                                                                        <i class="fas fa-edit me-2"></i>Edit
                                                                    </button>
                                                                </li>
                                                                <li>
                                                                    <a class="dropdown-item"
                                                                        href="/teacher/grading?assignment=<%= assignment.id %>">
                                                                        <i class="fas fa-graduation-cap me-2"></i>Grade
                                                                    </a>
                                                                </li>
                                                                <li>
                                                                    <hr class="dropdown-divider">
                                                                </li>
                                                                <li>
                                                                    <button class="dropdown-item text-danger"
                                                                        onclick="deleteAssignment('<%= assignment.id %>')">
                                                                        <i class="fas fa-trash me-2"></i>Delete
                                                                    </button>
                                                                </li>
                                                            </ul>
                                                        </div>
                                                    </div>

                                                    <h5 class="card-title"><%= assignment.title %></h5>
                                                    <% if (assignment.description) { %>
                                                        <p class="card-text text-muted small mb-2">
                                                            <%= assignment.description.length > 100 ?
                                                                assignment.description.substring(0, 100) + '...' :
                                                                assignment.description %>
                                                        </p>
                                                        <!-- ✅ UPLOADED BADGE -->
                                                        <% if (assignment.description.length > 200) { %>
                                                            <span class="badge bg-light text-dark mt-1">
                                                                <i class="fas fa-file-upload me-1"></i>Uploaded
                                                            </span>
                                                        <% } %>
                                                    <% } %>

                                                    <div class="mb-3">
                                                        <% if (assignment.class) { %>
                                                            <small class="text-muted">
                                                                <i class="fas fa-chalkboard me-1"></i>
                                                                <%= assignment.class.name %>
                                                            </small>
                                                        <% } %>
                                                        <div class="mt-1">
                                                            <small class="text-muted">
                                                                <i class="fas fa-calendar me-1"></i>
                                                                Due: <%= new Date(assignment.dueDate).toLocaleDateString() %>
                                                            </small>
                                                        </div>
                                                    </div>

                                                    <!-- Progress Bar -->
                                                    <div class="mb-2">
                                                        <small class="d-block mb-1">Submissions: <%= submissions %></small>
                                                        <div class="progress" style="height: 6px;">
                                                            <div class="progress-bar bg-success"
                                                                style="width: <%= submissions > 0 ? '100' : '0' %>%">
                                                            </div>
                                                        </div>
                                                    </div>

                                                    <!-- Submission Status -->
                                                    <div class="d-flex justify-content-between align-items-center mt-3">
                                                        <div class="submission-status">
                                                            <% if (pendingGrading > 0) { %>
                                                                <span class="badge bg-warning">
                                                                    <i class="fas fa-clock me-1"></i>
                                                                    <%= pendingGrading %> to grade
                                                                </span>
                                                            <% } else if (submissions > 0) { %>
                                                                <span class="badge bg-success">
                                                                    <i class="fas fa-check me-1"></i>
                                                                    All graded
                                                                </span>
                                                            <% } else { %>
                                                                <span class="badge bg-secondary">
                                                                    <i class="fas fa-clock me-1"></i>
                                                                    No submissions
                                                                </span>
                                                            <% } %>
                                                        </div>
                                                        <div>
                                                            <a href="/teacher/assignments/view/<%= assignment.id %>"
                                                                class="btn btn-sm btn-primary">
                                                                View
                                                            </a>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    <% 
                                            });
                                        } else { 
                                    %>
                                        <div class="col-12">
                                            <div class="card">
                                                <div class="card-body text-center py-5">
                                                    <i class="fas fa-tasks fa-3x text-muted mb-3"></i>
                                                    <h4>No Active Assignments</h4>
                                                    <p class="text-muted">You don't have any active assignments at the moment.</p>
                                                    <a href="/teacher/assignments/create" class="btn btn-success">
                                                        <i class="fas fa-plus me-1"></i> Create Your First Assignment
                                                    </a>
                                                </div>
                                            </div>
                                        </div>
                                    <% 
                                        }
                                    } %>
                                </div>
                            </div>

                            <!-- Completed Assignments -->
                            <div class="tab-pane fade" id="completed" role="tabpanel">
                                <div class="row">
                                    <% if (assignments) { 
                                        const completedAssignments = assignments.filter(function(a) {
                                            return new Date(a.dueDate) <= new Date();
                                        });
                                        if (completedAssignments.length > 0) {
                                            completedAssignments.forEach(function(assignment) {
                                                const submissions = assignment.submissions ? assignment.submissions.length : 0;
                                                const graded = assignment.submissions ?
                                                    assignment.submissions.filter(function(s) {
                                                        return s.grade !== null;
                                                    }).length : 0;
                                    %>
                                        <div class="col-md-6 col-lg-4 mb-4">
                                            <div class="card assignment-card h-100">
                                                <div class="card-body">
                                                    <div class="d-flex justify-content-between align-items-start mb-2">
                                                        <div>
                                                            <span class="badge status-completed status-badge">
                                                                Completed
                                                            </span>
                                                        </div>
                                                        <div class="dropdown">
                                                            <button
                                                                class="btn btn-sm btn-outline-secondary dropdown-toggle"
                                                                type="button" data-bs-toggle="dropdown">
                                                                <i class="fas fa-ellipsis-v"></i>
                                                            </button>
                                                            <ul class="dropdown-menu">
                                                                <li>
                                                                    <a class="dropdown-item"
                                                                        href="/teacher/assignments/view/<%= assignment.id %>">
                                                                        <i class="fas fa-eye me-2"></i>View Details
                                                                    </a>
                                                                </li>
                                                                <li>
                                                                    <a class="dropdown-item"
                                                                        href="/teacher/grading?assignment=<%= assignment.id %>">
                                                                        <i class="fas fa-graduation-cap me-2"></i>Grade
                                                                    </a>
                                                                </li>
                                                            </ul>
                                                        </div>
                                                    </div>

                                                    <h5 class="card-title"><%= assignment.title %></h5>
                                                    <% if (assignment.description) { %>
                                                        <p class="card-text text-muted small mb-2">
                                                            <%= assignment.description.length > 50 ?
                                                                assignment.description.substring(0, 50) + '...' :
                                                                assignment.description %>
                                                        </p>
                                                        <!-- ✅ UPLOADED BADGE -->
                                                        <% if (assignment.description.length > 200) { %>
                                                            <span class="badge bg-light text-dark mt-1">
                                                                <i class="fas fa-file-upload me-1"></i>Uploaded
                                                            </span>
                                                        <% } %>
                                                    <% } %>

                                                    <div class="mb-3">
                                                        <% if (assignment.class) { %>
                                                            <small class="text-muted">
                                                                <i class="fas fa-chalkboard me-1"></i>
                                                                <%= assignment.class.name %>
                                                            </small>
                                                        <% } %>
                                                        <div class="mt-1">
                                                            <small class="text-muted">
                                                                <i class="fas fa-calendar me-1"></i>
                                                                Due: <%= new Date(assignment.dueDate).toLocaleDateString() %>
                                                            </small>
                                                        </div>
                                                    </div>

                                                    <!-- Grading Status -->
                                                    <div class="mb-2">
                                                        <small class="d-block mb-1">Grading Progress:
                                                            <%= graded %> / <%= submissions %>
                                                        </small>
                                                        <div class="progress" style="height: 6px;">
                                                            <div class="progress-bar <%= 
                                                                submissions === 0 ? 'bg-secondary' : 
                                                                graded === submissions ? 'bg-success' : 'bg-warning'
                                                            %>" style="width: <%= submissions > 0 ? (graded / submissions * 100) : 0 %>%">
                                                            </div>
                                                        </div>
                                                    </div>

                                                    <div class="d-flex justify-content-between align-items-center mt-3">
                                                        <div>
                                                            <% if (submissions > 0) { %>
                                                                <span class="badge <%= 
                                                                    graded === submissions ? 'bg-success' : 'bg-warning'
                                                                %>">
                                                                    <%= graded === submissions ? 'All Graded' : 'Incomplete Grading' %>
                                                                </span>
                                                            <% } else { %>
                                                                <span class="badge bg-secondary">No Submissions</span>
                                                            <% } %>
                                                        </div>
                                                        <div>
                                                            <a href="/teacher/assignments/view/<%= assignment.id %>"
                                                                class="btn btn-sm btn-outline-primary">
                                                                View Results
                                                            </a>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    <% 
                                            });
                                        } else { 
                                    %>
                                        <div class="col-12">
                                            <div class="card">
                                                <div class="card-body text-center py-5">
                                                    <i class="fas fa-check-circle fa-3x text-muted mb-3"></i>
                                                    <h4>No Completed Assignments</h4>
                                                    <p class="text-muted">You don't have any completed assignments yet.</p>
                                                </div>
                                            </div>
                                        </div>
                                    <% 
                                        }
                                    } %>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
        </div>

        <!-- Delete Confirmation Modal -->
        <div class="modal fade" id="deleteAssignmentModal" tabindex="-1">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Confirm Delete</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <p>Are you sure you want to delete this assignment? This action cannot be undone.</p>
                        <p class="text-danger"><strong>Warning:</strong> All submissions will also be deleted.</p>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="button" class="btn btn-danger" id="confirmDeleteBtn">Delete Assignment</button>
                    </div>
                </div>
            </div>
        </div>

        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
        <script>
            let assignmentToDelete = null;

            function editAssignment(assignmentId) {
                window.location.href = `/teacher/assignments/view/${assignmentId}`;
            }

            function deleteAssignment(assignmentId) {
                assignmentToDelete = assignmentId;
                const modal = new bootstrap.Modal(document.getElementById('deleteAssignmentModal'));
                modal.show();
            }

            document.getElementById('confirmDeleteBtn').addEventListener('click', function () {
                if (assignmentToDelete) {
                    fetch(`/teacher/assignments/${assignmentToDelete}`, {
                        method: 'DELETE',
                        headers: { 'Content-Type': 'application/json' }
                    })
                        .then(response => response.json())
                        .then(data => {
                            if (data.success) {
                                alert('Assignment deleted successfully');
                                location.reload();
                            } else {
                                alert('Error deleting assignment: ' + data.message);
                            }
                        })
                        .catch(error => {
                            console.error('Error:', error);
                            alert('Error deleting assignment');
                        });

                    const modal = bootstrap.Modal.getInstance(document.getElementById('deleteAssignmentModal'));
                    modal.hide();
                }
            });

            document.getElementById('assignmentTabs').addEventListener('click', function (e) {
                if (e.target.tagName === 'BUTTON') {
                    const tabId = e.target.getAttribute('data-bs-target');
                    history.pushState(null, '', `/teacher/assignments${tabId === '#completed' ? '?tab=completed' : ''}`);
                }
            });
        </script>
</body>

</html>