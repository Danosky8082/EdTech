<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= title %> - EdTech
    </title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <style>
        /* ... your existing styles (unchanged) ... */
        .assignment-card {
            border-left: 4px solid #0dcaf0;
            transition: all 0.3s ease;
        }

        .assignment-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 6px 20px rgba(0, 0, 0, 0.1);
        }

        .status-badge {
            font-size: 0.75rem;
            padding: 4px 10px;
        }

        .status-upcoming {
            background-color: #6c757d;
            color: white;
        }

        .status-active {
            background-color: #0d6efd;
            color: white;
        }

        .status-overdue {
            background-color: #dc3545;
            color: white;
        }

        .status-completed {
            background-color: #198754;
            color: white;
        }

        .submission-status {
            font-size: 0.8rem;
        }

        .grading-progress {
            height: 6px;
        }
    </style>
</head>

<body>
    <%- include('../partials/navbar') %>

        <div class="container mt-4">
            <%- include('../partials/alerts') %>

                <div class="alert alert-info mb-4">
                    <i class="fas fa-school me-2"></i>
                    <strong>School:</strong>
                    <%= userSchool || 'All Schools' %>
                        <% if (isSuperAdmin) { %>
                            <span class="badge bg-warning ms-2">Super Admin</span>
                            <% } %>
                </div>

                <div class="row">
                    <!-- Left Sidebar with Profile -->
                    <div class="col-md-3">
                        <div class="profile-section text-center">
                            <%- include('../partials/user-avatar', { localClass: 'profile-img mb-3 avatar-img' }) %>
                                <h4>
                                    <%= user.firstName %>
                                        <%= user.lastName %>
                                </h4>
                                <p class="welcome-text">Assignments</p>
                                <span class="user-role">Teacher</span>
                                <div class="mt-2">
                                    <small><i class="fas fa-school me-1"></i>
                                        <%= userSchool %>
                                    </small>
                                </div>
                        </div>

                        <!-- Quick Actions (unchanged) -->
                        <div class="card dashboard-card mb-4">
                            <div class="card-header">
                                <h5>Quick Actions</h5>
                            </div>
                            <div class="card-body">
                                <a href="/teacher/assignments" class="btn btn-outline-primary w-100 mb-2 action-btn"><i
                                        class="fas fa-tasks"></i> All Assignments</a>
                                <a href="/teacher/assignments/create"
                                    class="btn btn-outline-success w-100 mb-2 action-btn"><i class="fas fa-plus"></i>
                                    Create Assignment</a>
                                <a href="/teacher/grading" class="btn btn-outline-warning w-100 mb-2 action-btn"><i
                                        class="fas fa-graduation-cap"></i> Grading</a>
                                <a href="/teacher/students" class="btn btn-outline-info w-100 mb-2 action-btn"><i
                                        class="fas fa-users"></i> Students</a>
                                <a href="/teacher/dashboard" class="btn btn-outline-secondary w-100 mb-2 action-btn"><i
                                        class="fas fa-home"></i> Dashboard</a>
                            </div>
                        </div>

                        <!-- Assignment Stats (unchanged) -->
                        <div class="card dashboard-card mb-4">
                            <div class="card-header">
                                <h5>Assignment Stats</h5>
                            </div>
                            <div class="card-body">
                                <% let totalAssignments=0; let pendingGrading=0; let totalSubmissions=0; if
                                    (assignments) { totalAssignments=assignments.length;
                                    assignments.forEach(function(assignment) { totalSubmissions +=assignment.submissions
                                    ? assignment.submissions.length : 0; if (assignment.submissions) {
                                    assignment.submissions.forEach(function(submission) { if (submission.grade===null) {
                                    pendingGrading +=1; } }); } }); } %>
                                    <div class="mb-2"><small><strong>Total Assignments:</strong></small><span
                                            class="badge bg-primary float-end">
                                            <%= totalAssignments %>
                                        </span></div>
                                    <div class="mb-2"><small><strong>Total Submissions:</strong></small><span
                                            class="badge bg-info float-end">
                                            <%= totalSubmissions %>
                                        </span></div>
                                    <div class="mb-2"><small><strong>Pending Grading:</strong></small><span
                                            class="badge bg-warning float-end">
                                            <%= pendingGrading %>
                                        </span></div>
                                    <% if (totalSubmissions> 0) { %>
                                        <div class="mb-2">
                                            <small><strong>Grading Progress:</strong></small>
                                            <div class="progress grading-progress mt-1">
                                                <div class="progress-bar bg-success"
                                                    style="width: <%= ((totalSubmissions - pendingGrading) / totalSubmissions * 100) %>%">
                                                </div>
                                            </div>
                                        </div>
                                        <% } %>
                            </div>
                        </div>
                    </div>

                    <!-- Main Content (unchanged) -->
                    <div class="col-md-9">
                        <!-- Page Header -->
                        <div class="d-flex justify-content-between align-items-center mb-4">
                            <h2><i class="fas fa-tasks me-2"></i>
                                <%= title %>
                            </h2>
                            <div>
                                <a href="/teacher/assignments/create" class="btn btn-success"><i
                                        class="fas fa-plus me-1"></i> Create Assignment</a>
                                <a href="/teacher/grading" class="btn btn-warning ms-2"><i
                                        class="fas fa-graduation-cap me-1"></i> Grading</a>
                            </div>
                        </div>

                        <!-- Assignment Tabs and Content (unchanged) -->
                        <ul class="nav nav-tabs mb-4" id="assignmentTabs" role="tablist">
                            <!-- ... -->
                        </ul>
                        <div class="tab-content" id="assignmentTabContent">
                            <!-- ... -->
                        </div>
                    </div>
                </div>
        </div>

        <!-- Modal and scripts (unchanged) -->
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
        <script>
            // ... your existing JavaScript ...
        </script>
</body>

</html>