<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= title %> - EdTech
    </title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <style>
        /* Same base styles as other pages */
        .exam-card {
            border-left: 4px solid #dc3545;
            transition: all 0.3s ease;
        }

        .exam-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 6px 20px rgba(0, 0, 0, 0.1);
        }

        .status-badge {
            font-size: 0.75rem;
            padding: 4px 10px;
        }

        .exam-status-upcoming {
            background-color: #0d6efd;
            color: white;
        }

        .exam-status-active {
            background-color: #198754;
            color: white;
        }

        .exam-status-completed {
            background-color: #6c757d;
            color: white;
        }

        .question-count {
            font-size: 0.8rem;
        }

        .attempts-badge {
            background-color: #6f42c1;
            color: white;
        }
    </style>
</head>

<body>
    <%- include('../partials/navbar') %>

        <div class="container mt-4">
            <%- include('../partials/alerts') %>

                <!-- School info banner -->
                <div class="alert alert-info mb-4">
                    <i class="fas fa-school me-2"></i>
                    <strong>School:</strong>
                    <%= userSchool || 'All Schools' %>
                        <% if (isSuperAdmin) { %>
                            <span class="badge bg-warning ms-2">Super Admin</span>
                            <% } %>
                </div>

                <!-- Success/Error Messages -->
                <% if (success) { %>
                    <div class="alert alert-success alert-dismissible fade show">
                        <i class="fas fa-check-circle me-2"></i>
                        <%= success %>
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                    <% } %>

                        <% if (error) { %>
                            <div class="alert alert-danger alert-dismissible fade show">
                                <i class="fas fa-exclamation-circle me-2"></i>
                                <%= error %>
                                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                            </div>
                            <% } %>

                                <div class="row">
                                    <!-- Left Sidebar with Profile -->
                                    <div class="col-md-3">
                                        <div class="profile-section text-center">
                                            <% if (user.avatar) { %>
                                                <img src="<%= user.avatar.startsWith('/') ? user.avatar : '/' + user.avatar %>"
                                                    alt="Teacher Profile" class="profile-img mb-3 avatar-img"
                                                    onerror="this.onerror=null; this.src='/images/default-profile.png'">
                                                <% } else { %>
                                                    <img src="/images/default-profile.png" alt="Teacher Profile"
                                                        class="profile-img mb-3">
                                                    <% } %>
                                                        <h4>
                                                            <%= user.firstName %>
                                                                <%= user.lastName %>
                                                        </h4>
                                                        <p class="welcome-text">Exams & Assessments</p>
                                                        <span class="user-role">Teacher</span>
                                                        <div class="mt-2">
                                                            <small><i class="fas fa-school me-1"></i>
                                                                <%= userSchool %>
                                                            </small>
                                                        </div>
                                        </div>

                                        <div class="card dashboard-card mb-4">
                                            <div class="card-header">
                                                <h5>Quick Actions</h5>
                                            </div>
                                            <div class="card-body">
                                                <a href="/teacher/exams"
                                                    class="btn btn-outline-danger w-100 mb-2 action-btn">
                                                    <i class="fas fa-clipboard-list"></i> All Exams
                                                </a>
                                                <a href="/teacher/exams/create"
                                                    class="btn btn-outline-success w-100 mb-2 action-btn">
                                                    <i class="fas fa-plus"></i> Create Exam
                                                </a>
                                                <a href="/teacher/assignments"
                                                    class="btn btn-outline-primary w-100 mb-2 action-btn">
                                                    <i class="fas fa-tasks"></i> Assignments
                                                </a>
                                                <a href="/teacher/class-works"
                                                    class="btn btn-outline-info w-100 mb-2 action-btn">
                                                    <i class="fas fa-tasks"></i> Class Works
                                                </a>
                                                <a href="/teacher/dashboard"
                                                    class="btn btn-outline-secondary w-100 mb-2 action-btn">
                                                    <i class="fas fa-home"></i> Dashboard
                                                </a>
                                            </div>
                                        </div>

                                        <!-- Exam Stats -->
                                        <div class="card dashboard-card mb-4">
                                            <div class="card-header">
                                                <h5>Exam Statistics</h5>
                                            </div>
                                            <div class="card-body">
                                                <% let upcomingCount=0; let activeCount=0; let completedCount=0; let
                                                    totalAttempts=0; if (exams) { const now=new Date();
                                                    upcomingCount=exams.filter(e=> new Date(e.date) > now).length;
                                                    completedCount = exams.filter(e => new Date(e.date) <= now).length;
                                                        exams.forEach(exam=> {
                                                        totalAttempts += exam.attempts.length;
                                                        });
                                                        }
                                                        %>
                                                        <div class="mb-2">
                                                            <small><strong>Total Exams:</strong></small>
                                                            <span class="badge bg-primary float-end">
                                                                <%= exams ? exams.length : 0 %>
                                                            </span>
                                                        </div>
                                                        <div class="mb-2">
                                                            <small><strong>Upcoming:</strong></small>
                                                            <span class="badge bg-info float-end">
                                                                <%= upcomingCount %>
                                                            </span>
                                                        </div>
                                                        <div class="mb-2">
                                                            <small><strong>Completed:</strong></small>
                                                            <span class="badge bg-secondary float-end">
                                                                <%= completedCount %>
                                                            </span>
                                                        </div>
                                                        <div class="mb-2">
                                                            <small><strong>Total Attempts:</strong></small>
                                                            <span class="badge bg-success float-end">
                                                                <%= totalAttempts %>
                                                            </span>
                                                        </div>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Main Content -->
                                    <div class="col-md-9">
                                        <!-- Page Header -->
                                        <div class="d-flex justify-content-between align-items-center mb-4">
                                            <h2><i class="fas fa-clipboard-list me-2"></i>
                                                <%= title %>
                                            </h2>
                                            <div>
                                                <a href="/teacher/exams/create" class="btn btn-success">
                                                    <i class="fas fa-plus me-1"></i> Create Exam
                                                </a>
                                                <a href="/teacher/exams?view=upcoming"
                                                    class="btn btn-outline-primary ms-2">
                                                    <i class="fas fa-calendar me-1"></i> Upcoming
                                                </a>
                                            </div>
                                        </div>

                                        <!-- Exam Tabs -->
                                        <ul class="nav nav-tabs mb-4" id="examTabs" role="tablist">
                                            <li class="nav-item" role="presentation">
                                                <button class="nav-link active" id="upcoming-tab" data-bs-toggle="tab"
                                                    data-bs-target="#upcoming" type="button">
                                                    Upcoming (<%= upcomingExams ? upcomingExams.length : 0 %>)
                                                </button>
                                            </li>
                                            <li class="nav-item" role="presentation">
                                                <button class="nav-link" id="recent-tab" data-bs-toggle="tab"
                                                    data-bs-target="#recent" type="button">
                                                    Recent (<%= recentExams ? recentExams.length : 0 %>)
                                                </button>
                                            </li>
                                            <li class="nav-item" role="presentation">
                                                <button class="nav-link" id="all-tab" data-bs-toggle="tab"
                                                    data-bs-target="#all" type="button">
                                                    All Exams (<%= exams ? exams.length : 0 %>)
                                                </button>
                                            </li>
                                        </ul>

                                        <!-- Exam Content -->
                                        <div class="tab-content" id="examTabContent">
                                            <!-- Upcoming Exams -->
                                            <div class="tab-pane fade show active" id="upcoming" role="tabpanel">
                                                <div class="row">
                                                    <% if (upcomingExams && upcomingExams.length> 0) { %>
                                                        <% upcomingExams.forEach(exam=> {
                                                            const daysUntilExam = Math.ceil((new Date(exam.date) - new
                                                            Date()) / (1000 * 60 * 60 * 24));
                                                            %>
                                                            <div class="col-md-6 col-lg-4 mb-4">
                                                                <div class="card exam-card h-100">
                                                                    <div class="card-body">
                                                                        <div
                                                                            class="d-flex justify-content-between align-items-start mb-2">
                                                                            <div>
                                                                                <span
                                                                                    class="badge exam-status-upcoming status-badge">
                                                                                    <% if (daysUntilExam===0) { %>
                                                                                        Today
                                                                                        <% } else if (daysUntilExam===1)
                                                                                            { %>
                                                                                            Tomorrow
                                                                                            <% } else { %>
                                                                                                In <%= daysUntilExam %>
                                                                                                    days
                                                                                                    <% } %>
                                                                                </span>
                                                                            </div>
                                                                            <div class="dropdown">
                                                                                <button
                                                                                    class="btn btn-sm btn-outline-secondary dropdown-toggle"
                                                                                    type="button"
                                                                                    data-bs-toggle="dropdown">
                                                                                    <i class="fas fa-ellipsis-v"></i>
                                                                                </button>
                                                                                <ul class="dropdown-menu">
                                                                                    <li>
                                                                                        <a class="dropdown-item"
                                                                                            href="/teacher/exam/<%= exam.id %>">
                                                                                            <i
                                                                                                class="fas fa-eye me-2"></i>View
                                                                                            Details
                                                                                        </a>
                                                                                    </li>
                                                                                    <li>
                                                                                        <a class="dropdown-item"
                                                                                            href="/teacher/exams/create?id=<%= exam.id %>">
                                                                                            <i
                                                                                                class="fas fa-edit me-2"></i>Edit
                                                                                        </a>
                                                                                    </li>
                                                                                    <li>
                                                                                        <a class="dropdown-item"
                                                                                            href="/teacher/exams/create?duplicate=<%= exam.id %>">
                                                                                            <i
                                                                                                class="fas fa-copy me-2"></i>Duplicate
                                                                                        </a>
                                                                                    </li>
                                                                                    <li>
                                                                                        <hr class="dropdown-divider">
                                                                                    </li>
                                                                                    <li>
                                                                                        <button
                                                                                            class="dropdown-item text-danger"
                                                                                            onclick="deleteExam('<%= exam.id %>')">
                                                                                            <i
                                                                                                class="fas fa-trash me-2"></i>Delete
                                                                                        </button>
                                                                                    </li>
                                                                                </ul>
                                                                            </div>
                                                                        </div>

                                                                        <h5 class="card-title">
                                                                            <%= exam.title %>
                                                                        </h5>
                                                                        <% if (exam.description) { %>
                                                                            <p class="card-text text-muted small mb-2">
                                                                                <%= exam.description.length> 80 ?
                                                                                    exam.description.substring(0, 80) +
                                                                                    '...' : exam.description %>
                                                                            </p>
                                                                            <% } %>

                                                                                <div class="mb-3">
                                                                                    <% if (exam.class) { %>
                                                                                        <small
                                                                                            class="text-muted d-block">
                                                                                            <i
                                                                                                class="fas fa-chalkboard me-1"></i>
                                                                                            <%= exam.class.name %>
                                                                                        </small>
                                                                                        <% } %>
                                                                                            <small class="text-muted">
                                                                                                <i
                                                                                                    class="fas fa-calendar me-1"></i>
                                                                                                <%= new
                                                                                                    Date(exam.date).toLocaleDateString()
                                                                                                    %>
                                                                                                    at <%= new
                                                                                                        Date(exam.date).toLocaleTimeString([],
                                                                                                        {hour: '2-digit'
                                                                                                        ,
                                                                                                        minute:'2-digit'})
                                                                                                        %>
                                                                                            </small>
                                                                                            <br>
                                                                                            <small class="text-muted">
                                                                                                <i
                                                                                                    class="fas fa-clock me-1"></i>
                                                                                                Duration: <%=
                                                                                                    exam.duration %>
                                                                                                    minutes
                                                                                            </small>
                                                                                </div>

                                                                                <!-- Question Info -->
                                                                                <div
                                                                                    class="d-flex justify-content-between align-items-center mb-3">
                                                                                    <div class="question-count">
                                                                                        <% if
                                                                                            (Array.isArray(exam.questions))
                                                                                            { %>
                                                                                            <span class="badge bg-info">
                                                                                                <%= exam.questions.length
                                                                                                    %> questions
                                                                                            </span>
                                                                                            <% } else { %>
                                                                                                <span
                                                                                                    class="badge bg-info">Questions:
                                                                                                    N/A</span>
                                                                                                <% } %>
                                                                                    </div>
                                                                                    <div>
                                                                                        <span class="badge bg-dark">
                                                                                            <%= exam.totalMarks || 100
                                                                                                %> marks
                                                                                        </span>
                                                                                    </div>
                                                                                </div>

                                                                                <!-- Student Count -->
                                                                                <div
                                                                                    class="d-flex justify-content-between align-items-center">
                                                                                    <small class="text-muted">
                                                                                        <i
                                                                                            class="fas fa-users me-1"></i>
                                                                                        <% if (exam.class &&
                                                                                            exam.class._count &&
                                                                                            exam.class._count.enrollments)
                                                                                            { %>
                                                                                            <%= exam.class._count.enrollments
                                                                                                %> students
                                                                                                <% } else { %>
                                                                                                    Class students
                                                                                                    <% } %>
                                                                                    </small>
                                                                                    <div>
                                                                                        <a href="/teacher/exam/<%= exam.id %>"
                                                                                            class="btn btn-sm btn-primary">
                                                                                            <i
                                                                                                class="fas fa-cog me-1"></i>
                                                                                            Manage
                                                                                        </a>
                                                                                    </div>
                                                                                </div>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                            <% }); %>
                                                                <% } else { %>
                                                                    <div class="col-12">
                                                                        <div class="card">
                                                                            <div class="card-body text-center py-5">
                                                                                <i
                                                                                    class="fas fa-calendar fa-3x text-muted mb-3"></i>
                                                                                <h4>No Upcoming Exams</h4>
                                                                                <p class="text-muted">You don't have any
                                                                                    exams scheduled for the future.</p>
                                                                                <a href="/teacher/exams/create"
                                                                                    class="btn btn-success">
                                                                                    <i class="fas fa-plus me-1"></i>
                                                                                    Schedule New Exam
                                                                                </a>
                                                                            </div>
                                                                        </div>
                                                                    </div>
                                                                    <% } %>
                                                </div>
                                            </div>

                                            <!-- Recent Exams -->
                                            <div class="tab-pane fade" id="recent" role="tabpanel">
                                                <div class="row">
                                                    <% if (recentExams && recentExams.length> 0) { %>
                                                        <% recentExams.forEach(exam=> {
                                                            const totalAttempts = exam.attempts ? exam.attempts.length :
                                                            0;
                                                            const now = new Date();
                                                            const examDate = new Date(exam.date);
                                                            const isRecentlyCompleted = (now - examDate) / (1000 * 60 *
                                                            60 * 24) <= 7; %>
                                                                <div class="col-md-6 col-lg-4 mb-4">
                                                                    <div class="card exam-card h-100">
                                                                        <div class="card-body">
                                                                            <div
                                                                                class="d-flex justify-content-between align-items-start mb-2">
                                                                                <div>
                                                                                    <span class="badge <%= 
                                                            isRecentlyCompleted ? 'exam-status-active' : 'exam-status-completed'
                                                        %> status-badge">
                                                                                        <%= isRecentlyCompleted
                                                                                            ? 'Recent' : 'Completed' %>
                                                                                    </span>
                                                                                    <% if (totalAttempts> 0) { %>
                                                                                        <span
                                                                                            class="badge attempts-badge ms-1">
                                                                                            <%= totalAttempts %>
                                                                                                attempts
                                                                                        </span>
                                                                                        <% } %>
                                                                                </div>
                                                                                <div class="dropdown">
                                                                                    <button
                                                                                        class="btn btn-sm btn-outline-secondary dropdown-toggle"
                                                                                        type="button"
                                                                                        data-bs-toggle="dropdown">
                                                                                        <i
                                                                                            class="fas fa-ellipsis-v"></i>
                                                                                    </button>
                                                                                    <ul class="dropdown-menu">
                                                                                        <li>
                                                                                            <a class="dropdown-item"
                                                                                                href="/teacher/exam/<%= exam.id %>">
                                                                                                <i
                                                                                                    class="fas fa-eye me-2"></i>View
                                                                                                Details
                                                                                            </a>
                                                                                        </li>
                                                                                        <li>
                                                                                            <a class="dropdown-item"
                                                                                                href="/teacher/exam/<%= exam.id %>/results">
                                                                                                <i
                                                                                                    class="fas fa-chart-bar me-2"></i>View
                                                                                                Results
                                                                                            </a>
                                                                                        </li>
                                                                                        <li>
                                                                                            <a class="dropdown-item"
                                                                                                href="/teacher/exams/create?duplicate=<%= exam.id %>">
                                                                                                <i
                                                                                                    class="fas fa-copy me-2"></i>Reuse
                                                                                            </a>
                                                                                        </li>
                                                                                    </ul>
                                                                                </div>
                                                                            </div>

                                                                            <h5 class="card-title">
                                                                                <%= exam.title %>
                                                                            </h5>
                                                                            <% if (exam.description) { %>
                                                                                <p
                                                                                    class="card-text text-muted small mb-2">
                                                                                    <%= exam.description.length> 60 ?
                                                                                        exam.description.substring(0,
                                                                                        60) + '...' : exam.description
                                                                                        %>
                                                                                </p>
                                                                                <% } %>

                                                                                    <div class="mb-3">
                                                                                        <% if (exam.class) { %>
                                                                                            <small
                                                                                                class="text-muted d-block">
                                                                                                <i
                                                                                                    class="fas fa-chalkboard me-1"></i>
                                                                                                <%= exam.class.name %>
                                                                                            </small>
                                                                                            <% } %>
                                                                                                <small
                                                                                                    class="text-muted">
                                                                                                    <i
                                                                                                        class="fas fa-calendar me-1"></i>
                                                                                                    <%= new
                                                                                                        Date(exam.date).toLocaleDateString()
                                                                                                        %>
                                                                                                </small>
                                                                                                <br>
                                                                                                <small
                                                                                                    class="text-muted">
                                                                                                    <i
                                                                                                        class="fas fa-clock me-1"></i>
                                                                                                    <%= exam.duration %>
                                                                                                        minutes
                                                                                                </small>
                                                                                    </div>

                                                                                    <!-- Results Summary -->
                                                                                    <div class="mb-3">
                                                                                        <% if (totalAttempts> 0) {
                                                                                            const scores =
                                                                                            exam.attempts.map(a =>
                                                                                            a.score).filter(s => s !=
                                                                                            null);
                                                                                            const averageScore =
                                                                                            scores.length > 0 ?
                                                                                            (scores.reduce((a, b) => a +
                                                                                            b, 0) /
                                                                                            scores.length).toFixed(1) :
                                                                                            0;
                                                                                            %>
                                                                                            <div
                                                                                                class="d-flex justify-content-between align-items-center">
                                                                                                <div>
                                                                                                    <small
                                                                                                        class="text-muted">Average
                                                                                                        Score:</small>
                                                                                                    <h6 class="mb-0">
                                                                                                        <%= averageScore
                                                                                                            %> / <%=
                                                                                                                exam.totalMarks
                                                                                                                || 100
                                                                                                                %>
                                                                                                    </h6>
                                                                                                </div>
                                                                                                <div class="text-end">
                                                                                                    <small
                                                                                                        class="text-muted d-block">Participation:</small>
                                                                                                    <h6 class="mb-0">
                                                                                                        <%= totalAttempts
                                                                                                            %> students
                                                                                                    </h6>
                                                                                                </div>
                                                                                            </div>
                                                                                            <% } else { %>
                                                                                                <div
                                                                                                    class="alert alert-warning small mb-0 py-2">
                                                                                                    <i
                                                                                                        class="fas fa-exclamation-triangle me-1"></i>
                                                                                                    No attempts recorded
                                                                                                </div>
                                                                                                <% } %>
                                                                                    </div>

                                                                                    <!-- Action Buttons -->
                                                                                    <div
                                                                                        class="d-flex justify-content-between align-items-center">
                                                                                        <small class="text-muted">
                                                                                            <i
                                                                                                class="fas fa-file-alt me-1"></i>
                                                                                            <% if
                                                                                                (Array.isArray(exam.questions))
                                                                                                { %>
                                                                                                <%= exam.questions.length
                                                                                                    %> questions
                                                                                                    <% } else { %>
                                                                                                        Questions: N/A
                                                                                                        <% } %>
                                                                                        </small>
                                                                                        <div>
                                                                                            <a href="/teacher/exam/<%= exam.id %>/results"
                                                                                                class="btn btn-sm btn-primary">
                                                                                                <i
                                                                                                    class="fas fa-chart-bar me-1"></i>
                                                                                                Results
                                                                                            </a>
                                                                                        </div>
                                                                                    </div>
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                                <% }); %>
                                                                    <% } else { %>
                                                                        <div class="col-12">
                                                                            <div class="card">
                                                                                <div class="card-body text-center py-5">
                                                                                    <i
                                                                                        class="fas fa-history fa-3x text-muted mb-3"></i>
                                                                                    <h4>No Recent Exams</h4>
                                                                                    <p class="text-muted">You haven't
                                                                                        conducted any exams recently.
                                                                                    </p>
                                                                                </div>
                                                                            </div>
                                                                        </div>
                                                                        <% } %>
                                                </div>
                                            </div>

                                            <!-- All Exams -->
                                            <div class="tab-pane fade" id="all" role="tabpanel">
                                                <!-- Search and Filter -->
                                                <div class="card mb-4">
                                                    <div class="card-body">
                                                        <div class="row">
                                                            <div class="col-md-6">
                                                                <label class="form-label">Search Exams:</label>
                                                                <div class="input-group">
                                                                    <input type="text" class="form-control"
                                                                        id="examSearch"
                                                                        placeholder="Search by title, class, or description">
                                                                    <button class="btn btn-outline-secondary"
                                                                        type="button">
                                                                        <i class="fas fa-search"></i>
                                                                    </button>
                                                                </div>
                                                            </div>
                                                            <div class="col-md-6">
                                                                <label class="form-label">Filter by Class:</label>
                                                                <select class="form-select" id="examClassFilter">
                                                                    <option value="">All Classes</option>
                                                                    <% classes.forEach(cls=> { %>
                                                                        <option value="<%= cls.id %>">
                                                                            <%= cls.name %>
                                                                        </option>
                                                                        <% }); %>
                                                                </select>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>

                                                <!-- Exams Table -->
                                                <div class="card">
                                                    <div class="card-body">
                                                        <% if (exams && exams.length> 0) { %>
                                                            <div class="table-responsive">
                                                                <table class="table table-hover">
                                                                    <thead>
                                                                        <tr>
                                                                            <th>Title</th>
                                                                            <th>Class</th>
                                                                            <th>Date & Time</th>
                                                                            <th>Duration</th>
                                                                            <th>Questions</th>
                                                                            <th>Attempts</th>
                                                                            <th>Status</th>
                                                                            <th>Actions</th>
                                                                        </tr>
                                                                    </thead>
                                                                    <tbody>
                                                                        <% exams.forEach(exam=> {
                                                                            const now = new Date();
                                                                            const examDate = new Date(exam.date);
                                                                            const isUpcoming = examDate > now;
                                                                            const totalAttempts = exam.attempts ?
                                                                            exam.attempts.length : 0;
                                                                            %>
                                                                            <tr>
                                                                                <td>
                                                                                    <strong>
                                                                                        <%= exam.title %>
                                                                                    </strong>
                                                                                    <% if (exam.description) { %>
                                                                                        <br><small class="text-muted">
                                                                                            <%= exam.description.substring(0,
                                                                                                50) %>...
                                                                                        </small>
                                                                                        <% } %>
                                                                                </td>
                                                                                <td>
                                                                                    <% if (exam.class) { %>
                                                                                        <%= exam.class.name %>
                                                                                            <% } else { %>
                                                                                                <span
                                                                                                    class="text-muted">N/A</span>
                                                                                                <% } %>
                                                                                </td>
                                                                                <td>
                                                                                    <%= examDate.toLocaleDateString() %>
                                                                                        <br>
                                                                                        <small>
                                                                                            <%= examDate.toLocaleTimeString([],
                                                                                                {hour: '2-digit' ,
                                                                                                minute:'2-digit'}) %>
                                                                                        </small>
                                                                                </td>
                                                                                <td>
                                                                                    <%= exam.duration %> min
                                                                                </td>
                                                                                <td>
                                                                                    <% if
                                                                                        (Array.isArray(exam.questions))
                                                                                        { %>
                                                                                        <%= exam.questions.length %>
                                                                                            <% } else { %>
                                                                                                <span
                                                                                                    class="text-muted">N/A</span>
                                                                                                <% } %>
                                                                                </td>
                                                                                <td>
                                                                                    <span
                                                                                        class="badge <%= totalAttempts > 0 ? 'bg-success' : 'bg-secondary' %>">
                                                                                        <%= totalAttempts %>
                                                                                    </span>
                                                                                </td>
                                                                                <td>
                                                                                    <span class="badge <%= 
                                                                isUpcoming ? 'bg-primary' : 'bg-secondary'
                                                            %>">
                                                                                        <%= isUpcoming ? 'Upcoming'
                                                                                            : 'Completed' %>
                                                                                    </span>
                                                                                </td>
                                                                                <td>
                                                                                    <div class="btn-group btn-group-sm">
                                                                                        <a href="/teacher/exam/<%= exam.id %>"
                                                                                            class="btn btn-outline-primary">
                                                                                            <i class="fas fa-eye"></i>
                                                                                        </a>
                                                                                        <% if (isUpcoming) { %>
                                                                                            <a href="/teacher/exams/create?id=<%= exam.id %>"
                                                                                                class="btn btn-outline-warning">
                                                                                                <i
                                                                                                    class="fas fa-edit"></i>
                                                                                            </a>
                                                                                            <button
                                                                                                class="btn btn-outline-danger"
                                                                                                onclick="deleteExam('<%= exam.id %>')">
                                                                                                <i
                                                                                                    class="fas fa-trash"></i>
                                                                                            </button>
                                                                                            <% } else { %>
                                                                                                <a href="/teacher/exam/<%= exam.id %>/results"
                                                                                                    class="btn btn-outline-success">
                                                                                                    <i
                                                                                                        class="fas fa-chart-bar"></i>
                                                                                                </a>
                                                                                                <% } %>
                                                                                    </div>
                                                                                </td>
                                                                            </tr>
                                                                            <% }); %>
                                                                    </tbody>
                                                                </table>
                                                            </div>
                                                            <% } else { %>
                                                                <div class="text-center py-5">
                                                                    <i
                                                                        class="fas fa-clipboard-list fa-3x text-muted mb-3"></i>
                                                                    <h4>No Exams Found</h4>
                                                                    <p class="text-muted">You haven't created any exams
                                                                        yet.</p>
                                                                    <a href="/teacher/exams/create"
                                                                        class="btn btn-success">
                                                                        <i class="fas fa-plus me-1"></i> Create Your
                                                                        First Exam
                                                                    </a>
                                                                </div>
                                                                <% } %>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
        </div>

        <!-- Delete Confirmation Modal -->
        <div class="modal fade" id="deleteExamModal" tabindex="-1">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Confirm Delete</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <p>Are you sure you want to delete this exam? This action cannot be undone.</p>
                        <p class="text-danger"><strong>Warning:</strong> All exam attempts and results will also be
                            deleted.</p>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="button" class="btn btn-danger" id="confirmExamDeleteBtn">Delete Exam</button>
                    </div>
                </div>
            </div>
        </div>

        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
        <script>
            let examToDelete = null;

            // Delete exam
            function deleteExam(examId) {
                examToDelete = examId;
                const modal = new bootstrap.Modal(document.getElementById('deleteExamModal'));
                modal.show();
            }

            // Confirm delete
            document.getElementById('confirmExamDeleteBtn').addEventListener('click', function () {
                if (examToDelete) {
                    // You would need to implement this endpoint
                    fetch(`/teacher/exams/${examToDelete}`, {
                        method: 'DELETE'
                    })
                        .then(response => response.json())
                        .then(data => {
                            if (data.success) {
                                alert('Exam deleted successfully');
                                location.reload();
                            } else {
                                alert('Error deleting exam: ' + data.message);
                            }
                        })
                        .catch(error => {
                            console.error('Error:', error);
                            alert('Error deleting exam');
                        });

                    const modal = bootstrap.Modal.getInstance(document.getElementById('deleteExamModal'));
                    modal.hide();
                }
            });

            // Tab switching
            const examTabs = document.getElementById('examTabs');
            const urlParams = new URLSearchParams(window.location.search);
            const viewParam = urlParams.get('view');

            if (viewParam === 'upcoming') {
                const tab = new bootstrap.Tab(document.querySelector('#upcoming-tab'));
                tab.show();
            } else if (viewParam === 'recent') {
                const tab = new bootstrap.Tab(document.querySelector('#recent-tab'));
                tab.show();
            }

            // Search functionality
            document.getElementById('examSearch').addEventListener('input', function (e) {
                const searchTerm = e.target.value.toLowerCase();
                const rows = document.querySelectorAll('#all tbody tr');

                rows.forEach(row => {
                    const text = row.textContent.toLowerCase();
                    if (text.includes(searchTerm)) {
                        row.style.display = '';
                    } else {
                        row.style.display = 'none';
                    }
                });
            });
        </script>
</body>

</html>