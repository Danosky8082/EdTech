<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= title %> - EdTech
    </title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <style>
        body {
            background: #f0f2f5;
        }

        .card-shadow {
            box-shadow: 0 2px 12px rgba(0, 0, 0, 0.06);
            border: none;
            border-radius: 16px;
        }

        .card-header-custom {
            background: linear-gradient(135deg, #6a11cb 0%, #2575fc 100%);
            color: white;
            border-radius: 16px 16px 0 0;
            padding: 1rem 1.5rem;
        }

        .profile-img {
            width: 80px;
            height: 80px;
            border-radius: 50%;
            object-fit: cover;
            border: 3px solid white;
        }

        .question-preview {
            background: #f8f9fa;
            border-radius: 8px;
            padding: 1rem;
            max-height: 300px;
            overflow-y: auto;
        }

        .question-item {
            border-bottom: 1px solid #e9ecef;
            padding: 0.5rem 0;
        }

        .question-item:last-child {
            border-bottom: none;
        }

        .format-hint {
            background: #f1f3f5;
            border-radius: 6px;
            padding: 0.5rem 1rem;
            font-size: 0.9rem;
        }
    </style>
</head>

<body>
    <%- include('../partials/navbar') %>

        <div class="container mt-4">
            <%- include('../partials/alerts') %>

                <div class="row">
                    <!-- Sidebar -->
                    <div class="col-md-3">
                        <div class="card card-shadow text-center">
                            <div class="card-body">
                                <% if (avatarUrl) { %>
                                    <img src="<%= avatarUrl %>" class="profile-img mb-3"
                                        onerror="this.onerror=null; this.src='<%= fallbackAvatar %>'">
                                    <% } else { %>
                                        <img src="<%= fallbackAvatar %>" class="profile-img mb-3">
                                        <% } %>
                                            <h5>
                                                <%= teacher.user.firstName %>
                                                    <%= teacher.user.lastName %>
                                            </h5>
                                            <span class="badge bg-primary">Teacher</span>
                                            <hr>
                                            <a href="/teacher/class-works" class="btn btn-outline-primary w-100 mb-2"><i
                                                    class="fas fa-arrow-left me-1"></i> Back</a>
                                            <a href="/teacher/dashboard" class="btn btn-outline-secondary w-100"><i
                                                    class="fas fa-home me-1"></i> Dashboard</a>
                            </div>
                        </div>
                    </div>

                    <!-- Main Form -->
                    <div class="col-md-9">
                        <div class="card card-shadow">
                            <div class="card-header-custom">
                                <h4 class="mb-0"><i class="fas fa-plus-circle me-2"></i>Create New Class Work</h4>
                            </div>
                            <div class="card-body">
                                <form id="createClassWorkForm" novalidate>
                                    <!-- Hidden input for questions (filled by parser) -->
                                    <input type="hidden" id="questionsInput" name="questions" value="">

                                    <div class="row">
                                        <div class="col-md-6 mb-3">
                                            <label class="form-label fw-bold">Title *</label>
                                            <input type="text" class="form-control" id="title" name="title" required>
                                        </div>
                                        <div class="col-md-6 mb-3">
                                            <label class="form-label fw-bold">Class *</label>
                                            <select class="form-select" id="classId" name="classId" required>
                                                <option value="">Select class</option>
                                                <% classes.forEach(cls=> { %>
                                                    <option value="<%= cls.id %>">
                                                        <%= cls.name %> (Grade <%= cls.grade %>)
                                                    </option>
                                                    <% }) %>
                                            </select>
                                        </div>
                                    </div>

                                    <div class="row">
                                        <div class="col-md-6 mb-3">
                                            <label class="form-label fw-bold">Type</label>
                                            <select class="form-select" id="type" name="type">
                                                <option value="assignment">Assignment</option>
                                                <option value="quiz">Quiz</option>
                                                <option value="project">Project</option>
                                                <option value="homework">Homework</option>
                                            </select>
                                        </div>
                                        <div class="col-md-6 mb-3">
                                            <label class="form-label fw-bold">Points</label>
                                            <input type="number" class="form-control" id="points" name="points"
                                                value="100" min="1">
                                        </div>
                                    </div>

                                    <div class="mb-3">
                                        <label class="form-label fw-bold">Description</label>
                                        <textarea class="form-control" id="description" name="description"
                                            rows="2"></textarea>
                                    </div>

                                    <div class="mb-3">
                                        <label class="form-label fw-bold">Due Date (optional)</label>
                                        <input type="datetime-local" class="form-control" id="dueDate" name="dueDate">
                                    </div>

                                    <!-- ========== QUESTIONS SECTION ========== -->
                                    <hr>
                                    <h5><i class="fas fa-question-circle me-2"></i>Questions</h5>
                                    <p class="text-muted small">Paste your questions below in the simple format, then
                                        click <strong>Parse Questions</strong>.</p>

                                    <div class="format-hint mb-3">
                                        <strong>Example format:</strong>
                                        <pre class="mb-0 mt-1" style="font-size:0.85rem;">Q: What is the capital of France?
Type: multiple_choice
A: London
B: Paris
C: Berlin
D: Madrid
Answer: B
Points: 2

Q: Explain photosynthesis.
Type: descriptive
Points: 5</pre>
                                    </div>

                                    <!-- Textarea for pasting questions -->
                                    <div class="mb-3">
                                        <label class="form-label fw-bold">Paste your questions here</label>
                                        <textarea class="form-control" id="questionsTextarea" rows="8"
                                            placeholder="Paste questions in the format shown above..."></textarea>
                                    </div>

                                    <div class="row g-2 mb-3">
                                        <div class="col-md-8">
                                            <label class="form-label fw-bold">Or upload a .txt file</label>
                                            <input type="file" class="form-control" id="questionsFile" accept=".txt">
                                        </div>
                                        <div class="col-md-4 d-flex align-items-end">
                                            <button type="button" class="btn btn-primary w-100" id="parseBtn">
                                                <i class="fas fa-cog me-1"></i> Parse Questions
                                            </button>
                                        </div>
                                    </div>
                                    <div id="uploadStatus" class="small mb-2"></div>

                                    <!-- Preview of parsed questions -->
                                    <div id="previewSection" style="display: none;">
                                        <label class="fw-bold">Preview (<span id="previewCount">0</span>
                                            questions)</label>
                                        <div id="previewContainer" class="question-preview"></div>
                                    </div>

                                    <div class="d-flex justify-content-between mt-4">
                                        <a href="/teacher/class-works" class="btn btn-secondary">Cancel</a>
                                        <button type="submit" class="btn btn-primary btn-lg">
                                            <i class="fas fa-save me-1"></i> Create Class Work
                                        </button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
        </div>

        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
        <script>
            document.addEventListener('DOMContentLoaded', function () {
                const form = document.getElementById('createClassWorkForm');
                const questionsInput = document.getElementById('questionsInput');
                const questionsTextarea = document.getElementById('questionsTextarea');
                const previewSection = document.getElementById('previewSection');
                const previewContainer = document.getElementById('previewContainer');
                const previewCount = document.getElementById('previewCount');
                const uploadStatus = document.getElementById('uploadStatus');
                const parseBtn = document.getElementById('parseBtn');
                const fileInput = document.getElementById('questionsFile');

                // ---------- Parse function ----------
                async function parseQuestions(text) {
                    try {
                        const res = await fetch('/teacher/class-works/parse-questions', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ text })
                        });
                        const data = await res.json();
                        return data;
                    } catch (err) {
                        console.error(err);
                        return { success: false, message: 'Network error' };
                    }
                }

                // ---------- Render preview ----------
                function renderPreview(questions) {
                    if (!Array.isArray(questions) || questions.length === 0) {
                        previewSection.style.display = 'none';
                        return;
                    }
                    previewSection.style.display = 'block';
                    previewCount.textContent = questions.length;
                    previewContainer.innerHTML = questions.map((q, i) => `
          <div class="question-item">
            <strong>Q${i + 1}:</strong> ${q.question}
            <span class="badge bg-secondary float-end">${q.points || 1} pts</span>
            <br><small class="text-muted">Type: ${q.type || 'unknown'}</small>
            ${q.type === 'multiple_choice' && q.options && q.options.length ? `<br><small>Options: ${q.options.join(', ')}</small>` : ''}
            ${q.correctAnswer ? `<br><small><span class="text-success">Correct: ${q.correctAnswer}</span></small>` : ''}
          </div>
        `).join('');
                }

                // ---------- Parse button ----------
                parseBtn.addEventListener('click', async function () {
                    let text = questionsTextarea.value.trim();

                    // If textarea is empty, try reading file
                    if (!text && fileInput.files.length) {
                        const reader = new FileReader();
                        const fileContent = await new Promise((resolve, reject) => {
                            reader.onload = e => resolve(e.target.result);
                            reader.onerror = e => reject(e);
                            reader.readAsText(fileInput.files[0]);
                        });
                        text = fileContent;
                    }

                    if (!text) {
                        alert('Please paste questions in the textarea or upload a .txt file.');
                        return;
                    }

                    uploadStatus.innerHTML = '<span class="text-info"><i class="fas fa-spinner fa-spin"></i> Parsing...</span>';

                    const result = await parseQuestions(text);
                    if (result.success) {
                        const questions = result.questions;
                        // Store JSON in hidden input
                        questionsInput.value = JSON.stringify(questions);
                        renderPreview(questions);
                        uploadStatus.innerHTML = `<span class="text-success">✅ ${questions.length} questions parsed. You can now submit.</span>`;
                    } else {
                        uploadStatus.innerHTML = `<span class="text-danger">❌ ${result.message}</span>`;
                        alert('Error: ' + result.message);
                    }
                });

                // ---------- Form submission ----------
                form.addEventListener('submit', async function (e) {
                    e.preventDefault();

                    // Ensure the hidden input has the parsed questions
                    if (!questionsInput.value) {
                        alert('Please parse your questions first by clicking "Parse Questions".');
                        return;
                    }

                    // Validate that questions are valid JSON
                    try {
                        const parsed = JSON.parse(questionsInput.value);
                        if (!Array.isArray(parsed) || parsed.length === 0) {
                            alert('No valid questions found. Please check your format.');
                            return;
                        }
                    } catch (e) {
                        alert('Invalid questions format. Please re‑parse.');
                        return;
                    }

                    const formData = new FormData(this);
                    const data = Object.fromEntries(formData.entries());

                    // The hidden input already contains the JSON string
                    console.log('📤 Submitting:', data);

                    try {
                        const res = await fetch('/teacher/class-works', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify(data)
                        });
                        const result = await res.json();
                        if (result.success) {
                            alert('✅ Class work created successfully!');
                            window.location.href = '/teacher/class-works';
                        } else {
                            alert('❌ ' + result.message);
                        }
                    } catch (err) {
                        alert('Network error: ' + err.message);
                    }
                });
            });
        </script>
</body>

</html>