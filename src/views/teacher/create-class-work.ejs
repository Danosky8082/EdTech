<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= title %> - EdTech
    </title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <style>
        body {
            background: #f0f2f5;
        }

        .card-shadow {
            box-shadow: 0 2px 12px rgba(0, 0, 0, 0.06);
            border: none;
            border-radius: 16px;
        }

        .card-header-custom {
            background: linear-gradient(135deg, #6a11cb 0%, #2575fc 100%);
            color: white;
            border-radius: 16px 16px 0 0;
            padding: 1rem 1.5rem;
        }

        .profile-img {
            width: 80px;
            height: 80px;
            border-radius: 50%;
            object-fit: cover;
            border: 3px solid white;
        }

        .question-preview {
            background: #f8f9fa;
            border-radius: 8px;
            padding: 1rem;
            max-height: 300px;
            overflow-y: auto;
        }

        .question-item {
            border-bottom: 1px solid #e9ecef;
            padding: 0.5rem 0;
        }

        .question-item:last-child {
            border-bottom: none;
        }
    </style>
</head>

<body>
    <%- include('../partials/navbar') %>

        <div class="container mt-4">
            <%- include('../partials/alerts') %>

                <div class="row">
                    <!-- Sidebar -->
                    <div class="col-md-3">
                        <div class="card card-shadow text-center">
                            <div class="card-body">
                                <% if (avatarUrl) { %>
                                    <img src="<%= avatarUrl %>" class="profile-img mb-3"
                                        onerror="this.onerror=null; this.src='<%= fallbackAvatar %>'">
                                    <% } else { %>
                                        <img src="<%= fallbackAvatar %>" class="profile-img mb-3">
                                        <% } %>
                                            <h5>
                                                <%= teacher.user.firstName %>
                                                    <%= teacher.user.lastName %>
                                            </h5>
                                            <span class="badge bg-primary">Teacher</span>
                                            <hr>
                                            <a href="/teacher/class-works" class="btn btn-outline-primary w-100 mb-2"><i
                                                    class="fas fa-arrow-left me-1"></i> Back</a>
                                            <a href="/teacher/dashboard" class="btn btn-outline-secondary w-100"><i
                                                    class="fas fa-home me-1"></i> Dashboard</a>
                            </div>
                        </div>
                    </div>

                    <!-- Main Form -->
                    <div class="col-md-9">
                        <div class="card card-shadow">
                            <div class="card-header-custom">
                                <h4 class="mb-0"><i class="fas fa-plus-circle me-2"></i>Create New Class Work</h4>
                            </div>
                            <div class="card-body">
                                <form id="createClassWorkForm" novalidate>
                                    <!-- Hidden input for questions (always sent) -->
                                    <input type="hidden" id="questionsInput" name="questions" value="">

                                    <div class="row">
                                        <div class="col-md-6 mb-3">
                                            <label class="form-label fw-bold">Title *</label>
                                            <input type="text" class="form-control" id="title" name="title" required>
                                        </div>
                                        <div class="col-md-6 mb-3">
                                            <label class="form-label fw-bold">Class *</label>
                                            <select class="form-select" id="classId" name="classId" required>
                                                <option value="">Select class</option>
                                                <% classes.forEach(cls=> { %>
                                                    <option value="<%= cls.id %>">
                                                        <%= cls.name %> (Grade <%= cls.grade %>)
                                                    </option>
                                                    <% }) %>
                                            </select>
                                        </div>
                                    </div>

                                    <div class="row">
                                        <div class="col-md-6 mb-3">
                                            <label class="form-label fw-bold">Type</label>
                                            <select class="form-select" id="type" name="type">
                                                <option value="assignment">Assignment</option>
                                                <option value="quiz">Quiz</option>
                                                <option value="project">Project</option>
                                                <option value="homework">Homework</option>
                                            </select>
                                        </div>
                                        <div class="col-md-6 mb-3">
                                            <label class="form-label fw-bold">Points</label>
                                            <input type="number" class="form-control" id="points" name="points"
                                                value="100" min="1">
                                        </div>
                                    </div>

                                    <div class="mb-3">
                                        <label class="form-label fw-bold">Description</label>
                                        <textarea class="form-control" id="description" name="description"
                                            rows="2"></textarea>
                                    </div>

                                    <div class="mb-3">
                                        <label class="form-label fw-bold">Due Date (optional)</label>
                                        <input type="datetime-local" class="form-control" id="dueDate" name="dueDate">
                                    </div>

                                    <!-- ========== QUESTIONS SECTION ========== -->
                                    <hr>
                                    <h5><i class="fas fa-question-circle me-2"></i>Questions</h5>
                                    <p class="text-muted small">You can upload a .txt/.docx file, or paste JSON directly
                                        below.</p>

                                    <!-- File upload -->
                                    <div class="row g-2 mb-3">
                                        <div class="col-md-8">
                                            <input type="file" class="form-control" id="questionsFile"
                                                accept=".txt,.docx,.doc">
                                        </div>
                                        <div class="col-md-4">
                                            <button type="button" class="btn btn-primary w-100" id="parseBtn">
                                                <i class="fas fa-upload me-1"></i> Parse & Load
                                            </button>
                                        </div>
                                    </div>
                                    <div id="uploadStatus" class="small mb-2"></div>

                                    <!-- Textarea for manual JSON (pre-filled by file upload) -->
                                    <div class="mb-3">
                                        <label class="form-label fw-bold">Questions JSON</label>
                                        <textarea class="form-control" id="questionsTextarea" rows="5"
                                            placeholder='[{"question":"What is 2+2?","type":"multiple_choice","options":["3","4","5"],"correctAnswer":"4","points":1}]'></textarea>
                                        <div class="form-text">Paste valid JSON array of question objects, or use the
                                            file upload to generate it.</div>
                                    </div>

                                    <!-- Preview of parsed questions -->
                                    <div id="previewSection" style="display: none;">
                                        <label class="fw-bold">Preview</label>
                                        <div id="previewContainer" class="question-preview"></div>
                                    </div>

                                    <div class="d-flex justify-content-between mt-4">
                                        <a href="/teacher/class-works" class="btn btn-secondary">Cancel</a>
                                        <button type="submit" class="btn btn-primary btn-lg">
                                            <i class="fas fa-save me-1"></i> Create Class Work
                                        </button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
        </div>

        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
        <script>
            document.addEventListener('DOMContentLoaded', function () {
                const form = document.getElementById('createClassWorkForm');
                const questionsInput = document.getElementById('questionsInput');
                const questionsTextarea = document.getElementById('questionsTextarea');
                const previewSection = document.getElementById('previewSection');
                const previewContainer = document.getElementById('previewContainer');
                const uploadStatus = document.getElementById('uploadStatus');
                const parseBtn = document.getElementById('parseBtn');

                // ---------- Parse file and populate textarea ----------
                parseBtn.addEventListener('click', async function () {
                    const fileInput = document.getElementById('questionsFile');
                    if (!fileInput.files.length) {
                        alert('Please select a file first.');
                        return;
                    }

                    const formData = new FormData();
                    formData.append('questionsFile', fileInput.files[0]);

                    uploadStatus.innerHTML = '<span class="text-info"><i class="fas fa-spinner fa-spin"></i> Parsing...</span>';

                    try {
                        const res = await fetch('/teacher/class-works/parse-questions', {
                            method: 'POST',
                            body: formData
                        });
                        const data = await res.json();

                        if (data.success) {
                            const json = JSON.stringify(data.questions, null, 2);
                            questionsTextarea.value = json;
                            // Also store in hidden input
                            questionsInput.value = json;
                            // Show preview
                            renderPreview(data.questions);
                            uploadStatus.innerHTML = `<span class="text-success">✅ ${data.questions.length} questions loaded. You can edit JSON below if needed.</span>`;
                        } else {
                            uploadStatus.innerHTML = `<span class="text-danger">❌ ${data.message}</span>`;
                            alert('Error: ' + data.message);
                        }
                    } catch (err) {
                        console.error(err);
                        uploadStatus.innerHTML = '<span class="text-danger">❌ Network error</span>';
                        alert('Network error while parsing file.');
                    }
                });

                // ---------- Render preview ----------
                function renderPreview(questions) {
                    if (!Array.isArray(questions) || questions.length === 0) {
                        previewSection.style.display = 'none';
                        return;
                    }
                    previewSection.style.display = 'block';
                    previewContainer.innerHTML = questions.map((q, i) => `
                    <div class="question-item">
                        <strong>Q${i + 1}:</strong> ${q.question} 
                        <span class="badge bg-secondary float-end">${q.points || 1} pts</span>
                        <br><small class="text-muted">Type: ${q.type || 'unknown'}</small>
                        ${q.type === 'multiple_choice' && q.options ? `<br><small>Options: ${q.options.map(o => o.text || o).join(', ')}</small>` : ''}
                    </div>
                `).join('');
                }

                // ---------- Live preview when textarea changes ----------
                questionsTextarea.addEventListener('input', function () {
                    try {
                        const parsed = JSON.parse(this.value);
                        if (Array.isArray(parsed) && parsed.length > 0) {
                            renderPreview(parsed);
                            questionsInput.value = this.value;
                        } else {
                            previewSection.style.display = 'none';
                        }
                    } catch (e) {
                        previewSection.style.display = 'none';
                    }
                });

                // ---------- Form submission ----------
                form.addEventListener('submit', async function (e) {
                    e.preventDefault();

                    // Ensure the hidden input has the current textarea content
                    questionsInput.value = questionsTextarea.value;

                    const formData = new FormData(this);
                    const data = Object.fromEntries(formData.entries());

                    // Validate questions JSON
                    if (data.questions) {
                        try {
                            const parsed = JSON.parse(data.questions);
                            if (!Array.isArray(parsed)) {
                                alert('Questions must be a JSON array.');
                                return;
                            }
                        } catch (e) {
                            alert('Invalid JSON in questions field. Please fix it.');
                            return;
                        }
                    }

                    console.log('📤 Submitting:', data);

                    try {
                        const res = await fetch('/teacher/class-works', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify(data)
                        });
                        const result = await res.json();
                        if (result.success) {
                            alert('✅ Class work created successfully!');
                            window.location.href = '/teacher/class-works';
                        } else {
                            alert('❌ ' + result.message);
                        }
                    } catch (err) {
                        alert('Network error: ' + err.message);
                    }
                });
            });
        </script>
</body>

</html>