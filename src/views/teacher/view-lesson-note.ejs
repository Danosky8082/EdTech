<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= title %> - EdTech
    </title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <style>
        .note-content {
            background: #f8f9fa;
            padding: 20px;
            border-radius: 8px;
            white-space: pre-wrap;
        }
    </style>
</head>

<body>
    <%- include('../partials/navbar') %>

        <div class="container mt-4">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2><i class="fas fa-sticky-note me-2"></i>
                    <%= lessonNote.title %>
                </h2>
                <div>
                    <a href="/teacher/lesson-notes/<%= lessonNote.id %>/edit" class="btn btn-warning">Edit</a>
                    <button class="btn btn-danger" onclick="deleteNote('<%= lessonNote.id %>')">Delete</button>
                    <a href="/teacher/lesson-notes" class="btn btn-secondary">Back</a>
                </div>
            </div>

            <div class="row">
                <div class="col-md-8">
                    <div class="note-content">
                        <%= lessonNote.content %>
                    </div>
                    <% if (lessonNote.tags && lessonNote.tags.length> 0) { %>
                        <div class="mt-3">
                            <strong>Tags:</strong>
                            <% lessonNote.tags.forEach(tag=> { %>
                                <span class="badge bg-secondary me-1">
                                    <%= tag %>
                                </span>
                                <% }); %>
                        </div>
                        <% } %>
                </div>
                <div class="col-md-4">
                    <div class="card">
                        <div class="card-header">Details</div>
                        <div class="card-body">
                            <p><strong>Created:</strong>
                                <%= new Date(lessonNote.createdAt).toLocaleString() %>
                            </p>
                            <p><strong>Updated:</strong>
                                <%= new Date(lessonNote.updatedAt).toLocaleString() %>
                            </p>
                            <p><strong>Class:</strong>
                                <%= lessonNote.class ? lessonNote.class.name : 'All' %>
                            </p>
                            <p><strong>Status:</strong>
                                <%= lessonNote.isPublic ? 'Public' : 'Private' %>
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <script>
            function deleteNote(id) {
                if (confirm('Are you sure you want to delete this lesson note?')) {
                    fetch(`/teacher/lesson-notes/${id}`, {
                        method: 'DELETE',
                        headers: { 'Content-Type': 'application/json' }
                    })
                        .then(res => res.json())
                        .then(data => {
                            if (data.success) {
                                window.location.href = '/teacher/lesson-notes';
                            } else {
                                alert('Error: ' + data.message);
                            }
                        })
                        .catch(err => {
                            console.error(err);
                            alert('Error deleting note');
                        });
                }
            }
        </script>
</body>

</html>