<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= title %> - EdTech
    </title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <style>
        .grading-card {
            border-left: 4px solid #ffc107;
            transition: all 0.3s ease;
        }

        .grading-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 6px 20px rgba(0, 0, 0, 0.1);
        }

        .submission-status {
            font-size: 0.75rem;
            padding: 4px 10px;
        }

        .status-pending {
            background-color: #ffc107;
            color: #000;
        }

        .status-graded {
            background-color: #198754;
            color: white;
        }

        .status-late {
            background-color: #dc3545;
            color: white;
        }

        .student-avatar {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            object-fit: cover;
        }

        .grade-input {
            max-width: 100px;
        }

        .submission-preview {
            max-height: 200px;
            overflow-y: auto;
        }
    </style>
</head>

<body>
    <%- include('../partials/navbar') %>

        <div class="container mt-4">
            <%- include('../partials/alerts') %>

                <div class="alert alert-info mb-4">
                    <i class="fas fa-school me-2"></i>
                    <strong>School:</strong>
                    <%= userSchool || 'All Schools' %>
                        <% if (isSuperAdmin) { %>
                            <span class="badge bg-warning ms-2">Super Admin</span>
                            <% } %>
                </div>

                <!-- ===== Helper for avatar URLs (safe EJS) ===== -->
                <% function cleanAvatar(avatar) { if (!avatar) return '/images/default-profile.png' ; if
                    (avatar.startsWith('/https:/')) return avatar.replace('/https:/', 'https://' ); if
                    (avatar.startsWith('/http:/')) return avatar.replace('/http:/', 'http://' ); if
                    (avatar.startsWith('http://') || avatar.startsWith('https://')) return avatar; return '/' + avatar;
                    } %>

                    <div class="row">
                        <!-- Left Sidebar -->
                        <div class="col-md-3">
                            <div class="profile-section text-center">
                                <%- include('../partials/user-avatar', { localClass: 'profile-img mb-3 avatar-img' }) %>
                                    <h4>
                                        <%= user.firstName %>
                                            <%= user.lastName %>
                                    </h4>
                                    <p class="welcome-text">Grading Center</p>
                                    <span class="user-role">Teacher</span>
                                    <div class="mt-2">
                                        <small><i class="fas fa-school me-1"></i>
                                            <%= userSchool %>
                                        </small>
                                    </div>
                            </div>

                            <div class="card dashboard-card mb-4">
                                <div class="card-header">
                                    <h5>Quick Actions</h5>
                                </div>
                                <div class="card-body">
                                    <a href="/teacher/grading" class="btn btn-outline-warning w-100 mb-2 action-btn"><i
                                            class="fas fa-graduation-cap"></i> Pending Grading</a>
                                    <a href="/teacher/assignments"
                                        class="btn btn-outline-primary w-100 mb-2 action-btn"><i
                                            class="fas fa-tasks"></i> Assignments</a>
                                    <a href="/teacher/exams" class="btn btn-outline-danger w-100 mb-2 action-btn"><i
                                            class="fas fa-clipboard-list"></i> Exams</a>
                                    <a href="/teacher/class-works" class="btn btn-outline-info w-100 mb-2 action-btn"><i
                                            class="fas fa-tasks"></i> Class Works</a>
                                    <a href="/teacher/dashboard"
                                        class="btn btn-outline-secondary w-100 mb-2 action-btn"><i
                                            class="fas fa-home"></i> Dashboard</a>
                                </div>
                            </div>

                            <div class="card dashboard-card mb-4">
                                <div class="card-header">
                                    <h5>Grading Statistics</h5>
                                </div>
                                <div class="card-body">
                                    <% var pendingCount=0; var gradedCount=0; if (submissions) { for (var i=0; i <
                                        submissions.length; i++) { if (submissions[i].grade===null) pendingCount++; else
                                        gradedCount++; } } %>
                                        <div><small>Total Submissions: <span class="float-end badge bg-primary">
                                                    <%= submissions ? submissions.length : 0 %>
                                                </span></small></div>
                                        <div><small>Pending Grading: <span class="float-end badge bg-warning">
                                                    <%= pendingCount %>
                                                </span></small></div>
                                        <div><small>Graded: <span class="float-end badge bg-success">
                                                    <%= gradedCount %>
                                                </span></small></div>
                                        <% if (submissions && submissions.length> 0) { var pct = Math.round(gradedCount
                                            / submissions.length * 100); %>
                                            <div class="mt-2">
                                                <small>Grading Progress</small>
                                                <div class="progress" style="height:6px;">
                                                    <div class="progress-bar bg-success" style="width: <%= pct %>%">
                                                    </div>
                                                </div>
                                                <small class="text-muted">
                                                    <%= pct %>% complete
                                                </small>
                                            </div>
                                            <% } %>
                                </div>
                            </div>
                        </div>

                        <!-- Main Content -->
                        <div class="col-md-9">
                            <div class="d-flex justify-content-between align-items-center mb-4">
                                <h2><i class="fas fa-graduation-cap me-2"></i>
                                    <%= title %>
                                </h2>
                                <div>
                                    <span class="badge bg-warning me-2"><i class="fas fa-clock me-1"></i>
                                        <%= pendingCount %> pending
                                    </span>
                                    <a href="/teacher/assignments" class="btn btn-outline-primary"><i
                                            class="fas fa-tasks me-1"></i> View Assignments</a>
                                </div>
                            </div>

                            <!-- Tabs -->
                            <ul class="nav nav-tabs mb-4" id="gradingTabs" role="tablist">
                                <li class="nav-item"><button class="nav-link active" id="pending-tab"
                                        data-bs-toggle="tab" data-bs-target="#pending" type="button">Pending (<%=
                                            pendingCount %>)</button></li>
                                <li class="nav-item"><button class="nav-link" id="graded-tab" data-bs-toggle="tab"
                                        data-bs-target="#graded" type="button">Graded (<%= gradedCount %>)</button></li>
                            </ul>

                            <div class="tab-content" id="gradingTabContent">
                                <!-- Pending -->
                                <div class="tab-pane fade show active" id="pending" role="tabpanel">
                                    <% if (submissions && submissions.length> 0) {
                                        var pendingSubmissions = submissions.filter(function(s) { return s.grade ===
                                        null; });
                                        if (pendingSubmissions.length > 0) {
                                        for (var i = 0; i < pendingSubmissions.length; i++) { var
                                            sub=pendingSubmissions[i]; var isLate=new Date(sub.submittedAt)> new
                                            Date(sub.assignment.dueDate);
                                            var avatarUrl = cleanAvatar(sub.student.user.avatar);
                                            %>
                                            <div class="card grading-card mb-3">
                                                <div class="card-body">
                                                    <div class="row">
                                                        <div class="col-md-8">
                                                            <div class="d-flex align-items-center mb-3">
                                                                <img src="<%= avatarUrl %>" class="student-avatar me-3"
                                                                    onerror="this.onerror=null; this.src='/images/default-profile.png'">
                                                                <div>
                                                                    <h6 class="mb-0">
                                                                        <%= sub.student.user.firstName %>
                                                                            <%= sub.student.user.lastName %>
                                                                    </h6>
                                                                    <small class="text-muted">ID: <%=
                                                                            sub.student.user.idNumber %>
                                                                            <% if (sub.assignment.class) { %> | Class:
                                                                                <%= sub.assignment.class.name %>
                                                                                    <% } %></small>
                                                                </div>
                                                            </div>
                                                            <h5 class="mb-2">
                                                                <%= sub.assignment.title %>
                                                                    <% if (isLate) { %> <span
                                                                            class="badge status-late submission-status ms-2">Late</span>
                                                                        <% } %>
                                                            </h5>
                                                            <% if (sub.assignment.description) { %>
                                                                <p class="text-muted small mb-3">
                                                                    <%= sub.assignment.description.length> 150 ?
                                                                        sub.assignment.description.substring(0,150) +
                                                                        '...' : sub.assignment.description %>
                                                                </p>
                                                                <% } %>
                                                                    <div class="row">
                                                                        <div class="col-md-6">
                                                                            <small class="text-muted d-block"><i
                                                                                    class="fas fa-calendar me-1"></i>
                                                                                Submitted: <%= new
                                                                                    Date(sub.submittedAt).toLocaleString()
                                                                                    %></small>
                                                                            <small class="text-muted d-block"><i
                                                                                    class="fas fa-clock me-1"></i> Due:
                                                                                <%= new
                                                                                    Date(sub.assignment.dueDate).toLocaleString()
                                                                                    %></small>
                                                                        </div>
                                                                        <div class="col-md-6">
                                                                            <small class="text-muted d-block"><i
                                                                                    class="fas fa-file me-1"></i>
                                                                                Points: <%= sub.assignment.points || 100
                                                                                    %></small>
                                                                            <% if (sub.answerText) { %>
                                                                                <button
                                                                                    class="btn btn-sm btn-outline-info mt-2"
                                                                                    type="button"
                                                                                    data-bs-toggle="collapse"
                                                                                    data-bs-target="#submissionText<%= sub.id %>">View
                                                                                    Submission Text</button>
                                                                                <% } %>
                                                                        </div>
                                                                    </div>
                                                                    <% if (sub.answerText) { %>
                                                                        <div class="collapse mt-3"
                                                                            id="submissionText<%= sub.id %>">
                                                                            <div
                                                                                class="card card-body submission-preview">
                                                                                <%= sub.answerText %>
                                                                            </div>
                                                                        </div>
                                                                        <% } %>
                                                                            <% if (sub.fileUrl) { %>
                                                                                <div class="mt-3">
                                                                                    <small
                                                                                        class="text-muted d-block mb-1"><i
                                                                                            class="fas fa-paperclip me-1"></i>
                                                                                        Attached Files:</small>
                                                                                    <a href="<%= sub.fileUrl %>"
                                                                                        class="btn btn-sm btn-outline-primary"
                                                                                        target="_blank"><i
                                                                                            class="fas fa-download me-1"></i>
                                                                                        Download File</a>
                                                                                </div>
                                                                                <% } %>
                                                        </div>
                                                        <div class="col-md-4">
                                                            <div class="card">
                                                                <div class="card-body">
                                                                    <h6 class="card-title">Grade Submission</h6>
                                                                    <form class="grade-form"
                                                                        data-submission-id="<%= sub.id %>">
                                                                        <div class="mb-3">
                                                                            <label class="form-label">Score (out of <%=
                                                                                    sub.assignment.points || 100 %>
                                                                                    )</label>
                                                                            <div class="input-group">
                                                                                <input type="number"
                                                                                    class="form-control grade-input"
                                                                                    name="score" min="0"
                                                                                    max="<%= sub.assignment.points || 100 %>"
                                                                                    step="0.1" required>
                                                                                <span class="input-group-text">/ <%=
                                                                                        sub.assignment.points || 100 %>
                                                                                        </span>
                                                                            </div>
                                                                        </div>
                                                                        <div class="mb-3">
                                                                            <label class="form-label">Feedback
                                                                                (Optional)</label>
                                                                            <textarea class="form-control"
                                                                                name="feedback" rows="3"
                                                                                placeholder="Provide feedback..."></textarea>
                                                                        </div>
                                                                        <div class="d-grid">
                                                                            <button type="submit"
                                                                                class="btn btn-success"><i
                                                                                    class="fas fa-check me-1"></i>
                                                                                Submit Grade</button>
                                                                        </div>
                                                                    </form>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                            <% } } else { %>
                                                <div class="card">
                                                    <div class="card-body text-center py-5"><i
                                                            class="fas fa-check-circle fa-3x text-success mb-3"></i>
                                                        <h4>All Caught Up!</h4>
                                                        <p class="text-muted">You have no pending submissions to grade.
                                                        </p><a href="/teacher/assignments" class="btn btn-primary"><i
                                                                class="fas fa-tasks me-1"></i> View Assignments</a>
                                                    </div>
                                                </div>
                                                <% } } else { %>
                                                    <div class="card">
                                                        <div class="card-body text-center py-5"><i
                                                                class="fas fa-graduation-cap fa-3x text-muted mb-3"></i>
                                                            <h4>No Submissions Yet</h4>
                                                            <p class="text-muted">You don't have any submissions to
                                                                grade.</p><a href="/teacher/assignments"
                                                                class="btn btn-primary"><i
                                                                    class="fas fa-tasks me-1"></i> Create Assignment</a>
                                                        </div>
                                                    </div>
                                                    <% } %>
                                </div>

                                <!-- Graded -->
                                <div class="tab-pane fade" id="graded" role="tabpanel">
                                    <% if (submissions && submissions.length> 0) {
                                        var gradedSubmissions = submissions.filter(function(s) { return s.grade !==
                                        null; });
                                        if (gradedSubmissions.length > 0) { %>
                                        <div class="table-responsive">
                                            <table class="table table-hover">
                                                <thead>
                                                    <tr>
                                                        <th>Student</th>
                                                        <th>Assignment</th>
                                                        <th>Class</th>
                                                        <th>Score</th>
                                                        <th>Graded On</th>
                                                        <th>Actions</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    <% for (var i=0; i < gradedSubmissions.length; i++) { var
                                                        sub=gradedSubmissions[i]; var pct=((sub.score || 0) /
                                                        (sub.assignment.points || 100) * 100).toFixed(1); var
                                                        avatarUrl=cleanAvatar(sub.student.user.avatar); %>
                                                        <tr>
                                                            <td>
                                                                <div class="d-flex align-items-center">
                                                                    <img src="<%= avatarUrl %>"
                                                                        class="student-avatar me-2"
                                                                        onerror="this.onerror=null; this.src='/images/default-profile.png'">
                                                                    <div>
                                                                        <strong>
                                                                            <%= sub.student.user.firstName %>
                                                                                <%= sub.student.user.lastName %>
                                                                        </strong><br>
                                                                        <small class="text-muted">
                                                                            <%= sub.student.user.idNumber %>
                                                                        </small>
                                                                    </div>
                                                                </div>
                                                            </td>
                                                            <td><strong>
                                                                    <%= sub.assignment.title %>
                                                                </strong><br><small class="text-muted">Due: <%= new
                                                                        Date(sub.assignment.dueDate).toLocaleDateString()
                                                                        %></small></td>
                                                            <td>
                                                                <% if (sub.assignment.class) { %>
                                                                    <%= sub.assignment.class.name %>
                                                                        <% } else { %><span
                                                                                class="text-muted">N/A</span>
                                                                            <% } %>
                                                            </td>
                                                            <td>
                                                                <strong>
                                                                    <%= sub.score %> / <%= sub.assignment.points || 100
                                                                            %>
                                                                </strong>
                                                                <div class="progress" style="height:5px; width:80px;">
                                                                    <div class="progress-bar <%= pct >= 80 ? 'bg-success' : pct >= 60 ? 'bg-warning' : 'bg-danger' %>"
                                                                        style="width: <%= pct %>%"></div>
                                                                </div>
                                                                <small class="text-muted">
                                                                    <%= pct %>%
                                                                </small>
                                                            </td>
                                                            <td>
                                                                <%= new Date(sub.gradedAt).toLocaleDateString() %>
                                                                    <br><small>
                                                                        <%= new
                                                                            Date(sub.gradedAt).toLocaleTimeString([],
                                                                            {hour:'2-digit', minute:'2-digit'}) %>
                                                                    </small>
                                                            </td>
                                                            <td>
                                                                <div class="btn-group btn-group-sm">
                                                                    <a href="/teacher/grading/<%= sub.id %>"
                                                                        class="btn btn-outline-primary"><i
                                                                            class="fas fa-eye"></i></a>
                                                                    <button class="btn btn-outline-warning"
                                                                        onclick="regradeSubmission('<%= sub.id %>')"><i
                                                                            class="fas fa-edit"></i></button>
                                                                </div>
                                                            </td>
                                                        </tr>
                                                        <% } %>
                                                </tbody>
                                            </table>
                                        </div>
                                        <% } else { %>
                                            <div class="card">
                                                <div class="card-body text-center py-5"><i
                                                        class="fas fa-clipboard-check fa-3x text-muted mb-3"></i>
                                                    <h4>No Graded Submissions</h4>
                                                    <p class="text-muted">You haven't graded any submissions yet.</p><a
                                                        href="#pending" class="btn btn-primary" data-bs-toggle="tab"><i
                                                            class="fas fa-graduation-cap me-1"></i> Start Grading</a>
                                                </div>
                                            </div>
                                            <% } } %>
                                </div>
                            </div>
                        </div>
                    </div>
        </div>

        <!-- Regrade Modal -->
        <div class="modal fade" id="regradeModal" tabindex="-1">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Update Grade</h5><button type="button" class="btn-close"
                            data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body" id="regradeModalBody"></div>
                </div>
            </div>
        </div>

        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
        <script>
            // Grade submission
            document.querySelectorAll('.grade-form').forEach(form => {
                form.addEventListener('submit', function (e) {
                    e.preventDefault();
                    const submissionId = this.getAttribute('data-submission-id');
                    const formData = new FormData(this);
                    const score = parseFloat(formData.get('score'));
                    const feedback = formData.get('feedback');

                    fetch(`/teacher/grading/${submissionId}`, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ score, feedback })
                    })
                        .then(response => response.text())
                        .then(text => {
                            if (text.includes('<!DOCTYPE html>')) {
                                alert('Grade submitted successfully!');
                                location.reload();
                            } else {
                                try {
                                    const data = JSON.parse(text);
                                    if (data.success) {
                                        alert('Grade submitted successfully!');
                                        location.reload();
                                    } else {
                                        alert('Error: ' + (data.message || 'Unknown error'));
                                    }
                                } catch (e) {
                                    alert('Grade submitted successfully!');
                                    location.reload();
                                }
                            }
                        })
                        .catch(error => {
                            console.error('Error:', error);
                            alert('Error submitting grade: ' + error.message);
                        });
                });
            });

            // Regrade
            function regradeSubmission(submissionId) {
                fetch(`/teacher/api/grading/${submissionId}/details`)
                    .then(response => response.json())
                    .then(data => {
                        if (data.success) {
                            const modalBody = document.getElementById('regradeModalBody');
                            modalBody.innerHTML = `
                            <form id="regradeForm" data-submission-id="${submissionId}">
                                <div class="mb-3">
                                    <label class="form-label">New Grade (out of ${data.submission.assignment.points || 100})</label>
                                    <div class="input-group">
                                        <input type="number" class="form-control" name="score" value="${data.submission.grade || 0}" min="0" max="${data.submission.assignment.points || 100}" step="0.1" required>
                                        <span class="input-group-text">/ ${data.submission.assignment.points || 100}</span>
                                    </div>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label">Feedback</label>
                                    <textarea class="form-control" name="feedback" rows="3">${data.submission.feedback || ''}</textarea>
                                </div>
                                <div class="d-grid">
                                    <button type="submit" class="btn btn-success"><i class="fas fa-check me-1"></i> Update Grade</button>
                                </div>
                            </form>
                        `;

                            document.getElementById('regradeForm').addEventListener('submit', function (e) {
                                e.preventDefault();
                                const formData = new FormData(this);
                                const updateData = {
                                    score: parseFloat(formData.get('score')),
                                    feedback: formData.get('feedback')
                                };
                                fetch(`/teacher/api/grading/${submissionId}/update`, {
                                    method: 'PUT',
                                    headers: { 'Content-Type': 'application/json' },
                                    body: JSON.stringify(updateData)
                                })
                                    .then(response => response.json())
                                    .then(result => {
                                        if (result.success) {
                                            alert('Grade updated successfully!');
                                            location.reload();
                                        } else {
                                            alert('Error: ' + result.message);
                                        }
                                    })
                                    .catch(error => {
                                        console.error('Error:', error);
                                        alert('Error updating grade: ' + error.message);
                                    });
                            });

                            new bootstrap.Modal(document.getElementById('regradeModal')).show();
                        } else {
                            alert('Error loading submission details: ' + data.message);
                        }
                    })
                    .catch(error => {
                        console.error('Error:', error);
                        alert('Error loading submission details: ' + error.message);
                    });
            }

            // Tab switching
            const urlParams = new URLSearchParams(window.location.search);
            if (urlParams.get('tab') === 'graded') {
                const tab = new bootstrap.Tab(document.querySelector('#graded-tab'));
                tab.show();
            }
        </script>
</body>

</html>