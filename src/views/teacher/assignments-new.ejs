<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= title %> - EdTech
    </title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
</head>

<body>
    <%- include('../partials/navbar') %>

        <div class="container mt-4">
            <%- include('../partials/alerts') %>

                <h2>
                    <%= title %>
                </h2>

                <!-- Active Assignments -->
                <h4>Active (<%= activeAssignments.length %>)</h4>
                <ul>
                    <% for (var i=0; i < activeAssignments.length; i++) { var a=activeAssignments[i]; %>
                        <li>
                            <%= a.title %> – Due: <%= new Date(a.dueDate).toLocaleDateString() %>
                        </li>
                        <% } %>
                </ul>

                <!-- Upcoming Assignments -->
                <h4>Upcoming (<%= upcomingAssignments.length %>)</h4>
                <ul>
                    <% for (var i=0; i < upcomingAssignments.length; i++) { var a=upcomingAssignments[i]; %>
                        <li>
                            <%= a.title %> – Due: <%= new Date(a.dueDate).toLocaleDateString() %>
                        </li>
                        <% } %>
                </ul>

                <!-- Completed Assignments -->
                <h4>Completed (<%= completedAssignments.length %>)</h4>
                <ul>
                    <% for (var i=0; i < completedAssignments.length; i++) { var a=completedAssignments[i]; %>
                        <li>
                            <%= a.title %> – Due: <%= new Date(a.dueDate).toLocaleDateString() %>
                        </li>
                        <% } %>
                </ul>

                <!-- Stats -->
                <p>Total: <%= totalAssignments %>
                </p>
                <p>Submissions: <%= totalSubmissions %>
                </p>
                <p>Pending Grading: <%= pendingGrading %>
                </p>
        </div>

        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>