<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= title %> - EdTech
    </title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <style>
        .submission-card {
            border-left: 4px solid #0d6efd;
        }

        .grade-card {
            border-left: 4px solid #198754;
        }

        .student-avatar {
            width: 80px;
            height: 80px;
            border-radius: 50%;
            object-fit: cover;
        }
    </style>
</head>

<body>
    <%- include('../partials/navbar') %>

        <div class="container mt-4">
            <%- include('../partials/alerts') %>

                <!-- Back Button -->
                <div class="mb-4">
                    <a href="/teacher/assignments/view/<%= submission.assignment.id %>"
                        class="btn btn-outline-secondary">
                        <i class="fas fa-arrow-left me-1"></i> Back to Assignment
                    </a>
                </div>

                <div class="row">
                    <!-- Left Column: Submission Details -->
                    <div class="col-lg-8">
                        <div class="card submission-card mb-4">
                            <div class="card-header">
                                <h4 class="mb-0">
                                    <i class="fas fa-file-alt me-2"></i>
                                    Submission Details
                                </h4>
                            </div>
                            <div class="card-body">
                                <!-- Student Info -->
                                <div class="d-flex align-items-center mb-4">
                                    <% if (submission.student.user.avatar) { %>
                                        <img src="<%= submission.student.user.avatar %>" class="student-avatar me-3"
                                            onerror="this.src='/images/default-profile.png'">
                                        <% } else { %>
                                            <img src="/images/default-profile.png" class="student-avatar me-3">
                                            <% } %>
                                                <div>
                                                    <h5 class="mb-1">
                                                        <%= submission.student.user.firstName %>
                                                            <%= submission.student.user.lastName %>
                                                    </h5>
                                                    <p class="text-muted mb-1">
                                                        ID: <%= submission.student.user.idNumber %>
                                                    </p>
                                                    <p class="mb-0">
                                                        <span class="badge bg-primary">
                                                            <%= submission.student.grade %>-<%=
                                                                    submission.student.section %>
                                                        </span>
                                                    </p>
                                                </div>
                                </div>

                                <!-- Assignment Info -->
                                <div class="mb-4">
                                    <h5>Assignment: <%= submission.assignment.title %>
                                    </h5>
                                    <div class="row">
                                        <div class="col-md-6">
                                            <p class="mb-1">
                                                <i class="fas fa-calendar me-2"></i>
                                                <strong>Due Date:</strong>
                                                <%= new Date(submission.assignment.dueDate).toLocaleString() %>
                                            </p>
                                        </div>
                                        <div class="col-md-6">
                                            <p class="mb-1">
                                                <i class="fas fa-star me-2"></i>
                                                <strong>Points:</strong>
                                                <%= submission.assignment.points || 100 %> points
                                            </p>
                                        </div>
                                    </div>
                                </div>

                                <!-- Submission Content -->
                                <div class="mb-4">
                                    <h5><i class="fas fa-paperclip me-2"></i>Submission</h5>
                                    <p class="text-muted mb-2">
                                        <i class="fas fa-clock me-1"></i>
                                        Submitted: <%= new Date(submission.submittedAt).toLocaleString() %>
                                            <% if (new Date(submission.submittedAt)> new
                                                Date(submission.assignment.dueDate)) { %>
                                                <span class="badge bg-danger ms-2">Late Submission</span>
                                                <% } %>
                                    </p>

                                    <% if (submission.content) { %>
                                        <div class="card bg-light">
                                            <div class="card-body">
                                                <h6>Text Submission:</h6>
                                                <p>
                                                    <%= submission.content %>
                                                </p>
                                            </div>
                                        </div>
                                        <% } %>

                                            <% if (submission.fileUrl) { %>
                                                <div class="mt-3">
                                                    <h6>Attached File:</h6>
                                                    <a href="<%= submission.fileUrl %>" class="btn btn-outline-primary"
                                                        target="_blank">
                                                        <i class="fas fa-download me-1"></i> Download File
                                                    </a>
                                                </div>
                                                <% } %>

                                                    <% if (!submission.content && !submission.fileUrl) { %>
                                                        <div class="alert alert-info">
                                                            <i class="fas fa-info-circle me-2"></i>
                                                            No submission content available.
                                                        </div>
                                                        <% } %>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Right Column: Grading -->
                    <div class="col-lg-4">
                        <div class="card grade-card mb-4">
                            <div class="card-header">
                                <h5 class="mb-0">
                                    <i class="fas fa-graduation-cap me-2"></i>
                                    Grading
                                </h5>
                            </div>
                            <div class="card-body">
                                <!-- Current Grade Status -->
                                <% const isGraded=submission.grade !==null; %>
                                    <% if (isGraded) { %>
                                        <div class="alert alert-success">
                                            <div class="d-flex justify-content-between align-items-center">
                                                <div>
                                                    <h6 class="mb-1">Grade Assigned</h6>
                                                    <h3 class="mb-0">
                                                        <%= submission.grade %> / <%= submission.assignment.points ||
                                                                100 %>
                                                    </h3>
                                                    <p class="mb-0 text-muted small">
                                                        <%= Math.round((submission.grade / (submission.assignment.points
                                                            || 100)) * 100) %>%
                                                    </p>
                                                </div>
                                                <i class="fas fa-check-circle fa-2x"></i>
                                            </div>
                                        </div>

                                        <% if (submission.feedback) { %>
                                            <div class="mt-3">
                                                <h6>Feedback:</h6>
                                                <div class="card bg-light">
                                                    <div class="card-body">
                                                        <%= submission.feedback %>
                                                    </div>
                                                </div>
                                            </div>
                                            <% } %>

                                                <div class="mt-4">
                                                    <button class="btn btn-warning w-100" data-bs-toggle="modal"
                                                        data-bs-target="#editGradeModal">
                                                        <i class="fas fa-edit me-1"></i> Edit Grade
                                                    </button>
                                                </div>

                                                <% } else { %>
                                                    <div class="alert alert-warning">
                                                        <div class="d-flex justify-content-between align-items-center">
                                                            <div>
                                                                <h6 class="mb-1">Pending Grade</h6>
                                                                <p class="mb-0">This submission hasn't been graded yet.
                                                                </p>
                                                            </div>
                                                            <i class="fas fa-clock fa-2x"></i>
                                                        </div>
                                                    </div>

                                                    <!-- Grade Form -->
                                                    <form id="gradeForm" action="/teacher/grading/<%= submission.id %>"
                                                        method="POST">
                                                        <div class="mb-3">
                                                            <label class="form-label">Score (0-<%=
                                                                    submission.assignment.points || 100 %>)</label>
                                                            <div class="input-group">
                                                                <input type="number" class="form-control" name="score"
                                                                    min="0"
                                                                    max="<%= submission.assignment.points || 100 %>"
                                                                    step="1" required>
                                                                <span class="input-group-text">
                                                                    / <%= submission.assignment.points || 100 %>
                                                                </span>
                                                            </div>
                                                        </div>

                                                        <div class="mb-3">
                                                            <label class="form-label">Feedback (Optional)</label>
                                                            <textarea class="form-control" name="feedback" rows="4"
                                                                placeholder="Provide feedback to the student..."></textarea>
                                                        </div>

                                                        <button type="submit" class="btn btn-success w-100">
                                                            <i class="fas fa-check me-1"></i> Submit Grade
                                                        </button>
                                                    </form>
                                                    <% } %>
                            </div>
                        </div>
                    </div>
                </div>
        </div>

        <!-- Edit Grade Modal (only shown if already graded) -->
        <% if (isGraded) { %>
            <div class="modal fade" id="editGradeModal" tabindex="-1">
                <div class="modal-dialog">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title">Edit Grade</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                        </div>
                        <div class="modal-body">
                            <form id="editGradeForm" action="/teacher/grading/<%= submission.id %>" method="POST">
                                <div class="mb-3">
                                    <label class="form-label">New Score (0-<%= submission.assignment.points || 100 %>
                                            )</label>
                                    <div class="input-group">
                                        <input type="number" class="form-control" name="score"
                                            value="<%= submission.grade %>" min="0"
                                            max="<%= submission.assignment.points || 100 %>" step="1" required>
                                        <span class="input-group-text">
                                            / <%= submission.assignment.points || 100 %>
                                        </span>
                                    </div>
                                </div>

                                <div class="mb-3">
                                    <label class="form-label">Feedback</label>
                                    <textarea class="form-control" name="feedback"
                                        rows="4"><%= submission.feedback || '' %></textarea>
                                </div>
                            </form>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                            <button type="submit" form="editGradeForm" class="btn btn-success">Update Grade</button>
                        </div>
                    </div>
                </div>
            </div>
            <% } %>

                <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
                <script>
                    // Handle grade form submission
                    document.getElementById('gradeForm')?.addEventListener('submit', function (e) {
                        const scoreInput = this.querySelector('input[name="score"]');
                        const maxScore = parseInt(scoreInput.getAttribute('max'));
                        const score = parseInt(scoreInput.value);

                        if (score < 0 || score > maxScore) {
                            e.preventDefault();
                            alert(`Score must be between 0 and ${maxScore}`);
                        }
                    });

                    // Handle edit grade form submission
                    document.getElementById('editGradeForm')?.addEventListener('submit', function (e) {
                        const scoreInput = this.querySelector('input[name="score"]');
                        const maxScore = parseInt(scoreInput.getAttribute('max'));
                        const score = parseInt(scoreInput.value);

                        if (score < 0 || score > maxScore) {
                            e.preventDefault();
                            alert(`Score must be between 0 and ${maxScore}`);
                        }
                    });
                </script>
</body>

</html>