<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= title %> - EdTech
    </title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <style>
        .submission-card {
            border-left: 4px solid #0d6efd;
        }

        .grade-card {
            border-left: 4px solid #198754;
        }

        .student-avatar {
            width: 80px;
            height: 80px;
            border-radius: 50%;
            object-fit: cover;
        }
    </style>
</head>

<body>
    <%- include('../partials/navbar') %>

        <div class="container mt-4">
            <%- include('../partials/alerts') %>

                <!-- Back Button -->
                <div class="mb-4">
                    <a href="/teacher/assignments/view/<%= submission.assignment.id %>"
                        class="btn btn-outline-secondary">
                        <i class="fas fa-arrow-left me-1"></i> Back to Assignment
                    </a>
                </div>

                <div class="row">
                    <!-- Left Column: Submission Details -->
                    <div class="col-lg-8">
                        <div class="card submission-card mb-4">
                            <div class="card-header">
                                <h4 class="mb-0">
                                    <i class="fas fa-file-alt me-2"></i>
                                    Submission Details
                                </h4>
                            </div>
                            <div class="card-body">
                                <!-- Student Info -->
                                <div class="d-flex align-items-center mb-4">
                                    <% if (submission.student.user.avatar) { %>
                                        <img src="<%= submission.student.user.avatar %>" class="student-avatar me-3"
                                            onerror="this.src='/images/default-profile.png'">
                                        <% } else { %>
                                            <img src="/images/default-profile.png" class="student-avatar me-3">
                                            <% } %>
                                                <div>
                                                    <h5 class="mb-1">
                                                        <%= submission.student.user.firstName %>
                                                            <%= submission.student.user.lastName %>
                                                    </h5>
                                                    <p class="text-muted mb-1">
                                                        ID: <%= submission.student.user.idNumber %>
                                                    </p>
                                                    <p class="mb-0">
                                                        <span class="badge bg-primary">
                                                            <%= submission.student.grade %>-<%=
                                                                    submission.student.section %>
                                                        </span>
                                                    </p>
                                                </div>
                                </div>

                                <!-- Assignment Info -->
                                <div class="mb-4">
                                    <h5>Assignment: <%= submission.assignment.title %>
                                    </h5>
                                    <div class="row">
                                        <div class="col-md-6">
                                            <p class="mb-1">
                                                <i class="fas fa-calendar me-2"></i>
                                                <strong>Due Date:</strong>
                                                <%= new Date(submission.assignment.dueDate).toLocaleString() %>
                                            </p>
                                        </div>
                                        <div class="col-md-6">
                                            <p class="mb-1">
                                                <i class="fas fa-star me-2"></i>
                                                <strong>Points:</strong>
                                                <%= submission.assignment.points || 100 %> points
                                            </p>
                                        </div>
                                    </div>
                                </div>

                                <!-- Submission Content -->
                                <div class="mb-4">
                                    <h5><i class="fas fa-paperclip me-2"></i>Submission</h5>
                                    <p class="text-muted mb-2">
                                        <i class="fas fa-clock me-1"></i>
                                        Submitted: <%= new Date(submission.submittedAt).toLocaleString() %>
                                            <% if (new Date(submission.submittedAt)> new
                                                Date(submission.assignment.dueDate)) { %>
                                                <span class="badge bg-danger ms-2">Late Submission</span>
                                                <% } %>
                                    </p>

                                    <% if (submission.content) { %>
                                        <div class="card bg-light">
                                            <div class="card-body">
                                                <h6>Text Submission:</h6>
                                                <p>
                                                    <%= submission.content %>
                                                </p>
                                            </div>
                                        </div>
                                        <% } %>

                                            <% if (submission.fileUrl) { %>
                                                <div class="mt-3">
                                                    <h6>Attached File:</h6>
                                                    <a href="<%= submission.fileUrl %>" class="btn btn-outline-primary"
                                                        target="_blank">
                                                        <i class="fas fa-download me-1"></i> Download File
                                                    </a>
                                                </div>
                                                <% } %>

                                                    <% if (!submission.content && !submission.fileUrl) { %>
                                                        <div class="alert alert-info">
                                                            <i class="fas fa-info-circle me-2"></i>
                                                            No submission content available.
                                                        </div>
                                                        <% } %>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Right Column: Grading -->
                    <div class="col-lg-4">
                        <div class="card grade-card mb-4">
                            <div class="card-header">
                                <h5 class="mb-0">
                                    <i class="fas fa-graduation-cap me-2"></i>
                                    Grading
                                </h5>
                            </div>
                            <div class="card-body">
                                <!-- Current Grade Status -->
                                <% const isGraded=submission.grade !==null; %>
                                    <% if (isGraded) { %>
                                        <div class="alert alert-success" id="gradeDisplay">
                                            <div class="d-flex justify-content-between align-items-center">
                                                <div>
                                                    <h6 class="mb-1">Grade Assigned</h6>
                                                    <h3 class="mb-0">
                                                        <%= submission.grade %> / <%= submission.assignment.points ||
                                                                100 %>
                                                    </h3>
                                                    <p class="mb-0 text-muted small">
                                                        <%= Math.round((submission.grade / (submission.assignment.points
                                                            || 100)) * 100) %>%
                                                    </p>
                                                </div>
                                                <i class="fas fa-check-circle fa-2x"></i>
                                            </div>
                                        </div>

                                        <% if (submission.feedback) { %>
                                            <div class="mt-3" id="feedbackDisplay">
                                                <h6>Feedback:</h6>
                                                <div class="card bg-light">
                                                    <div class="card-body">
                                                        <%= submission.feedback %>
                                                    </div>
                                                </div>
                                            </div>
                                            <% } %>

                                                <div class="mt-4">
                                                    <button class="btn btn-warning w-100" data-bs-toggle="modal"
                                                        data-bs-target="#editGradeModal">
                                                        <i class="fas fa-edit me-1"></i> Edit Grade
                                                    </button>
                                                </div>

                                                <% } else { %>
                                                    <div class="alert alert-warning">
                                                        <div class="d-flex justify-content-between align-items-center">
                                                            <div>
                                                                <h6 class="mb-1">Pending Grade</h6>
                                                                <p class="mb-0">This submission hasn't been graded yet.
                                                                </p>
                                                            </div>
                                                            <i class="fas fa-clock fa-2x"></i>
                                                        </div>
                                                    </div>

                                                    <!-- Grade Form (AJAX) -->
                                                    <form id="gradeForm" onsubmit="submitGrade(event, 'gradeForm')">
                                                        <div class="mb-3">
                                                            <label class="form-label">Score (0-<%=
                                                                    submission.assignment.points || 100 %>)</label>
                                                            <div class="input-group">
                                                                <input type="number" class="form-control"
                                                                    id="scoreInput" name="score" min="0"
                                                                    max="<%= submission.assignment.points || 100 %>"
                                                                    step="1" required>
                                                                <span class="input-group-text">/ <%=
                                                                        submission.assignment.points || 100 %></span>
                                                            </div>
                                                        </div>

                                                        <div class="mb-3">
                                                            <label class="form-label">Feedback (Optional)</label>
                                                            <textarea class="form-control" id="feedbackInput"
                                                                name="feedback" rows="4"
                                                                placeholder="Provide feedback to the student..."></textarea>
                                                        </div>

                                                        <button type="submit" class="btn btn-success w-100"
                                                            id="submitGradeBtn">
                                                            <i class="fas fa-check me-1"></i> Submit Grade
                                                        </button>
                                                    </form>
                                                    <% } %>
                            </div>
                        </div>
                    </div>
                </div>
        </div>

        <!-- Edit Grade Modal (only shown if already graded) -->
        <% if (isGraded) { %>
            <div class="modal fade" id="editGradeModal" tabindex="-1">
                <div class="modal-dialog">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title">Edit Grade</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                        </div>
                        <div class="modal-body">
                            <form id="editGradeForm" onsubmit="submitGrade(event, 'editGradeForm')">
                                <div class="mb-3">
                                    <label class="form-label">New Score (0-<%= submission.assignment.points || 100 %>
                                            )</label>
                                    <div class="input-group">
                                        <input type="number" class="form-control" id="editScoreInput" name="score"
                                            value="<%= submission.grade %>" min="0"
                                            max="<%= submission.assignment.points || 100 %>" step="1" required>
                                        <span class="input-group-text">/ <%= submission.assignment.points || 100 %>
                                                </span>
                                    </div>
                                </div>

                                <div class="mb-3">
                                    <label class="form-label">Feedback</label>
                                    <textarea class="form-control" id="editFeedbackInput" name="feedback"
                                        rows="4"><%= submission.feedback || '' %></textarea>
                                </div>
                                <!-- We'll keep a hidden field to know it's an edit, but we just use the same endpoint -->
                            </form>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                            <button type="submit" form="editGradeForm" class="btn btn-success" id="editSubmitBtn">
                                <i class="fas fa-check me-1"></i> Update Grade
                            </button>
                        </div>
                    </div>
                </div>
            </div>
            <% } %>

                <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
                <script>
                    // ─────────────────────────────────────────────
                    // Submit Grade (AJAX) – Handles both main form and edit modal
                    // ─────────────────────────────────────────────
                    async function submitGrade(event, formId) {
                        event.preventDefault();

                        const form = document.getElementById(formId);
                        const formData = new FormData(form);
                        const score = formData.get('score');
                        const feedback = formData.get('feedback');
                        const submissionId = '<%= submission.id %>';
                        const maxScore = parseInt('<%= submission.assignment.points || 100 %>');

                        // Validate score range
                        const parsedScore = parseFloat(score);
                        if (isNaN(parsedScore) || parsedScore < 0 || parsedScore > maxScore) {
                            alert(`Score must be between 0 and ${maxScore}`);
                            return;
                        }

                        // Determine which button to disable
                        let submitBtn;
                        if (formId === 'gradeForm') {
                            submitBtn = document.getElementById('submitGradeBtn');
                        } else {
                            submitBtn = document.getElementById('editSubmitBtn');
                        }

                        // Save original button text
                        const originalText = submitBtn.innerHTML;
                        submitBtn.disabled = true;
                        submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin me-1"></i> Submitting...';

                        try {
                            const response = await fetch(`/teacher/grading/${submissionId}`, {
                                method: 'POST',
                                headers: { 'Content-Type': 'application/json' },
                                body: JSON.stringify({ score: parsedScore, feedback: feedback || '' })
                            });

                            const data = await response.json();

                            if (data.success) {
                                alert('Grade submitted successfully!');
                                // If it's the edit modal, close it first
                                if (formId === 'editGradeForm') {
                                    const modal = bootstrap.Modal.getInstance(document.getElementById('editGradeModal'));
                                    if (modal) modal.hide();
                                }
                                // Reload the page to show the updated grade
                                window.location.reload();
                            } else {
                                alert('Error: ' + (data.message || 'Unknown error'));
                                // Re-enable button
                                submitBtn.disabled = false;
                                submitBtn.innerHTML = originalText;
                            }
                        } catch (error) {
                            console.error('Error submitting grade:', error);
                            alert('Error submitting grade: ' + error.message);
                            // Re-enable button
                            submitBtn.disabled = false;
                            submitBtn.innerHTML = originalText;
                        }
                    }

                    // ─────────────────────────────────────────────
                    // Optional: Auto‑calculate percentage (if you want)
                    // ─────────────────────────────────────────────
                    // (You can add percentage calculation if you like,
                    // but it's not required for the core functionality.)
                </script>
</body>

</html>