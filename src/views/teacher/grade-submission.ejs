<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= title %> - EdTech
    </title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <style>
        .submission-card {
            border-left: 4px solid #0d6efd;
        }

        .student-info-card {
            background-color: #f8f9fa;
            border-radius: 10px;
        }

        .assignment-info-card {
            background-color: #e7f1ff;
            border-radius: 10px;
        }
    </style>
</head>

<body>
    <%- include('../partials/navbar') %>

        <div class="container mt-4">
            <%- include('../partials/alerts') %>

                <!-- School info banner -->
                <div class="alert alert-info mb-4">
                    <i class="fas fa-school me-2"></i>
                    <strong>School:</strong>
                    <%= userSchool || 'All Schools' %>
                        <% if (isSuperAdmin) { %>
                            <span class="badge bg-warning ms-2">Super Admin</span>
                            <% } %>
                </div>

                <!-- Back Button -->
                <div class="mb-4">
                    <a href="/teacher/grading" class="btn btn-outline-secondary">
                        <i class="fas fa-arrow-left me-1"></i> Back to Grading
                    </a>
                </div>

                <div class="row">
                    <!-- Student Information -->
                    <div class="col-md-4 mb-4">
                        <div class="card student-info-card">
                            <div class="card-body">
                                <h5 class="card-title mb-3">
                                    <i class="fas fa-user-graduate me-2"></i>Student Information
                                </h5>

                                <div class="d-flex align-items-center mb-3">
                                    <% if (submission.student.user.avatar) { %>
                                        <img src="<%= submission.student.user.avatar %>" class="rounded-circle me-3"
                                            width="60" height="60" onerror="this.src='/images/default-profile.png'">
                                        <% } else { %>
                                            <img src="/images/default-profile.png" class="rounded-circle me-3"
                                                width="60" height="60">
                                            <% } %>
                                                <div>
                                                    <h6 class="mb-0">
                                                        <%= submission.student.user.firstName %>
                                                            <%= submission.student.user.lastName %>
                                                    </h6>
                                                    <small class="text-muted">ID: <%= submission.student.user.idNumber
                                                            %></small>
                                                </div>
                                </div>

                                <div class="mb-2">
                                    <small class="text-muted d-block">Submitted On:</small>
                                    <strong>
                                        <%= new Date(submission.submittedAt).toLocaleString() %>
                                    </strong>
                                </div>

                                <% if (submission.fileUrl) { %>
                                    <div class="mt-3">
                                        <a href="<%= submission.fileUrl %>" class="btn btn-sm btn-outline-primary"
                                            download>
                                            <i class="fas fa-download me-1"></i> Download Submission
                                        </a>
                                    </div>
                                    <% } %>
                            </div>
                        </div>
                    </div>

                    <!-- Assignment Information -->
                    <div class="col-md-8 mb-4">
                        <div class="card assignment-info-card">
                            <div class="card-body">
                                <h5 class="card-title mb-3">
                                    <i class="fas fa-tasks me-2"></i>Assignment Information
                                </h5>

                                <h4 class="mb-3">
                                    <%= submission.assignment.title %>
                                </h4>

                                <% if (submission.assignment.description) { %>
                                    <div class="mb-3">
                                        <p class="mb-1"><strong>Description:</strong></p>
                                        <p class="text-muted">
                                            <%= submission.assignment.description %>
                                        </p>
                                    </div>
                                    <% } %>

                                        <div class="row">
                                            <div class="col-md-6">
                                                <div class="mb-3">
                                                    <small class="text-muted d-block">Class:</small>
                                                    <strong>
                                                        <% if (submission.assignment.class) { %>
                                                            <%= submission.assignment.class.name %>
                                                                <% } else { %>
                                                                    N/A
                                                                    <% } %>
                                                    </strong>
                                                </div>
                                            </div>
                                            <div class="col-md-6">
                                                <div class="mb-3">
                                                    <small class="text-muted d-block">Due Date:</small>
                                                    <strong>
                                                        <%= new Date(submission.assignment.dueDate).toLocaleDateString()
                                                            %>
                                                    </strong>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="mb-3">
                                            <small class="text-muted d-block">Total Points:</small>
                                            <strong>
                                                <%= submission.assignment.points || 100 %> points
                                            </strong>
                                        </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Submission Content -->
                <div class="card mb-4">
                    <div class="card-header">
                        <h5 class="mb-0">
                            <i class="fas fa-file-alt me-2"></i>Submission Content
                        </h5>
                    </div>
                    <div class="card-body">
                        <% if (submission.answerText) { %>
                            <div class="mb-4">
                                <h6>Text Answer:</h6>
                                <div class="border rounded p-3 bg-light">
                                    <%= submission.answerText %>
                                </div>
                            </div>
                            <% } else { %>
                                <div class="alert alert-info">
                                    <i class="fas fa-info-circle me-2"></i>
                                    No text answer provided.
                                </div>
                                <% } %>

                                    <% if (submission.fileUrl) { %>
                                        <div>
                                            <h6>Attached File:</h6>
                                            <a href="<%= submission.fileUrl %>" class="btn btn-primary" target="_blank">
                                                <i class="fas fa-external-link-alt me-1"></i> View File
                                            </a>
                                        </div>
                                        <% } %>
                    </div>
                </div>

                <!-- Grading Form -->
                <div class="card">
                    <div class="card-header bg-success text-white">
                        <h5 class="mb-0">
                            <i class="fas fa-graduation-cap me-2"></i>Grade Submission
                        </h5>
                    </div>
                    <div class="card-body">
                        <form action="/teacher/grading/<%= submission.id %>" method="POST">
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label class="form-label">Score</label>
                                        <div class="input-group">
                                            <input type="number" class="form-control" name="score" min="0"
                                                max="<%= submission.assignment.points || 100 %>" step="0.1"
                                                value="<%= submission.score || '' %>" required>
                                            <span class="input-group-text">/ <%= submission.assignment.points || 100 %>
                                                    </span>
                                        </div>
                                        <small class="text-muted">Enter score between 0 and <%=
                                                submission.assignment.points || 100 %></small>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label class="form-label">Percentage</label>
                                        <input type="text" class="form-control" id="percentage" readonly>
                                    </div>
                                </div>
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Feedback (Optional)</label>
                                <textarea class="form-control" name="feedback" rows="4"
                                    placeholder="Provide feedback to the student..."><%= submission.feedback || '' %></textarea>
                            </div>

                            <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                                <a href="/teacher/grading" class="btn btn-secondary me-md-2">Cancel</a>
                                <button type="submit" class="btn btn-success">
                                    <i class="fas fa-check me-1"></i> Submit Grade
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
        </div>

        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
        <script>
            // Calculate percentage
            const scoreInput = document.querySelector('input[name="score"]');
            const percentageInput = document.getElementById('percentage');
            const maxScore = <%= submission.assignment.points || 100 %>;

            function calculatePercentage() {
                const score = parseFloat(scoreInput.value);
                if (!isNaN(score) && score >= 0) {
                    const percentage = (score / maxScore * 100).toFixed(1);
                    percentageInput.value = `${percentage}%`;
                } else {
                    percentageInput.value = '';
                }
            }

            scoreInput.addEventListener('input', calculatePercentage);

        // Calculate on page load if score exists
        <% if (submission.score) { %>
                calculatePercentage();
        <% } %>
        </script>
</body>

</html>