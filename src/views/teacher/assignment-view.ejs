<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= title %> - EdTech
    </title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <style>
        .assignment-detail-card {
            border-left: 4px solid #0dcaf0;
        }

        .submission-item {
            border-left: 3px solid #0d6efd;
        }

        .graded {
            border-left-color: #198754;
        }

        .pending {
            border-left-color: #ffc107;
        }
    </style>
</head>

<body>
    <%- include('../partials/navbar') %>

        <div class="container mt-4">
            <%- include('../partials/alerts') %>

                <!-- School info banner -->
                <div class="alert alert-info mb-4">
                    <i class="fas fa-school me-2"></i>
                    <strong>School:</strong>
                    <%= userSchool || 'All Schools' %>
                        <% if (isSuperAdmin) { %>
                            <span class="badge bg-warning ms-2">Super Admin</span>
                            <% } %>
                </div>

                <!-- Back Button -->
                <div class="mb-4">
                    <a href="/teacher/assignments" class="btn btn-outline-secondary">
                        <i class="fas fa-arrow-left me-1"></i> Back to Assignments
                    </a>
                </div>

                <!-- Assignment Details -->
                <div class="row">
                    <div class="col-lg-8">
                        <div class="card assignment-detail-card mb-4">
                            <div class="card-header d-flex justify-content-between align-items-center">
                                <h4 class="mb-0">
                                    <i class="fas fa-tasks me-2"></i>
                                    <%= assignment.title %>
                                </h4>
                                <div class="dropdown">
                                    <button class="btn btn-sm btn-outline-secondary dropdown-toggle" type="button"
                                        data-bs-toggle="dropdown">
                                        <i class="fas fa-ellipsis-v"></i>
                                    </button>
                                    <ul class="dropdown-menu">
                                        <li><a class="dropdown-item" href="#" data-bs-toggle="modal"
                                                data-bs-target="#editAssignmentModal">
                                                <i class="fas fa-edit me-2"></i>Edit Assignment
                                            </a></li>
                                        <li><a class="dropdown-item"
                                                href="/teacher/grading?assignment=<%= assignment.id %>">
                                                <i class="fas fa-graduation-cap me-2"></i>Grade Submissions
                                            </a></li>
                                        <li>
                                            <hr class="dropdown-divider">
                                        </li>
                                        <li><button class="dropdown-item text-danger" data-bs-toggle="modal"
                                                data-bs-target="#deleteAssignmentModal">
                                                <i class="fas fa-trash me-2"></i>Delete Assignment
                                            </button></li>
                                    </ul>
                                </div>
                            </div>
                            <div class="card-body">
                                <% if (assignment.description) { %>
                                    <div class="mb-4">
                                        <h6>Description:</h6>
                                        <p class="card-text" style="white-space: pre-wrap;">
                                            <%= assignment.description %>
                                        </p>
                                    </div>
                                    <% } %>

                                        <div class="row mb-4">
                                            <div class="col-md-6">
                                                <div class="mb-3">
                                                    <h6><i class="fas fa-chalkboard me-2"></i>Class:</h6>
                                                    <p class="mb-0">
                                                        <% if (assignment.class) { %>
                                                            <%= assignment.class.name %>
                                                                <% } else { %>
                                                                    <span class="text-muted">No class assigned</span>
                                                                    <% } %>
                                                    </p>
                                                </div>

                                                <div class="mb-3">
                                                    <h6><i class="fas fa-user me-2"></i>Created By:</h6>
                                                    <p class="mb-0">
                                                        <%= assignment.teacher.user.firstName %>
                                                            <%= assignment.teacher.user.lastName %>
                                                    </p>
                                                </div>
                                            </div>

                                            <div class="col-md-6">
                                                <div class="mb-3">
                                                    <h6><i class="fas fa-calendar me-2"></i>Due Date:</h6>
                                                    <p class="mb-0">
                                                        <%= new Date(assignment.dueDate).toLocaleDateString() %>
                                                            <small class="text-muted ms-2">
                                                                <%= new Date(assignment.dueDate).toLocaleTimeString([],
                                                                    {hour: '2-digit' , minute:'2-digit'}) %>
                                                            </small>
                                                    </p>
                                                    <% const daysUntilDue=Math.ceil((new Date(assignment.dueDate) - new
                                                        Date()) / (1000 * 60 * 60 * 24)); %>
                                                        <% if (daysUntilDue < 0) { %>
                                                            <span class="badge bg-danger">Overdue</span>
                                                            <% } else if (daysUntilDue===0) { %>
                                                                <span class="badge bg-warning">Due Today</span>
                                                                <% } else if (daysUntilDue <=3) { %>
                                                                    <span class="badge bg-warning">Due in <%=
                                                                            daysUntilDue %> days</span>
                                                                    <% } %>
                                                </div>

                                                <div class="mb-3">
                                                    <h6><i class="fas fa-star me-2"></i>Points:</h6>
                                                    <p class="mb-0">
                                                        <%= assignment.points || 100 %> points
                                                    </p>
                                                </div>
                                            </div>
                                        </div>

                                        <!-- Submissions Section -->
                                        <h5 class="mb-3">
                                            <i class="fas fa-paper-plane me-2"></i>Submissions
                                            <span class="badge bg-primary">
                                                <%= assignment.submissions.length %>
                                            </span>
                                        </h5>

                                        <% if (assignment.submissions.length> 0) { %>
                                            <div class="table-responsive">
                                                <table class="table table-hover">
                                                    <thead>
                                                        <tr>
                                                            <th>Student</th>
                                                            <th>Submitted</th>
                                                            <th>Status</th>
                                                            <th>Score</th>
                                                            <th>Actions</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        <% assignment.submissions.forEach(function(submission) { const
                                                            isLate=new Date(submission.submittedAt)> new
                                                            Date(assignment.dueDate);
                                                            const isGraded = submission.grade !== null;
                                                            %>
                                                            <tr
                                                                class="submission-item <%= isGraded ? 'graded' : 'pending' %>">
                                                                <td>
                                                                    <div class="d-flex align-items-center">
                                                                        <% if (submission.student.user.avatar) { %>
                                                                            <img src="<%= submission.student.user.avatar %>"
                                                                                class="rounded-circle me-2" width="32"
                                                                                height="32"
                                                                                onerror="this.src='/images/default-profile.png'">
                                                                            <% } else { %>
                                                                                <img src="/images/default-profile.png"
                                                                                    class="rounded-circle me-2"
                                                                                    width="32" height="32">
                                                                                <% } %>
                                                                                    <div>
                                                                                        <div>
                                                                                            <%= submission.student.user.firstName
                                                                                                %>
                                                                                                <%= submission.student.user.lastName
                                                                                                    %>
                                                                                        </div>
                                                                                        <small class="text-muted">
                                                                                            <%= submission.student.user.idNumber
                                                                                                %>
                                                                                        </small>
                                                                                    </div>
                                                                    </div>
                                                                </td>
                                                                <td>
                                                                    <%= new
                                                                        Date(submission.submittedAt).toLocaleDateString()
                                                                        %>
                                                                        <br>
                                                                        <small class="text-muted">
                                                                            <%= new
                                                                                Date(submission.submittedAt).toLocaleTimeString([],
                                                                                {hour: '2-digit' , minute:'2-digit'}) %>
                                                                        </small>
                                                                </td>
                                                                <td>
                                                                    <% if (isLate) { %>
                                                                        <span class="badge bg-danger">Late</span>
                                                                        <% } else if (isGraded) { %>
                                                                            <span class="badge bg-success">Graded</span>
                                                                            <% } else { %>
                                                                                <span
                                                                                    class="badge bg-warning">Pending</span>
                                                                                <% } %>
                                                                </td>
                                                                <td>
                                                                    <% if (isGraded) { %>
                                                                        <strong>
                                                                            <%= submission.score %> / <%=
                                                                                    assignment.points || 100 %>
                                                                        </strong>
                                                                        <% } else { %>
                                                                            <span class="text-muted">-</span>
                                                                            <% } %>
                                                                </td>
                                                                <td>
                                                                    <a href="/teacher/grading/<%= submission.id %>"
                                                                        class="btn btn-sm btn-outline-primary">
                                                                        <i class="fas fa-eye"></i> View
                                                                    </a>
                                                                </td>
                                                            </tr>
                                                            <% }); %>
                                                    </tbody>
                                                </table>
                                            </div>
                                            <% } else { %>
                                                <div class="alert alert-info">
                                                    <i class="fas fa-info-circle me-2"></i>
                                                    No submissions yet.
                                                </div>
                                                <% } %>
                            </div>
                        </div>
                    </div>

                    <!-- Sidebar Stats -->
                    <div class="col-lg-4">
                        <div class="card mb-4">
                            <div class="card-header">
                                <h5 class="mb-0">Assignment Stats</h5>
                            </div>
                            <div class="card-body">
                                <% let totalStudents=0; if (assignment.class && assignment.class.enrollments) {
                                    totalStudents=assignment.class.enrollments.length; } else if (assignment.class &&
                                    assignment.class._count) { totalStudents=assignment.class._count.enrollments || 0; }
                                    const submissionsCount=assignment.submissions ? assignment.submissions.length : 0;
                                    const gradedCount=assignment.submissions ? assignment.submissions.filter(function(s)
                                    { return s.grade !==null; }).length : 0; const pendingCount=submissionsCount -
                                    gradedCount; const submissionRate=totalStudents> 0 ? Math.round((submissionsCount /
                                    totalStudents) * 100) : 0;
                                    %>

                                    <div class="mb-3">
                                        <small class="text-muted d-block">Total Students</small>
                                        <h4 class="mb-0">
                                            <%= totalStudents %>
                                        </h4>
                                    </div>

                                    <div class="mb-3">
                                        <small class="text-muted d-block">Submissions</small>
                                        <h4 class="mb-0">
                                            <%= submissionsCount %> / <%= totalStudents %>
                                        </h4>
                                        <div class="progress mt-2" style="height: 6px;">
                                            <div class="progress-bar bg-primary" style="width: <%= submissionRate %>%">
                                            </div>
                                        </div>
                                        <small class="text-muted">
                                            <%= submissionRate %>% submission rate
                                        </small>
                                    </div>

                                    <div class="mb-3">
                                        <small class="text-muted d-block">Grading Progress</small>
                                        <h4 class="mb-0">
                                            <%= gradedCount %> / <%= submissionsCount %>
                                        </h4>
                                        <div class="progress mt-2" style="height: 6px;">
                                            <div class="progress-bar bg-success"
                                                style="width: <%= submissionsCount > 0 ? Math.round((gradedCount / submissionsCount) * 100) : 0 %>%">
                                            </div>
                                        </div>
                                        <% if (pendingCount> 0) { %>
                                            <small class="text-danger">
                                                <i class="fas fa-clock me-1"></i>
                                                <%= pendingCount %> pending grading
                                            </small>
                                            <% } %>
                                    </div>

                                    <div class="d-grid gap-2">
                                        <a href="/teacher/grading?assignment=<%= assignment.id %>"
                                            class="btn btn-warning">
                                            <i class="fas fa-graduation-cap me-1"></i> Grade Submissions
                                        </a>
                                        <button class="btn btn-outline-primary" data-bs-toggle="modal"
                                            data-bs-target="#editAssignmentModal">
                                            <i class="fas fa-edit me-1"></i> Edit Assignment
                                        </button>
                                    </div>
                            </div>
                        </div>
                    </div>
                </div>
        </div>

        <!-- Edit Assignment Modal -->
        <div class="modal fade" id="editAssignmentModal" tabindex="-1">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Edit Assignment</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <form id="editAssignmentForm">
                            <div class="mb-3">
                                <label class="form-label">Title *</label>
                                <input type="text" class="form-control" name="title" value="<%= assignment.title %>"
                                    required>
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Description</label>
                                <textarea class="form-control" name="description"
                                    rows="3"><%= assignment.description || '' %></textarea>
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Class *</label>
                                <select class="form-select" name="classId" required>
                                    <option value="">Select a class</option>
                                    <% classes.forEach(function(cls) { %>
                                        <option value="<%= cls.id %>" <%=assignment.classId===cls.id ? 'selected' : ''
                                            %>>
                                            <%= cls.name %>
                                        </option>
                                        <% }); %>
                                </select>
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Due Date *</label>
                                <input type="datetime-local" class="form-control" name="dueDate"
                                    value="<%= new Date(assignment.dueDate).toISOString().slice(0, 16) %>" required>
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Points</label>
                                <input type="number" class="form-control" name="points"
                                    value="<%= assignment.points || 100 %>" min="1" max="1000">
                            </div>
                        </form>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="button" class="btn btn-primary" id="saveAssignmentBtn">Save Changes</button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Delete Confirmation Modal -->
        <div class="modal fade" id="deleteAssignmentModal" tabindex="-1">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Confirm Delete</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <p>Are you sure you want to delete this assignment? This action cannot be undone.</p>
                        <p class="text-danger">
                            <strong>Warning:</strong> All submissions will also be deleted.
                        </p>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="button" class="btn btn-danger" id="confirmDeleteBtn">Delete Assignment</button>
                    </div>
                </div>
            </div>
        </div>

        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
        <script>
            // Edit Assignment
            document.getElementById('saveAssignmentBtn').addEventListener('click', async function () {
                const form = document.getElementById('editAssignmentForm');
                const formData = new FormData(form);
                const data = Object.fromEntries(formData.entries());

                try {
                    const response = await fetch('/teacher/assignments/<%= assignment.id %>', {
                        method: 'PUT',
                        headers: {
                            'Content-Type': 'application/json'
                        },
                        body: JSON.stringify(data)
                    });

                    const result = await response.json();

                    if (result.success) {
                        alert('Assignment updated successfully!');
                        location.reload();
                    } else {
                        alert('Error: ' + result.message);
                    }
                } catch (error) {
                    console.error('Error:', error);
                    alert('Error updating assignment');
                }
            });

            // Delete Assignment
            document.getElementById('confirmDeleteBtn').addEventListener('click', async function () {
                try {
                    const response = await fetch('/teacher/assignments/<%= assignment.id %>', {
                        method: 'DELETE',
                        headers: {
                            'Content-Type': 'application/json'
                        }
                    });

                    const result = await response.json();

                    if (result.success) {
                        alert('Assignment deleted successfully!');
                        window.location.href = '/teacher/assignments';
                    } else {
                        alert('Error: ' + result.message);
                    }
                } catch (error) {
                    console.error('Error:', error);
                    alert('Error deleting assignment');
                }
            });
        </script>
</body>

</html>