<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Upload Material - EdTech</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <style>
        .upload-container {
            max-width: 800px;
            margin: 0 auto;
            padding: 30px;
            background: white;
            border-radius: 10px;
            box-shadow: 0 5px 20px rgba(0, 0, 0, 0.1);
        }

        .upload-preview {
            border: 2px dashed #dee2e6;
            border-radius: 10px;
            padding: 40px 20px;
            text-align: center;
            cursor: pointer;
            transition: all 0.3s ease;
            background: #f8f9fa;
        }

        .upload-preview:hover {
            border-color: #0d6efd;
            background-color: #e7f1ff;
        }

        .upload-preview.dragover {
            border-color: #0d6efd;
            background-color: #cfe2ff;
        }

        .upload-icon {
            font-size: 4rem;
            color: #6c757d;
            margin-bottom: 20px;
        }

        .file-preview {
            margin-top: 20px;
            padding: 20px;
            background: #e9ecef;
            border-radius: 8px;
            display: none;
        }

        .file-info {
            display: flex;
            align-items: center;
            gap: 15px;
        }

        .file-icon {
            font-size: 2.5rem;
            color: #0d6efd;
        }

        .file-details h6 {
            margin-bottom: 5px;
        }

        .file-size {
            color: #6c757d;
            font-size: 0.9rem;
        }

        .progress {
            height: 6px;
            margin-top: 10px;
        }

        .preview-image {
            max-width: 100%;
            max-height: 200px;
            object-fit: contain;
            border-radius: 5px;
            margin-bottom: 15px;
        }

        .form-section {
            margin-bottom: 25px;
            padding: 20px;
            background: #f8f9fa;
            border-radius: 8px;
        }

        .tag-input {
            border: 1px solid #ced4da;
            padding: 8px;
            border-radius: 5px;
            min-height: 38px;
            display: flex;
            flex-wrap: wrap;
            gap: 5px;
            align-items: center;
        }

        .tag {
            background: #0d6efd;
            color: white;
            padding: 2px 8px;
            border-radius: 15px;
            font-size: 0.85rem;
            display: inline-flex;
            align-items: center;
            gap: 5px;
        }

        .tag-remove {
            cursor: pointer;
            font-size: 0.8rem;
            padding-left: 5px;
        }

        .tag-input input {
            border: none;
            outline: none;
            flex: 1;
            min-width: 100px;
            background: transparent;
        }

        .upload-btn {
            padding: 12px 30px;
            font-size: 1.1rem;
        }

        .back-btn {
            padding: 12px 30px;
            font-size: 1.1rem;
        }

        #uploadError {
            display: none;
            margin-bottom: 15px;
        }
    </style>
</head>

<body>
    <%- include('../partials/navbar') %>

        <div class="container mt-4">
            <%- include('../partials/alerts') %>

                <!-- School info banner -->
                <div class="alert alert-info mb-4">
                    <i class="fas fa-school me-2"></i>
                    <strong>School:</strong>
                    <%= userSchool || 'All Schools' %>
                        <% if (isSuperAdmin) { %>
                            <span class="badge bg-warning ms-2">Super Admin</span>
                            <% } %>
                </div>

                <div class="row">
                    <div class="col-md-3">
                        <div class="card mb-4">
                            <div class="card-header">
                                <h5><i class="fas fa-arrow-left me-2"></i>Navigation</h5>
                            </div>
                            <div class="card-body">
                                <a href="/teacher/materials" class="btn btn-outline-primary w-100 mb-2">
                                    <i class="fas fa-arrow-left me-2"></i> Back to Materials
                                </a>
                                <a href="/teacher/dashboard" class="btn btn-outline-secondary w-100">
                                    <i class="fas fa-home me-2"></i> Dashboard
                                </a>
                            </div>
                        </div>

                        <div class="card">
                            <div class="card-header">
                                <h5><i class="fas fa-info-circle me-2"></i>Upload Tips</h5>
                            </div>
                            <div class="card-body">
                                <ul class="list-unstyled small">
                                    <li class="mb-2"><i class="fas fa-check text-success me-2"></i> Max file size: 100MB
                                    </li>
                                    <li class="mb-2"><i class="fas fa-check text-success me-2"></i> Supported: PDF, DOC,
                                        PPT, MP4, JPG</li>
                                    <li class="mb-2"><i class="fas fa-check text-success me-2"></i> Use descriptive
                                        titles</li>
                                    <li class="mb-2"><i class="fas fa-check text-success me-2"></i> Add tags for better
                                        search</li>
                                    <li><i class="fas fa-check text-success me-2"></i> Set class for organization</li>
                                </ul>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-9">
                        <div class="upload-container">
                            <h2 class="mb-4"><i class="fas fa-upload me-2"></i>Upload Material</h2>

                            <!-- Error display area -->
                            <div id="uploadError" class="alert alert-danger">
                                <!-- Error message will be inserted here -->
                            </div>

                            <form id="uploadForm" action="/teacher/materials/upload" method="POST"
                                enctype="multipart/form-data">
                                <!-- File Upload Section -->
                                <div class="form-section">
                                    <h5 class="mb-3">1. Select File</h5>

                                    <div class="upload-preview" id="dropZone">
                                        <div class="upload-icon">
                                            <i class="fas fa-cloud-upload-alt"></i>
                                        </div>
                                        <h5>Drag & Drop your file here</h5>
                                        <p class="text-muted">or click to browse</p>
                                        <input type="file" name="materialFile" id="fileInput" class="d-none"
                                            accept=".pdf,.doc,.docx,.ppt,.pptx,.jpg,.jpeg,.png,.mp4,.mp3,.txt">
                                        <button type="button" class="btn btn-outline-primary mt-3"
                                            onclick="document.getElementById('fileInput').click()">
                                            <i class="fas fa-folder-open me-2"></i> Browse Files
                                        </button>
                                    </div>

                                    <div class="file-preview" id="filePreview">
                                        <!-- File preview will be shown here -->
                                    </div>
                                </div>

                                <!-- Material Details Section -->
                                <div class="form-section">
                                    <h5 class="mb-3">2. Material Details</h5>

                                    <div class="row">
                                        <div class="col-md-12 mb-3">
                                            <label class="form-label">Title *</label>
                                            <input type="text" class="form-control" name="title"
                                                placeholder="Enter material title" required>
                                        </div>

                                        <div class="col-md-12 mb-3">
                                            <label class="form-label">Description</label>
                                            <textarea class="form-control" name="description" rows="3"
                                                placeholder="Describe the material content..."></textarea>
                                        </div>

                                        <div class="col-md-6 mb-3">
                                            <label class="form-label">Type *</label>
                                            <select class="form-select" name="type" required>
                                                <option value="">Select type...</option>
                                                <option value="document">Document</option>
                                                <option value="video">Video</option>
                                                <option value="presentation">Presentation</option>
                                                <option value="textbook">Textbook</option>
                                                <option value="other">Other</option>
                                            </select>
                                        </div>

                                        <div class="col-md-6 mb-3">
                                            <label class="form-label">Category</label>
                                            <input type="text" class="form-control" name="category"
                                                placeholder="e.g., Lecture Notes, Homework, Exam">
                                        </div>

                                        <div class="col-md-6 mb-3">
                                            <label class="form-label">Class (Optional)</label>
                                            <select class="form-select" name="classId">
                                                <option value="">Select class...</option>
                                                <% classes.forEach(function(cls) { %>
                                                    <option value="<%= cls.id %>">
                                                        <%= cls.name %>
                                                    </option>
                                                    <% }); %>
                                            </select>
                                        </div>

                                        <div class="col-md-6 mb-3">
                                            <label class="form-label">Tags (Optional)</label>
                                            <div class="tag-input" id="tagContainer">
                                                <!-- Tags will be added here -->
                                                <input type="text" id="tagInput" placeholder="Type and press Enter...">
                                            </div>
                                            <input type="hidden" name="tags" id="hiddenTags">
                                            <small class="text-muted">Press Enter to add a tag</small>
                                        </div>

                                        <div class="col-md-12 mb-3">
                                            <div class="form-check">
                                                <input class="form-check-input" type="checkbox" name="isPublic"
                                                    id="isPublic" checked>
                                                <label class="form-check-label" for="isPublic">
                                                    Make this material public (visible to students)
                                                </label>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Upload Progress -->
                                <div class="mb-4" id="uploadProgress" style="display: none;">
                                    <div class="d-flex justify-content-between mb-2">
                                        <span>Uploading...</span>
                                        <span id="progressPercentage">0%</span>
                                    </div>
                                    <div class="progress">
                                        <div class="progress-bar" id="progressBar" style="width: 0%"></div>
                                    </div>
                                </div>

                                <!-- Action Buttons -->
                                <div class="d-flex justify-content-between">
                                    <a href="/teacher/materials" class="btn btn-outline-secondary back-btn">
                                        <i class="fas fa-times me-2"></i> Cancel
                                    </a>
                                    <button type="submit" class="btn btn-success upload-btn" id="uploadBtn">
                                        <i class="fas fa-upload me-2"></i> Upload Material
                                    </button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
        </div>

        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
        <script>
            const fileInput = document.getElementById('fileInput');
            const dropZone = document.getElementById('dropZone');
            const filePreview = document.getElementById('filePreview');
            const tagInput = document.getElementById('tagInput');
            const tagContainer = document.getElementById('tagContainer');
            const hiddenTags = document.getElementById('hiddenTags');
            const uploadForm = document.getElementById('uploadForm');
            const uploadProgress = document.getElementById('uploadProgress');
            const progressBar = document.getElementById('progressBar');
            const progressPercentage = document.getElementById('progressPercentage');
            const uploadBtn = document.getElementById('uploadBtn');
            const uploadError = document.getElementById('uploadError');

            let selectedFile = null;
            let tags = [];
            let isSubmitting = false;   // ✅ Prevents double submission

            // Hide error initially
            uploadError.style.display = 'none';

            // Drag and drop functionality
            dropZone.addEventListener('dragover', (e) => {
                e.preventDefault();
                dropZone.classList.add('dragover');
            });

            dropZone.addEventListener('dragleave', () => {
                dropZone.classList.remove('dragover');
            });

            dropZone.addEventListener('drop', (e) => {
                e.preventDefault();
                dropZone.classList.remove('dragover');

                if (e.dataTransfer.files.length) {
                    fileInput.files = e.dataTransfer.files;
                    handleFileSelect(e.dataTransfer.files[0]);
                }
            });

            dropZone.addEventListener('click', () => {
                fileInput.click();
            });

            fileInput.addEventListener('change', (e) => {
                if (e.target.files.length) {
                    handleFileSelect(e.target.files[0]);
                }
            });

            function handleFileSelect(file) {
                selectedFile = file;

                // Validate file size (100MB limit)
                const maxSize = 100 * 1024 * 1024; // 100MB in bytes
                if (file.size > maxSize) {
                    alert('File size exceeds 100MB limit. Please select a smaller file.');
                    fileInput.value = '';
                    selectedFile = null;
                    filePreview.style.display = 'none';
                    return;
                }

                // Validate file type
                const allowedTypes = [
                    'application/pdf',
                    'application/msword',
                    'application/vnd.openxmlformats-officedocument.wordprocessingml.document',
                    'application/vnd.ms-powerpoint',
                    'application/vnd.openxmlformats-officedocument.presentationml.presentation',
                    'image/jpeg',
                    'image/png',
                    'video/mp4',
                    'audio/mpeg',
                    'text/plain'
                ];

                if (!allowedTypes.includes(file.type) && !file.name.match(/\.(pdf|doc|docx|ppt|pptx|jpg|jpeg|png|mp4|mp3|txt)$/i)) {
                    alert('File type not supported. Please upload PDF, DOC, PPT, JPG, PNG, MP4, MP3, or TXT files.');
                    fileInput.value = '';
                    selectedFile = null;
                    filePreview.style.display = 'none';
                    return;
                }

                // Show preview
                const reader = new FileReader();

                reader.onload = function (e) {
                    let previewHtml = '';
                    const fileSize = formatFileSize(file.size);

                    if (file.type.startsWith('image/')) {
                        previewHtml = `
                        <img src="${e.target.result}" class="preview-image" alt="Preview">
                        <div class="file-info">
                            <div class="file-icon">
                                <i class="fas fa-file-image"></i>
                            </div>
                            <div class="file-details">
                                <h6>${file.name}</h6>
                                <p class="file-size">${fileSize} • ${file.type}</p>
                            </div>
                        </div>
                    `;
                    } else if (file.type === 'application/pdf') {
                        previewHtml = `
                        <div class="file-info">
                            <div class="file-icon">
                                <i class="fas fa-file-pdf"></i>
                            </div>
                            <div class="file-details">
                                <h6>${file.name}</h6>
                                <p class="file-size">${fileSize} • PDF Document</p>
                            </div>
                        </div>
                    `;
                    } else if (file.type.includes('word') || file.name.match(/\.docx?$/i)) {
                        previewHtml = `
                        <div class="file-info">
                            <div class="file-icon">
                                <i class="fas fa-file-word"></i>
                            </div>
                            <div class="file-details">
                                <h6>${file.name}</h6>
                                <p class="file-size">${fileSize} • Word Document</p>
                            </div>
                        </div>
                    `;
                    } else if (file.type.includes('powerpoint') || file.name.match(/\.pptx?$/i)) {
                        previewHtml = `
                        <div class="file-info">
                            <div class="file-icon">
                                <i class="fas fa-file-powerpoint"></i>
                            </div>
                            <div class="file-details">
                                <h6>${file.name}</h6>
                                <p class="file-size">${fileSize} • PowerPoint</p>
                            </div>
                        </div>
                    `;
                    } else if (file.type.startsWith('video/')) {
                        previewHtml = `
                        <div class="file-info">
                            <div class="file-icon">
                                <i class="fas fa-file-video"></i>
                            </div>
                            <div class="file-details">
                                <h6>${file.name}</h6>
                                <p class="file-size">${fileSize} • Video</p>
                            </div>
                        </div>
                    `;
                    } else {
                        previewHtml = `
                        <div class="file-info">
                            <div class="file-icon">
                                <i class="fas fa-file"></i>
                            </div>
                            <div class="file-details">
                                <h6>${file.name}</h6>
                                <p class="file-size">${fileSize} • ${file.type}</p>
                            </div>
                        </div>
                    `;
                    }

                    filePreview.innerHTML = previewHtml;
                    filePreview.style.display = 'block';

                    // Auto-set type based on file extension
                    const typeSelect = document.querySelector('select[name="type"]');
                    if (file.type.startsWith('image/')) {
                        typeSelect.value = 'document';
                    } else if (file.type.startsWith('video/')) {
                        typeSelect.value = 'video';
                    } else if (file.type.includes('powerpoint')) {
                        typeSelect.value = 'presentation';
                    } else if (file.type.includes('word') || file.type === 'application/pdf' || file.type === 'text/plain') {
                        typeSelect.value = 'document';
                    }

                    // Auto-fill title if empty
                    const titleInput = document.querySelector('input[name="title"]');
                    if (!titleInput.value) {
                        titleInput.value = file.name.replace(/\.[^/.]+$/, ""); // Remove extension
                    }
                };

                if (file.type.startsWith('image/')) {
                    reader.readAsDataURL(file);
                } else {
                    reader.readAsText(file.slice(0, 100)); // Just read first 100 bytes for non-images
                }
            }

            function formatFileSize(bytes) {
                if (bytes === 0) return '0 Bytes';
                const k = 1024;
                const sizes = ['Bytes', 'KB', 'MB', 'GB'];
                const i = Math.floor(Math.log(bytes) / Math.log(k));
                return parseFloat((bytes / Math.pow(k, i)).toFixed(2)) + ' ' + sizes[i];
            }

            // Tag management
            tagInput.addEventListener('keydown', (e) => {
                if (e.key === 'Enter') {
                    e.preventDefault();
                    addTag(tagInput.value.trim());
                    tagInput.value = '';
                }
            });

            function addTag(tag) {
                if (tag && !tags.includes(tag)) {
                    tags.push(tag);
                    updateTagDisplay();
                    updateHiddenTags();
                }
            }

            function removeTag(tag) {
                tags = tags.filter(t => t !== tag);
                updateTagDisplay();
                updateHiddenTags();
            }

            function updateTagDisplay() {
                tagContainer.innerHTML = '';
                tags.forEach(tag => {
                    const tagElement = document.createElement('span');
                    tagElement.className = 'tag';
                    tagElement.innerHTML = `
                    ${tag}
                    <span class="tag-remove" onclick="removeTag('${tag}')">
                        <i class="fas fa-times"></i>
                    </span>
                `;
                    tagContainer.insertBefore(tagElement, tagInput);
                });
                tagContainer.appendChild(tagInput);
            }

            function updateHiddenTags() {
                hiddenTags.value = tags.join(',');
            }

            // Form submission with double‑submit prevention
            uploadForm.addEventListener('submit', async (e) => {
                e.preventDefault();

                // Prevent multiple submissions
                if (isSubmitting) {
                    return;
                }

                // Clear previous errors
                uploadError.style.display = 'none';
                uploadError.textContent = '';

                // Validate required fields
                const title = document.querySelector('input[name="title"]').value.trim();
                const type = document.querySelector('select[name="type"]').value;
                if (!title) {
                    showError('Please enter a title for the material.');
                    return;
                }
                if (!type) {
                    showError('Please select a material type.');
                    return;
                }
                if (!selectedFile) {
                    showError('Please select a file to upload.');
                    return;
                }

                // Disable upload button and show progress
                isSubmitting = true;
                uploadBtn.disabled = true;
                uploadBtn.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i> Uploading...';
                uploadProgress.style.display = 'block';

                const formData = new FormData(uploadForm);

                try {
                    const xhr = new XMLHttpRequest();

                    xhr.upload.addEventListener('progress', (e) => {
                        if (e.lengthComputable) {
                            const percentComplete = Math.round((e.loaded / e.total) * 100);
                            progressBar.style.width = percentComplete + '%';
                            progressPercentage.textContent = percentComplete + '%';
                        }
                    });

                    xhr.addEventListener('load', () => {
                        const status = xhr.status;
                        const responseText = xhr.responseText;

                        if (status === 200) {
                            // Try to parse as JSON
                            try {
                                const response = JSON.parse(responseText);
                                if (response.success) {
                                    // Success – redirect to materials list
                                    window.location.href = '/teacher/materials';
                                    return;
                                } else {
                                    // Server returned success: false
                                    showError('Upload failed: ' + (response.message || 'Unknown error'));
                                    resetUploadForm();
                                    return;
                                }
                            } catch (jsonError) {
                                // If response is not JSON, assume it's a redirect (success)
                                window.location.href = '/teacher/materials';
                                return;
                            }
                        } else {
                            // Non‑200 status – try to extract error message
                            let errorMsg = 'Server error (status ' + status + ')';
                            try {
                                const errorJson = JSON.parse(responseText);
                                if (errorJson.message) {
                                    errorMsg = errorJson.message;
                                }
                            } catch (e) {
                                // If not JSON, show a snippet of the HTML (to help debug)
                                if (responseText) {
                                    // Strip HTML tags to get a readable message
                                    const stripped = responseText.replace(/<[^>]*>/g, ' ').substring(0, 300);
                                    errorMsg = stripped || 'Unknown server error';
                                }
                            }
                            showError('Upload failed: ' + errorMsg);
                            resetUploadForm();
                        }
                    });

                    xhr.addEventListener('error', () => {
                        showError('Network error. Please check your connection.');
                        resetUploadForm();
                    });

                    xhr.open('POST', uploadForm.action);
                    xhr.send(formData);

                } catch (error) {
                    console.error('Upload error:', error);
                    showError('Upload failed: ' + error.message);
                    resetUploadForm();
                }
            });

            function showError(message) {
                uploadError.textContent = message;
                uploadError.style.display = 'block';
                // Scroll to error
                uploadError.scrollIntoView({ behavior: 'smooth', block: 'center' });
            }

            function resetUploadForm() {
                isSubmitting = false;
                uploadBtn.disabled = false;
                uploadBtn.innerHTML = '<i class="fas fa-upload me-2"></i> Upload Material';
                uploadProgress.style.display = 'none';
                progressBar.style.width = '0%';
                progressPercentage.textContent = '0%';
            }

            // Keyboard shortcuts
            document.addEventListener('keydown', (e) => {
                // Ctrl/Cmd + S to submit
                if ((e.ctrlKey || e.metaKey) && e.key === 's') {
                    e.preventDefault();
                    uploadForm.requestSubmit();
                }

                // Escape to cancel
                if (e.key === 'Escape') {
                    window.location.href = '/teacher/materials';
                }
            });
        </script>
</body>

</html>