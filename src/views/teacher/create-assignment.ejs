<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= title %> - EdTech
    </title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
</head>

<body>
    <%- include('../partials/navbar') %>

        <div class="container mt-4">
            <%- include('../partials/alerts') %>

                <div class="row">
                    <div class="col-md-8 offset-md-2">
                        <div class="card">
                            <div class="card-header bg-primary text-white">
                                <h4 class="mb-0"><i class="fas fa-plus-circle me-2"></i>Create New Assignment</h4>
                            </div>
                            <div class="card-body">
                                <form action="/teacher/assignments/create" method="POST">
                                    <div class="mb-3">
                                        <label for="title" class="form-label">Assignment Title *</label>
                                        <input type="text" class="form-control" id="title" name="title" required>
                                    </div>

                                    <!-- ========= NEW: UPLOAD DESCRIPTION FROM FILE ========= -->
                                    <div class="card mb-4 border-primary">
                                        <div class="card-header bg-light text-primary">
                                            <h5 class="mb-0"><i class="fas fa-upload me-2"></i>Upload Instructions from
                                                File</h5>
                                        </div>
                                        <div class="card-body">
                                            <div class="row">
                                                <div class="col-md-8">
                                                    <label for="descriptionFile" class="form-label">Choose file (.txt,
                                                        .docx)</label>
                                                    <input type="file" class="form-control" id="descriptionFile"
                                                        accept=".txt,.docx,.doc">
                                                </div>
                                                <div class="col-md-4 d-flex align-items-end">
                                                    <button type="button" class="btn btn-primary"
                                                        id="parseDescriptionBtn">
                                                        <i class="fas fa-file-import me-1"></i> Parse & Add to
                                                        Description
                                                    </button>
                                                </div>
                                            </div>
                                            <div id="uploadStatus" class="mt-2 small"></div>
                                        </div>
                                    </div>
                                    <!-- ========= END UPLOAD SECTION ========= -->

                                    <div class="mb-3">
                                        <label for="description" class="form-label">Description</label>
                                        <textarea class="form-control" id="description" name="description"
                                            rows="5"></textarea>
                                    </div>

                                    <div class="row">
                                        <div class="col-md-6 mb-3">
                                            <label for="classId" class="form-label">Class *</label>
                                            <select class="form-control" id="classId" name="classId" required>
                                                <option value="">Select a class</option>
                                                <% classes.forEach(cls=> { %>
                                                    <option value="<%= cls.id %>">
                                                        <%= cls.name %>
                                                    </option>
                                                    <% }) %>
                                            </select>
                                        </div>

                                        <div class="col-md-6 mb-3">
                                            <label for="dueDate" class="form-label">Due Date *</label>
                                            <input type="datetime-local" class="form-control" id="dueDate"
                                                name="dueDate" required>
                                        </div>
                                    </div>

                                    <div class="mb-3">
                                        <label for="points" class="form-label">Points</label>
                                        <input type="number" class="form-control" id="points" name="points" value="100"
                                            min="1">
                                    </div>

                                    <div class="d-flex justify-content-between">
                                        <a href="/teacher/assignments" class="btn btn-secondary">Cancel</a>
                                        <button type="submit" class="btn btn-primary">
                                            <i class="fas fa-save me-1"></i> Create Assignment
                                        </button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
        </div>

        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
        <script>
            // Set default due date to tomorrow
            const tomorrow = new Date();
            tomorrow.setDate(tomorrow.getDate() + 1);
            document.getElementById('dueDate').value = tomorrow.toISOString().slice(0, 16);

            // ---------- FILE UPLOAD HANDLER FOR DESCRIPTION ----------
            document.getElementById('parseDescriptionBtn').addEventListener('click', async function () {
                const fileInput = document.getElementById('descriptionFile');
                if (!fileInput.files.length) {
                    alert('Please select a file.');
                    return;
                }

                const formData = new FormData();
                formData.append('descriptionFile', fileInput.files[0]);

                const statusDiv = document.getElementById('uploadStatus');
                statusDiv.innerHTML = '<span class="text-info"><i class="fas fa-spinner fa-spin"></i> Uploading and parsing...</span>';

                try {
                    const response = await fetch('/teacher/assignments/parse-description', {
                        method: 'POST',
                        body: formData
                    });
                    const result = await response.json();

                    if (result.success) {
                        // Append the parsed text to the description textarea
                        const descTextarea = document.getElementById('description');
                        const currentText = descTextarea.value;
                        const newText = currentText
                            ? currentText + '\n\n--- Uploaded Content ---\n' + result.text
                            : result.text;
                        descTextarea.value = newText;
                        statusDiv.innerHTML = `<span class="text-success">✅ Content added to description.</span>`;
                    } else {
                        statusDiv.innerHTML = `<span class="text-danger">❌ Parsing failed: ${result.message}</span>`;
                        alert('❌ Parsing failed: ' + result.message);
                    }
                } catch (err) {
                    console.error('Upload error:', err);
                    statusDiv.innerHTML = '<span class="text-danger">❌ Network error while uploading file.</span>';
                    alert('Network error while uploading file.');
                }
            });
        </script>
</body>

</html>