<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= title %> - EdTech
    </title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <style>
        .classwork-card {
            border-left: 4px solid #20c997;
            transition: all 0.3s ease;
        }

        .classwork-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 6px 20px rgba(0, 0, 0, 0.1);
        }

        .type-badge {
            font-size: 0.75rem;
            padding: 4px 10px;
        }

        .type-quiz {
            background-color: #0d6efd;
            color: white;
        }

        .type-assignment {
            background-color: #198754;
            color: white;
        }

        .type-discussion {
            background-color: #6f42c1;
            color: white;
        }

        .type-project {
            background-color: #fd7e14;
            color: white;
        }

        .submission-count {
            font-size: 0.8rem;
        }

        .question-preview {
            max-height: 100px;
            overflow-y: auto;
            font-size: 0.9rem;
        }
    </style>
</head>

<body>
    <%- include('../partials/navbar') %>

        <div class="container mt-4">
            <%- include('../partials/alerts') %>

                <div class="alert alert-info mb-4">
                    <i class="fas fa-school me-2"></i>
                    <strong>School:</strong>
                    <%= userSchool || 'All Schools' %>
                        <% if (isSuperAdmin) { %>
                            <span class="badge bg-warning ms-2">Super Admin</span>
                            <% } %>
                </div>

                <div class="row">
                    <!-- Left Sidebar with Profile -->
                    <div class="col-md-3">
                        <div class="profile-section text-center">
                            <%- include('../partials/user-avatar', { localClass: 'profile-img mb-3 avatar-img' }) %>
                                <h4>
                                    <%= user.firstName %>
                                        <%= user.lastName %>
                                </h4>
                                <p class="welcome-text">Class Works</p>
                                <span class="user-role">Teacher</span>
                                <div class="mt-2">
                                    <small><i class="fas fa-school me-1"></i>
                                        <%= userSchool %>
                                    </small>
                                </div>
                        </div>

                        <!-- Quick Actions (unchanged) -->
                        <div class="card dashboard-card mb-4">
                            <div class="card-header">
                                <h5>Quick Actions</h5>
                            </div>
                            <div class="card-body">
                                <a href="/teacher/class-works" class="btn btn-outline-success w-100 mb-2 action-btn"><i
                                        class="fas fa-tasks"></i> Class Works</a>
                                <a href="/teacher/class-works/create"
                                    class="btn btn-outline-primary w-100 mb-2 action-btn"><i class="fas fa-plus"></i>
                                    Create New</a>
                                <a href="/teacher/assignments" class="btn btn-outline-info w-100 mb-2 action-btn"><i
                                        class="fas fa-tasks"></i> Assignments</a>
                                <a href="/teacher/exams" class="btn btn-outline-danger w-100 mb-2 action-btn"><i
                                        class="fas fa-clipboard-list"></i> Exams</a>
                                <a href="/teacher/dashboard" class="btn btn-outline-secondary w-100 mb-2 action-btn"><i
                                        class="fas fa-home"></i> Dashboard</a>
                            </div>
                        </div>

                        <!-- Class Works Stats (unchanged) -->
                        <div class="card dashboard-card mb-4">
                            <div class="card-header">
                                <h5>Class Works Stats</h5>
                            </div>
                            <div class="card-body">
                                <div class="mb-2"><small><strong>Total Works:</strong></small><span
                                        class="badge bg-primary float-end">
                                        <%= stats ? stats.totalClassWorks : 0 %>
                                    </span></div>
                                <div class="mb-2"><small><strong>Active Works:</strong></small><span
                                        class="badge bg-success float-end">
                                        <%= stats ? stats.activeClassWorks : 0 %>
                                    </span></div>
                                <div class="mb-2"><small><strong>Total Submissions:</strong></small><span
                                        class="badge bg-info float-end">
                                        <%= stats ? stats.totalSubmissions : 0 %>
                                    </span></div>
                                <div class="mb-2"><small><strong>Pending Grading:</strong></small><span
                                        class="badge bg-warning float-end">
                                        <%= stats ? stats.pendingSubmissions : 0 %>
                                    </span></div>
                            </div>
                        </div>
                    </div>

                    <!-- Main Content -->
                    <div class="col-md-9">
                        <!-- Page Header -->
                        <div class="d-flex justify-content-between align-items-center mb-4">
                            <h2><i class="fas fa-tasks me-2"></i>
                                <%= title %>
                            </h2>
                            <div>
                                <a href="/teacher/class-works/create" class="btn btn-success">
                                    <i class="fas fa-plus me-1"></i> Create Class Work
                                </a>
                                <a href="/teacher/live-sessions" class="btn btn-outline-primary ms-2">
                                    <i class="fas fa-video me-1"></i> Live Sessions
                                </a>
                            </div>
                        </div>

                        <!-- Class Works Grid -->
                        <div class="row">
                            <% if (classWorks && classWorks.length> 0) { %>
                                <% classWorks.forEach(classWork=> {
                                    const submissionCount = classWork._count ? classWork._count.submissions : 0;
                                    const pendingSubmissions = classWork.submissions ? classWork.submissions.filter(s =>
                                    s.status === 'submitted').length : 0;
                                    const gradedSubmissions = classWork.submissions ? classWork.submissions.filter(s =>
                                    s.score !== null).length : 0;
                                    const isActive = classWork.isActive && (!classWork.dueDate || new
                                    Date(classWork.dueDate) > new Date());
                                    %>
                                    <div class="col-md-6 col-lg-4 mb-4">
                                        <div class="card classwork-card h-100">
                                            <div class="card-body">
                                                <div class="d-flex justify-content-between align-items-start mb-2">
                                                    <div>
                                                        <span class="badge type-<%= classWork.type %> type-badge">
                                                            <%= classWork.type.charAt(0).toUpperCase() +
                                                                classWork.type.slice(1) %>
                                                        </span>
                                                        <% if (classWork.isActive) { %>
                                                            <span class="badge bg-success ms-1">Active</span>
                                                            <% } else { %>
                                                                <span class="badge bg-secondary ms-1">Inactive</span>
                                                                <% } %>
                                                    </div>
                                                    <div class="dropdown">
                                                        <button class="btn btn-sm btn-outline-secondary dropdown-toggle"
                                                            type="button" data-bs-toggle="dropdown">
                                                            <i class="fas fa-ellipsis-v"></i>
                                                        </button>
                                                        <ul class="dropdown-menu">
                                                            <li>
                                                                <a class="dropdown-item"
                                                                    href="/teacher/class-works/<%= classWork.id %>/submissions">
                                                                    <i class="fas fa-eye me-2"></i>View Submissions
                                                                </a>
                                                            </li>
                                                            <li>
                                                                <a class="dropdown-item"
                                                                    href="/teacher/class-works/<%= classWork.id %>/edit">
                                                                    <i class="fas fa-edit me-2"></i>Edit
                                                                </a>
                                                            </li>
                                                            <li>
                                                                <hr class="dropdown-divider">
                                                            </li>
                                                            <li>
                                                                <button class="dropdown-item text-danger"
                                                                    onclick="deleteClassWork('<%= classWork.id %>')">
                                                                    <i class="fas fa-trash me-2"></i>Delete
                                                                </button>
                                                            </li>
                                                        </ul>
                                                    </div>
                                                </div>

                                                <h5 class="card-title">
                                                    <%= classWork.title %>
                                                </h5>
                                                <% if (classWork.description) { %>
                                                    <p class="card-text text-muted small mb-3">
                                                        <%= classWork.description.length> 100 ?
                                                            classWork.description.substring(0, 100) + '...' :
                                                            classWork.description %>
                                                    </p>
                                                    <% } %>

                                                        <!-- Class Info -->
                                                        <div class="mb-3">
                                                            <% if (classWork.class) { %>
                                                                <small class="text-muted d-block">
                                                                    <i class="fas fa-chalkboard me-1"></i>
                                                                    <%= classWork.class.name %>
                                                                </small>
                                                                <% } %>
                                                                    <% if (classWork.dueDate) { %>
                                                                        <small class="text-muted">
                                                                            <i class="fas fa-calendar me-1"></i>
                                                                            Due: <%= new
                                                                                Date(classWork.dueDate).toLocaleDateString()
                                                                                %>
                                                                        </small>
                                                                        <% } %>
                                                        </div>

                                                        <!-- Question Preview -->
                                                        <% if (classWork.questions && Array.isArray(classWork.questions)
                                                            && classWork.questions.length> 0) { %>
                                                            <div class="mb-3">
                                                                <small class="text-muted d-block mb-1">
                                                                    <i class="fas fa-question-circle me-1"></i>
                                                                    Questions:
                                                                </small>
                                                                <div
                                                                    class="question-preview card card-body bg-light p-2">
                                                                    <% classWork.questions.slice(0, 2).forEach((q,
                                                                        idx)=> { %>
                                                                        <div class="mb-1">
                                                                            <small><strong>Q<%= idx + 1 %>:</strong>
                                                                                <%= q.question.length> 50 ?
                                                                                    q.question.substring(0, 50) + '...'
                                                                                    : q.question %>
                                                                            </small>
                                                                        </div>
                                                                        <% }); %>
                                                                            <% if (classWork.questions.length> 2) { %>
                                                                                <small class="text-muted">... and <%=
                                                                                        classWork.questions.length - 2
                                                                                        %> more</small>
                                                                                <% } %>
                                                                </div>
                                                            </div>
                                                            <% } %>

                                                                <!-- Submission Stats -->
                                                                <div class="mb-3">
                                                                    <div
                                                                        class="d-flex justify-content-between align-items-center">
                                                                        <div class="submission-count">
                                                                            <small
                                                                                class="text-muted">Submissions:</small>
                                                                            <div>
                                                                                <span class="badge bg-info">
                                                                                    <%= submissionCount %>
                                                                                </span>
                                                                                <small class="text-muted ms-2">
                                                                                    (<%= gradedSubmissions %> graded,
                                                                                        <%= pendingSubmissions %>
                                                                                            pending)
                                                                                </small>
                                                                            </div>
                                                                        </div>
                                                                        <div>
                                                                            <span class="badge bg-dark">
                                                                                <%= classWork.points || 100 %> points
                                                                            </span>
                                                                        </div>
                                                                    </div>

                                                                    <% if (submissionCount> 0) { %>
                                                                        <div class="progress mt-2" style="height: 5px;">
                                                                            <div class="progress-bar bg-success"
                                                                                style="width: <%= (gradedSubmissions / submissionCount * 100) %>%">
                                                                            </div>
                                                                        </div>
                                                                        <small class="text-muted">
                                                                            <%= Math.round(gradedSubmissions /
                                                                                submissionCount * 100) %>% graded
                                                                        </small>
                                                                        <% } %>
                                                                </div>

                                                                <!-- Action Buttons -->
                                                                <div
                                                                    class="d-flex justify-content-between align-items-center">
                                                                    <div>
                                                                        <% if (submissionCount> 0) { %>
                                                                            <a href="/teacher/class-works/<%= classWork.id %>/submissions"
                                                                                class="btn btn-sm btn-primary">
                                                                                <i
                                                                                    class="fas fa-graduation-cap me-1"></i>
                                                                                Grade
                                                                            </a>
                                                                            <% } else { %>
                                                                                <span class="text-muted small">No
                                                                                    submissions yet</span>
                                                                                <% } %>
                                                                    </div>
                                                                    <div>
                                                                        <a href="/teacher/class-works/<%= classWork.id %>/submissions"
                                                                            class="btn btn-sm btn-outline-secondary">
                                                                            <i class="fas fa-list me-1"></i> Details
                                                                        </a>
                                                                    </div>
                                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <% }); %>
                                        <% } else { %>
                                            <div class="col-12">
                                                <div class="card">
                                                    <div class="card-body text-center py-5">
                                                        <i class="fas fa-tasks fa-3x text-muted mb-3"></i>
                                                        <h4>No Class Works Yet</h4>
                                                        <p class="text-muted">Create interactive quizzes, assignments,
                                                            and discussions for your students.</p>
                                                        <a href="/teacher/class-works/create" class="btn btn-success">
                                                            <i class="fas fa-plus me-1"></i> Create Your First Class
                                                            Work
                                                        </a>
                                                    </div>
                                                </div>
                                            </div>
                                            <% } %>
                        </div>
                    </div>
                </div>
        </div>

        <!-- Delete Confirmation Modal -->
        <div class="modal fade" id="deleteClassWorkModal" tabindex="-1">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Confirm Delete</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <p>Are you sure you want to delete this class work? This action cannot be undone.</p>
                        <p class="text-danger"><strong>Warning:</strong> All submissions will also be deleted.</p>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="button" class="btn btn-danger" id="confirmClassWorkDeleteBtn">Delete</button>
                    </div>
                </div>
            </div>
        </div>

        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
        <script>
            let classWorkToDelete = null;

            // Delete class work
            function deleteClassWork(classWorkId) {
                classWorkToDelete = classWorkId;
                const modal = new bootstrap.Modal(document.getElementById('deleteClassWorkModal'));
                modal.show();
            }

            // Confirm delete
            document.getElementById('confirmClassWorkDeleteBtn').addEventListener('click', function () {
                if (classWorkToDelete) {
                    fetch(`/teacher/class-works/${classWorkToDelete}`, {
                        method: 'DELETE',
                        headers: {
                            'Content-Type': 'application/json'
                        }
                    })
                        .then(response => response.json())
                        .then(data => {
                            if (data.success) {
                                alert('Class work deleted successfully');
                                location.reload();
                            } else {
                                alert('Error deleting class work: ' + data.message);
                            }
                        })
                        .catch(error => {
                            console.error('Error:', error);
                            alert('Error deleting class work');
                        });

                    const modal = bootstrap.Modal.getInstance(document.getElementById('deleteClassWorkModal'));
                    modal.hide();
                }
            });
        </script>
</body>

</html>