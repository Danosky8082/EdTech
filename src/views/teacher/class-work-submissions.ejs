<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Submissions for <%= classWork.title %> - EdTech</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <style>
        .submission-card {
            border-left: 4px solid #20c997;
            transition: all 0.3s ease;
        }

        .submission-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
        }

        .status-badge {
            font-size: 0.75rem;
            padding: 4px 10px;
        }

        .status-submitted {
            background-color: #ffc107;
            color: #000;
        }

        .status-graded {
            background-color: #198754;
            color: white;
        }

        .status-late {
            background-color: #dc3545;
            color: white;
        }

        .grade-input {
            max-width: 100px;
        }

        .student-avatar {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            object-fit: cover;
        }

        .attachment-preview {
            max-height: 200px;
            overflow-y: auto;
        }

        .question-item {
            border-bottom: 1px solid #eee;
            padding: 10px 0;
        }

        .answer-box {
            background-color: #f8f9fa;
            border-radius: 5px;
            padding: 10px;
            margin-top: 5px;
        }

        .grade-form {
            background-color: #f8f9fa;
            border-radius: 8px;
            padding: 15px;
        }
    </style>
</head>

<body>
    <%- include('../partials/navbar') %>

        <div class="container mt-4">
            <%- include('../partials/alerts') %>

                <!-- School info banner -->
                <div class="alert alert-info mb-4">
                    <i class="fas fa-school me-2"></i>
                    <strong>School:</strong>
                    <%= userSchool || 'All Schools' %>
                        <% if (isSuperAdmin) { %>
                            <span class="badge bg-warning ms-2">Super Admin</span>
                            <% } %>
                </div>

                <!-- Back button -->
                <div class="mb-4">
                    <a href="/teacher/class-works" class="btn btn-outline-secondary">
                        <i class="fas fa-arrow-left me-1"></i> Back to Class Works
                    </a>
                </div>

                <!-- Class Work Header -->
                <div class="card mb-4">
                    <div class="card-header bg-primary text-white">
                        <h3 class="mb-0">
                            <i class="fas fa-tasks me-2"></i>
                            <%= classWork.title %>
                        </h3>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-8">
                                <% if (classWork.description) { %>
                                    <p class="mb-3">
                                        <%= classWork.description %>
                                    </p>
                                    <% } %>

                                        <div class="row mb-3">
                                            <div class="col-md-4">
                                                <small class="text-muted d-block">Type:</small>
                                                <span class="badge bg-info">
                                                    <%= classWork.type.charAt(0).toUpperCase() + classWork.type.slice(1)
                                                        %>
                                                </span>
                                            </div>
                                            <div class="col-md-4">
                                                <small class="text-muted d-block">Points:</small>
                                                <strong>
                                                    <%= classWork.points || 100 %> points
                                                </strong>
                                            </div>
                                            <div class="col-md-4">
                                                <small class="text-muted d-block">Due Date:</small>
                                                <% if (classWork.dueDate) { %>
                                                    <strong>
                                                        <%= new Date(classWork.dueDate).toLocaleDateString() %>
                                                    </strong>
                                                    <% } else { %>
                                                        <span class="text-muted">No due date</span>
                                                        <% } %>
                                            </div>
                                        </div>

                                        <% if (classWork.class) { %>
                                            <div class="mb-3">
                                                <small class="text-muted d-block">Class:</small>
                                                <strong><i class="fas fa-chalkboard me-1"></i>
                                                    <%= classWork.class.name %>
                                                </strong>
                                            </div>
                                            <% } %>
                            </div>

                            <div class="col-md-4">
                                <div class="card">
                                    <div class="card-body">
                                        <h5 class="card-title">Submission Stats</h5>
                                        <div class="mb-2">
                                            <small>Total Students:</small>
                                            <span class="badge bg-dark float-end">
                                                <%= totalStudents || 0 %>
                                            </span>
                                        </div>
                                        <div class="mb-2">
                                            <small>Submitted:</small>
                                            <span class="badge bg-success float-end">
                                                <%= submissions ? submissions.length : 0 %>
                                            </span>
                                        </div>
                                        <div class="mb-2">
                                            <small>Graded:</small>
                                            <span class="badge bg-info float-end">
                                                <%= gradedCount || 0 %>
                                            </span>
                                        </div>
                                        <div class="mb-2">
                                            <small>Pending:</small>
                                            <span class="badge bg-warning float-end">
                                                <%= pendingCount || 0 %>
                                            </span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- ========= UPDATED: QUESTIONS PREVIEW ========= -->
                        <% if (classWork.questions && Array.isArray(classWork.questions) && classWork.questions.length>
                            0) { %>
                            <div class="mt-4">
                                <h5><i class="fas fa-question-circle me-2"></i> Questions</h5>
                                <div class="card">
                                    <div class="card-body">
                                        <% classWork.questions.forEach((question, index)=> { %>
                                            <div class="question-item">
                                                <div class="d-flex justify-content-between align-items-start">
                                                    <div class="flex-grow-1">
                                                        <h6>Q<%= index + 1 %>: <%= question.question %>
                                                        </h6>

                                                        <% if (question.type==='multiple_choice' && question.options &&
                                                            question.options.length) { %>
                                                            <div class="mt-2">
                                                                <small class="text-muted">Options:</small>
                                                                <ul class="list-unstyled ms-3">
                                                                    <% question.options.forEach((opt, optIndex)=> { %>
                                                                        <li class="mb-1">
                                                                            <%= String.fromCharCode(65 + optIndex) %>.
                                                                                <%= opt.text %>
                                                                                    <% if (opt.isCorrect) { %>
                                                                                        <span
                                                                                            class="badge bg-success ms-2">
                                                                                            <i class="fas fa-check"></i>
                                                                                            Correct
                                                                                        </span>
                                                                                        <% } %>
                                                                        </li>
                                                                        <% }); %>
                                                                </ul>
                                                            </div>
                                                            <% } else if (question.type==='true_false' ) { %>
                                                                <div class="mt-2">
                                                                    <small class="text-muted">Correct Answer:</small>
                                                                    <span class="badge bg-success ms-2">
                                                                        <% const trueOption=question.options.find(o=>
                                                                            o.text.toLowerCase() === 'true');
                                                                            const falseOption = question.options.find(o
                                                                            => o.text.toLowerCase() === 'false');
                                                                            %>
                                                                            <%= trueOption && trueOption.isCorrect
                                                                                ? 'True' : 'False' %>
                                                                    </span>
                                                                </div>
                                                                <% } else if (question.type==='short_answer' ) { %>
                                                                    <div class="mt-2">
                                                                        <small class="text-muted">Short answer
                                                                            question</small>
                                                                    </div>
                                                                    <% } %>
                                                    </div>
                                                    <div class="text-end">
                                                        <small class="text-muted">
                                                            <%= question.points || 0 %> points
                                                        </small>
                                                    </div>
                                                </div>
                                            </div>
                                            <% }); %>
                                    </div>
                                </div>
                            </div>
                            <% } %>
                                <!-- ========= END UPDATED QUESTIONS PREVIEW ========= -->

                    </div>
                </div>

                <!-- Submissions List -->
                <div class="card">
                    <div class="card-header">
                        <h4 class="mb-0">
                            <i class="fas fa-file-upload me-2"></i> Student Submissions
                        </h4>
                    </div>
                    <div class="card-body">
                        <% if (submissions && submissions.length> 0) { %>
                            <div class="table-responsive">
                                <table class="table table-hover">
                                    <thead>
                                        <tr>
                                            <th>Student</th>
                                            <th>Submitted On</th>
                                            <th>Status</th>
                                            <th>Score</th>
                                            <th>Grade</th>
                                            <th>Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <% submissions.forEach(submission=> {
                                            const isLate = classWork.dueDate && submission.submittedAt &&
                                            new Date(submission.submittedAt) > new Date(classWork.dueDate);
                                            %>
                                            <tr>
                                                <td>
                                                    <div class="d-flex align-items-center">
                                                        <% if (submission.student && submission.student.avatar) { %>
                                                            <img src="<%= submission.student.avatar.startsWith('/') ? submission.student.avatar : '/' + submission.student.avatar %>"
                                                                alt="<%= submission.student.firstName %>"
                                                                class="student-avatar me-2"
                                                                onerror="this.onerror=null; this.src='/images/default-profile.png'">
                                                            <% } else { %>
                                                                <div
                                                                    class="student-avatar bg-secondary d-flex align-items-center justify-content-center me-2">
                                                                    <i class="fas fa-user text-white"></i>
                                                                </div>
                                                                <% } %>
                                                                    <div>
                                                                        <strong>
                                                                            <%= submission.student ?
                                                                                submission.student.firstName + ' ' +
                                                                                submission.student.lastName
                                                                                : 'Unknown Student' %>
                                                                        </strong>
                                                                        <br>
                                                                        <small class="text-muted">
                                                                            <%= submission.student ?
                                                                                submission.student.email : '' %>
                                                                        </small>
                                                                    </div>
                                                    </div>
                                                </td>
                                                <td>
                                                    <% if (submission.submittedAt) { %>
                                                        <%= new Date(submission.submittedAt).toLocaleDateString() %>
                                                            <br>
                                                            <small class="text-muted">
                                                                <%= new
                                                                    Date(submission.submittedAt).toLocaleTimeString() %>
                                                            </small>
                                                            <% } else { %>
                                                                <span class="text-muted">Not submitted</span>
                                                                <% } %>
                                                </td>
                                                <td>
                                                    <% if (submission.status==='graded' ) { %>
                                                        <span class="badge status-graded status-badge">Graded</span>
                                                        <% } else if (submission.status==='submitted' ) { %>
                                                            <span
                                                                class="badge status-submitted status-badge">Submitted</span>
                                                            <% } else { %>
                                                                <span class="badge bg-secondary status-badge">Not
                                                                    Submitted</span>
                                                                <% } %>

                                                                    <% if (isLate) { %>
                                                                        <br>
                                                                        <small class="badge bg-danger mt-1">Late</small>
                                                                        <% } %>
                                                </td>
                                                <td>
                                                    <% if (submission.score !==null && submission.score !==undefined) {
                                                        %>
                                                        <strong>
                                                            <%= submission.score %> / <%= classWork.points || 100 %>
                                                        </strong>
                                                        <br>
                                                        <small class="text-muted">
                                                            <%= ((submission.score / (classWork.points || 100)) *
                                                                100).toFixed(1) %>%
                                                        </small>
                                                        <% } else { %>
                                                            <span class="text-muted">-</span>
                                                            <% } %>
                                                </td>
                                                <td>
                                                    <% if (submission.grade) { %>
                                                        <span class="badge bg-info">
                                                            <%= submission.grade %>
                                                        </span>
                                                        <% } %>
                                                </td>
                                                <td>
                                                    <button class="btn btn-sm btn-outline-primary"
                                                        onclick="viewSubmission('<%= submission.id %>')"
                                                        data-bs-toggle="modal" data-bs-target="#viewSubmissionModal">
                                                        <i class="fas fa-eye"></i> View
                                                    </button>
                                                    <% if (submission.status==='submitted' ) { %>
                                                        <button class="btn btn-sm btn-success mt-1"
                                                            onclick="gradeSubmission('<%= submission.id %>', '<%= submission.student ? submission.student.firstName + ' ' + submission.student.lastName : 'Student' %>')"
                                                            data-bs-toggle="modal"
                                                            data-bs-target="#gradeSubmissionModal">
                                                            <i class="fas fa-graduation-cap"></i> Grade
                                                        </button>
                                                        <% } %>
                                                </td>
                                            </tr>
                                            <% }); %>
                                    </tbody>
                                </table>
                            </div>
                            <% } else { %>
                                <div class="text-center py-5">
                                    <i class="fas fa-inbox fa-3x text-muted mb-3"></i>
                                    <h4>No Submissions Yet</h4>
                                    <p class="text-muted">Students haven't submitted their work for this assignment yet.
                                    </p>
                                </div>
                                <% } %>
                    </div>
                </div>
        </div>

        <!-- View Submission Modal -->
        <div class="modal fade" id="viewSubmissionModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-lg">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="viewSubmissionModalLabel">Submission Details</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body" id="viewSubmissionModalBody">
                        <!-- Content will be loaded dynamically -->
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Grade Submission Modal -->
        <div class="modal fade" id="gradeSubmissionModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="gradeSubmissionModalLabel">Grade Submission</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <form id="gradeForm">
                        <div class="modal-body">
                            <div id="gradeModalContent">
                                <!-- Content will be loaded dynamically -->
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                            <button type="submit" class="btn btn-success">Save Grade</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
        <script>
            let currentSubmissionId = null;
            let currentStudentName = null;

            // View submission details
            async function viewSubmission(submissionId) {
                try {
                    const response = await fetch(`/teacher/submissions/${submissionId}`);
                    const data = await response.json();

                    if (data.success) {
                        const submission = data.submission;
                        let html = `
                        <div class="submission-details">
                            <h6>Student: ${submission.student ? submission.student.firstName + ' ' + submission.student.lastName : 'Unknown'}</h6>
                            <p class="text-muted">Submitted: ${new Date(submission.submittedAt).toLocaleString()}</p>
                            <p>Status: <span class="badge ${submission.status === 'graded' ? 'bg-success' : 'bg-warning'}">${submission.status}</span></p>
                    `;

                        if (submission.score !== null) {
                            html += `<p>Score: <strong>${submission.score} / ${data.classWork.points || 100}</strong> (${((submission.score / (data.classWork.points || 100)) * 100).toFixed(1)}%)</p>`;
                        }

                        if (submission.feedback) {
                            html += `<div class="mt-3"><strong>Feedback:</strong><p>${submission.feedback}</p></div>`;
                        }

                        // Show answers if it's a quiz
                        if (submission.answers && Array.isArray(submission.answers) && submission.answers.length > 0) {
                            html += `<div class="mt-4"><h6>Answers:</h6>`;
                            submission.answers.forEach((answer, index) => {
                                html += `
                                <div class="answer-box mb-3">
                                    <strong>Q${index + 1}:</strong> ${data.classWork.questions[index] ? data.classWork.questions[index].question : 'Question not found'}
                                    <div class="mt-2">
                                        <strong>Student's Answer:</strong> ${answer.answer || 'No answer'}
                                    </div>
                                    <div class="mt-1">
                                        <strong>Points Awarded:</strong> ${answer.pointsAwarded || 0} / ${data.classWork.questions[index] ? data.classWork.questions[index].points || 0 : 0}
                                    </div>
                                </div>
                            `;
                            });
                            html += `</div>`;
                        }

                        // Show attachments if any
                        if (submission.attachments && Array.isArray(submission.attachments) && submission.attachments.length > 0) {
                            html += `<div class="mt-4"><h6>Attachments:</h6><div class="attachment-preview">`;
                            submission.attachments.forEach(attachment => {
                                html += `<div class="mb-2"><a href="${attachment.url}" target="_blank">${attachment.filename}</a></div>`;
                            });
                            html += `</div></div>`;
                        }

                        html += `</div>`;
                        document.getElementById('viewSubmissionModalBody').innerHTML = html;
                    } else {
                        document.getElementById('viewSubmissionModalBody').innerHTML = `
                        <div class="alert alert-danger">
                            Error loading submission: ${data.message}
                        </div>
                    `;
                    }
                } catch (error) {
                    console.error('Error:', error);
                    document.getElementById('viewSubmissionModalBody').innerHTML = `
                    <div class="alert alert-danger">
                        Error loading submission details.
                    </div>
                `;
                }
            }

            // Grade submission
            function gradeSubmission(submissionId, studentName) {
                currentSubmissionId = submissionId;
                currentStudentName = studentName;

                document.getElementById('gradeSubmissionModalLabel').textContent = `Grade: ${studentName}`;

                document.getElementById('gradeModalContent').innerHTML = `
                <div class="grade-form">
                    <div class="mb-3">
                        <label for="scoreInput" class="form-label">
                            Score (out of <%= classWork.points || 100 %>)
                        </label>
                        <input type="number" 
                               class="form-control grade-input" 
                               id="scoreInput" 
                               name="score" 
                               min="0" 
                               max="<%= classWork.points || 100 %>" 
                               step="0.5" 
                               required>
                    </div>
                    <div class="mb-3">
                        <label for="gradeInput" class="form-label">Grade (Optional)</label>
                        <select class="form-select" id="gradeInput" name="grade">
                            <option value="">Select Grade</option>
                            <option value="A+">A+</option>
                            <option value="A">A</option>
                            <option value="A-">A-</option>
                            <option value="B+">B+</option>
                            <option value="B">B</option>
                            <option value="B-">B-</option>
                            <option value="C+">C+</option>
                            <option value="C">C</option>
                            <option value="C-">C-</option>
                            <option value="D">D</option>
                            <option value="F">F</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label for="feedbackInput" class="form-label">Feedback (Optional)</label>
                        <textarea class="form-control" id="feedbackInput" name="feedback" rows="3"></textarea>
                    </div>
                </div>
            `;
            }

            // Handle grade form submission
            document.getElementById('gradeForm').addEventListener('submit', async function (e) {
                e.preventDefault();

                const score = document.getElementById('scoreInput').value;
                const grade = document.getElementById('gradeInput').value;
                const feedback = document.getElementById('feedbackInput').value;

                try {
                    const response = await fetch(`/teacher/submissions/${currentSubmissionId}/grade`, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                        },
                        body: JSON.stringify({
                            score: parseFloat(score),
                            grade: grade,
                            feedback: feedback
                        })
                    });

                    const data = await response.json();

                    if (data.success) {
                        alert('Grade submitted successfully!');
                        location.reload();
                    } else {
                        alert('Error: ' + data.message);
                    }
                } catch (error) {
                    console.error('Error:', error);
                    alert('Error submitting grade. Please try again.');
                }
            });

            // Bulk grade feature (if needed)
            function bulkGrade() {
                alert('Bulk grading feature coming soon!');
            }
        </script>
</body>

</html>