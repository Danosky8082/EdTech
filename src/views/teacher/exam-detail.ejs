<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= title %> - EdTech
    </title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
</head>

<body>
    <%- include('../partials/navbar') %>

        <div class="container mt-4">
            <%- include('../partials/alerts') %>

                <div class="row">
                    <div class="col-lg-8">
                        <div class="card">
                            <div class="card-header bg-primary text-white">
                                <div class="d-flex justify-content-between align-items-center">
                                    <h4 class="mb-0">Exam Details</h4>
                                    <a href="/teacher/exams" class="btn btn-light btn-sm">
                                        <i class="fas fa-arrow-left me-1"></i> Back to Exams
                                    </a>
                                </div>
                            </div>
                            <div class="card-body">
                                <div class="mb-4">
                                    <h3>
                                        <%= exam.title %>
                                    </h3>
                                    <p class="text-muted">
                                        <%= exam.description || 'No description' %>
                                    </p>

                                    <div class="row mt-4">
                                        <div class="col-md-6">
                                            <div class="mb-3">
                                                <strong><i class="fas fa-calendar me-2"></i>Date & Time:</strong>
                                                <div>
                                                    <%= new Date(exam.date).toLocaleString() %>
                                                </div>
                                            </div>
                                            <div class="mb-3">
                                                <strong><i class="fas fa-clock me-2"></i>Duration:</strong>
                                                <div>
                                                    <%= exam.duration %> minutes
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="mb-3">
                                                <strong><i class="fas fa-chalkboard me-2"></i>Class:</strong>
                                                <div>
                                                    <%= exam.class.name %>
                                                </div>
                                            </div>
                                            <div class="mb-3">
                                                <strong><i class="fas fa-star me-2"></i>Total Marks:</strong>
                                                <div>
                                                    <%= exam.totalMarks %>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Questions Section -->
                                <div class="mb-4">
                                    <h5><i class="fas fa-question-circle me-2"></i>Questions</h5>
                                    <% if (exam.questions && exam.questions.length> 0) { %>
                                        <div class="list-group">
                                            <% exam.questions.forEach((question, index)=> { %>
                                                <div class="list-group-item mb-2">
                                                    <div class="d-flex justify-content-between align-items-start">
                                                        <div class="me-3">
                                                            <strong>Q<%= index + 1 %>:</strong>
                                                            <%= question.question %>
                                                                <span class="badge bg-secondary ms-2">
                                                                    <%= question.type %>
                                                                </span>
                                                                <span class="badge bg-success ms-1">
                                                                    <%= question.points || 1 %> points
                                                                </span>
                                                        </div>
                                                    </div>

                                                    <% if (question.type==='multiple_choice' && question.options) { %>
                                                        <div class="mt-2 ms-4">
                                                            <strong>Options:</strong>
                                                            <ul class="mb-0">
                                                                <% question.options.forEach((option, optIndex)=> { %>
                                                                    <li>
                                                                        <%= option.text %>
                                                                            <% if (option.isCorrect) { %>
                                                                                <span
                                                                                    class="badge bg-success ms-2">Correct</span>
                                                                                <% } %>
                                                                    </li>
                                                                    <% }) %>
                                                            </ul>
                                                        </div>
                                                        <% } %>
                                                </div>
                                                <% }) %>
                                        </div>
                                        <% } else { %>
                                            <div class="alert alert-info">No questions added to this exam yet.</div>
                                            <% } %>
                                </div>

                                <!-- Attempts Section -->
                                <div class="mb-4">
                                    <h5><i class="fas fa-users me-2"></i>Student Attempts</h5>
                                    <% if (exam.attempts && exam.attempts.length> 0) { %>
                                        <div class="table-responsive">
                                            <table class="table table-striped">
                                                <thead>
                                                    <tr>
                                                        <th>Student</th>
                                                        <th>Score</th>
                                                        <th>Submitted At</th>
                                                        <th>Actions</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    <% exam.attempts.forEach(attempt=> { %>
                                                        <tr>
                                                            <td>
                                                                <%= attempt.student.user.firstName %>
                                                                    <%= attempt.student.user.lastName %>
                                                            </td>
                                                            <td>
                                                                <span
                                                                    class="badge bg-<%= attempt.score >= (exam.totalMarks * 0.5) ? 'success' : 'danger' %>">
                                                                    <%= attempt.score %> / <%= exam.totalMarks %>
                                                                </span>
                                                            </td>
                                                            <td>
                                                                <%= attempt.submittedAt ? new
                                                                    Date(attempt.submittedAt).toLocaleString()
                                                                    : 'Not submitted' %>
                                                            </td>
                                                            <td>
                                                                <button class="btn btn-sm btn-primary">
                                                                    <i class="fas fa-eye me-1"></i> View
                                                                </button>
                                                            </td>
                                                        </tr>
                                                        <% }) %>
                                                </tbody>
                                            </table>
                                        </div>
                                        <% } else { %>
                                            <div class="alert alert-warning">No students have attempted this exam yet.
                                            </div>
                                            <% } %>
                                </div>
                            </div>
                            <div class="card-footer">
                                <div class="d-flex justify-content-between">
                                    <div>
                                        <span class="text-muted">
                                            Created: <%= exam.createdAt ? new Date(exam.createdAt).toLocaleDateString()
                                                : 'Unknown' %>
                                        </span>
                                    </div>
                                    <div>
                                        <a href="/teacher/exams" class="btn btn-secondary me-2">Back</a>
                                        <a href="/teacher/exam/<%= exam.id %>/results" class="btn btn-primary">
                                            <i class="fas fa-chart-bar me-1"></i> View Results
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Right Sidebar -->
                    <div class="col-lg-4">
                        <div class="card mb-4">
                            <div class="card-header bg-info text-white">
                                <h5 class="mb-0">Exam Statistics</h5>
                            </div>
                            <div class="card-body">
                                <div class="mb-3">
                                    <strong>Total Questions:</strong>
                                    <span class="float-end">
                                        <%= exam.questions ? exam.questions.length : 0 %>
                                    </span>
                                </div>
                                <div class="mb-3">
                                    <strong>Total Attempts:</strong>
                                    <span class="float-end">
                                        <%= exam.attempts ? exam.attempts.length : 0 %>
                                    </span>
                                </div>
                                <div class="mb-3">
                                    <strong>Average Score:</strong>
                                    <span class="float-end">
                                        <% let avgScore=0; if (exam.attempts && exam.attempts.length> 0) {
                                            const totalScore = exam.attempts.reduce((sum, a) => sum + a.score, 0);
                                            avgScore = Math.round(totalScore / exam.attempts.length);
                                            }
                                            %>
                                            <%= avgScore %> / <%= exam.totalMarks %>
                                    </span>
                                </div>
                                <div class="mb-3">
                                    <strong>Status:</strong>
                                    <span class="float-end">
                                        <span class="badge bg-<%= exam.isActive ? 'success' : 'secondary' %>">
                                            <%= exam.isActive ? 'Active' : 'Inactive' %>
                                        </span>
                                    </span>
                                </div>
                            </div>
                        </div>

                        <div class="card">
                            <div class="card-header bg-success text-white">
                                <h5 class="mb-0">Quick Actions</h5>
                            </div>
                            <div class="card-body">
                                <div class="d-grid gap-2">
                                    <a href="/teacher/exams" class="btn btn-outline-primary">
                                        <i class="fas fa-list me-1"></i> All Exams
                                    </a>
                                    <a href="/teacher/exam/<%= exam.id %>/results" class="btn btn-outline-success">
                                        <i class="fas fa-chart-bar me-1"></i> Detailed Results
                                    </a>
                                    <button class="btn btn-outline-warning">
                                        <i class="fas fa-edit me-1"></i> Edit Exam
                                    </button>
                                    <button class="btn btn-outline-danger">
                                        <i class="fas fa-trash me-1"></i> Delete Exam
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
        </div>

        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>