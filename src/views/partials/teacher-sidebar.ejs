<div class="profile-section text-center">
    <% if (user && user.avatar) { %>
        <img src="<%= user.avatar.startsWith('/') ? user.avatar : '/' + user.avatar %>" alt="Teacher Profile"
            class="profile-img mb-3 avatar-img" onerror="this.onerror=null; this.src='/images/default-profile.png'">
        <% } else { %>
            <img src="/images/default-profile.png" alt="Teacher Profile" class="profile-img mb-3">
            <% } %>

                <% if (user) { %>
                    <h4>
                        <%= user.firstName %>
                            <%= user.lastName %>
                    </h4>
                    <p class="welcome-text">Teacher Dashboard</p>
                    <span class="user-role">Teacher</span>
                    <div class="mt-2">
                        <small><i class="fas fa-school me-1"></i>
                            <%= userSchool || 'School' %>
                        </small>
                    </div>
                    <% } %>
</div>

<div class="card dashboard-card mb-4">
    <div class="card-header">
        <h5>Quick Actions</h5>
    </div>
    <div class="card-body">
        <a href="/teacher/dashboard" class="btn btn-outline-primary w-100 mb-2 action-btn">
            <i class="fas fa-home"></i> Dashboard
        </a>
        <a href="/teacher/class-works" class="btn btn-outline-primary w-100 mb-2 action-btn">
            <i class="fas fa-tasks"></i> Class Works
        </a>
        <a href="/teacher/live-sessions" class="btn btn-outline-info w-100 mb-2 action-btn">
            <i class="fas fa-video"></i> Live Sessions
        </a>
        <a href="/teacher/classes" class="btn btn-outline-secondary w-100 action-btn">
            <i class="fas fa-chalkboard"></i> My Classes
        </a>
    </div>
</div>

<!-- Account Status Card -->
<div class="card dashboard-card mb-4">
    <div class="card-header">
        <h5>Account Status</h5>
    </div>
    <div class="card-body">
        <div class="mb-3">
            <strong>Status:</strong>
            <span class="badge bg-success ms-2">ACTIVE</span>
        </div>
        <div class="mb-3">
            <strong>Role:</strong>
            <span class="badge bg-info ms-2">TEACHER</span>
        </div>
    </div>
</div>