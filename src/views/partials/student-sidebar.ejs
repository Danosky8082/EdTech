<div class="profile-section text-center">
    <% function cleanAvatarUrl(url) { if (!url) return null; if (url.startsWith('/https:/')) return
        url.replace('/https:/', 'https://' ); if (url.startsWith('/http:/')) return url.replace('/http:/', 'http://' );
        if (url.startsWith('http://') || url.startsWith('https://')) return url; return '/' + url; } const
        displayAvatar=cleanAvatarUrl(user.avatar); const fallbackAvatar='https://ui-avatars.com/api/?name=' +
        encodeURIComponent(user.firstName + ' ' + user.lastName) + '&background=6a11cb&color=fff&size=100' ; %>
        <% if (displayAvatar) { %>
            <img src="<%= displayAvatar %>" alt="Student Profile" class="profile-img mb-3 avatar-img"
                onerror="this.onerror=null; this.src='<%= fallbackAvatar %>'">
            <% } else { %>
                <img src="<%= fallbackAvatar %>" alt="Student Profile" class="profile-img mb-3">
                <% } %>

                    <h4>
                        <%= user.firstName %>
                            <%= user.lastName %>
                    </h4>
                    <p class="welcome-text">Welcome to your dashboard</p>
                    <span class="user-role">Student</span>
                    <div class="mt-2">
                        <small><i class="fas fa-school me-1"></i>
                            <%= userSchool || 'School' %>
                        </small>
                    </div>
</div>

<div class="card dashboard-card mb-4">
    <div class="card-header">
        <h5>Quick Actions</h5>
    </div>
    <div class="card-body">
        <a href="/student/dashboard" class="btn btn-outline-primary w-100 mb-2 action-btn">
            <i class="fas fa-home"></i> Dashboard
        </a>
        <a href="/student/classes" class="btn btn-outline-primary w-100 mb-2 action-btn">
            <i class="fas fa-tasks"></i> Class Works
        </a>
        <a href="/student/classes" class="btn btn-outline-info w-100 mb-2 action-btn">
            <i class="fas fa-video"></i> Live Sessions
        </a>
        <a href="/student/classes" class="btn btn-outline-secondary w-100 action-btn">
            <i class="fas fa-chalkboard"></i> View All Classes
        </a>
    </div>
</div>

<div class="card dashboard-card mb-4">
    <div class="card-header">
        <h5>Account Status</h5>
    </div>
    <div class="card-body">
        <div class="mb-3">
            <strong>Status:</strong>
            <span class="badge bg-success ms-2">ACTIVE</span>
        </div>
        <div class="mb-3">
            <strong>Role:</strong>
            <span class="badge bg-info ms-2">STUDENT</span>
        </div>
    </div>
</div>