<% var cssClass=localClass || 'profile-img' ; var
    sizeStyle='width:100px; height:100px; object-fit:cover; border-radius:50%; border:4px solid white;' ; %>
    <% if (avatarUrl) { %>
        <img src="<%= avatarUrl %>" alt="Profile" class="<%= cssClass %>" style="<%= sizeStyle %>"
            onerror="this.onerror=null; this.src='<%= fallbackAvatar %>'">
        <% } else { %>
            <img src="<%= fallbackAvatar %>" alt="Profile" class="<%= cssClass %>" style="<%= sizeStyle %>">
            <% } %>