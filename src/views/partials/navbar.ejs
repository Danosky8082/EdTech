                            <% } else if (userRole==='teacher' ) { %>
                                <li class="nav-item"><a class="nav-link" href="/teacher/classes"><i
                                            class="fas fa-chalkboard-teacher me-1"></i>My Classes</a></li>
                                <li class="nav-item"><a class="nav-link" href="/teacher/students"><i
                                            class="fas fa-user-graduate me-1"></i>My Students</a></li>
