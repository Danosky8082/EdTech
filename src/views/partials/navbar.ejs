    safeAdminInfo=adminInfo; } var safeUserAvatar='' ; if (safeUser.avatar) { safeUserAvatar=safeUser.avatar; } var
    safeUserFirstName='' ; if (safeUser.firstName) { safeUserFirstName=safeUser.firstName; } var safeUserLastName='' ;
    if (safeUser.lastName) { safeUserLastName=safeUser.lastName; } var safeUserSchoolProp='' ; if (safeUser.school) {
    safeUserSchoolProp=safeUser.school; } // --- Notifications --- var safeNotifications=[]; if (typeof
