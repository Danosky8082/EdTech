            left: auto !important;
            right: 0 !important;
            top: 100% !important;
            display: none !important;
            z-index: 1000;
        }

        .notification-dropdown.show {
            display: block !important;
        }

        .notification-header {
            padding: 12px 15px;
            border-bottom: 1px solid #f1f2f6;
            font-weight: 600;
            background-color: #f8f9fa;
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-top-left-radius: 10px;
            border-top-right-radius: 10px;
        }

        .notification-item {
            padding: 12px 15px;
            border-bottom: 1px solid #f1f2f6;
            display: flex;
            align-items: flex-start;
            transition: background-color 0.2s;
            cursor: pointer;
        }

        .notification-item:last-child {
            border-bottom: none;
        }

        .notification-item.unread {
            background-color: #f0f7ff;
            border-left: 4px solid #6a11cb;
        }

        .notification-item.read {
            opacity: 0.8;
        }

        .notification-item:hover {
            background-color: #e3f2fd;
            transform: translateX(5px);
        }

        .notification-icon {
            margin-right: 12px;
            font-size: 1.2rem;
            color: #6a11cb;
            flex-shrink: 0;
            margin-top: 2px;
        }

        .notification-content {
            flex: 1;
        }

        .notification-title {
            font-weight: 600;
            margin-bottom: 4px;
            font-size: 0.95rem;
            color: #2d3436;
        }

        .notification-message {
            font-size: 0.85rem;
            color: #636e72;
            margin-bottom: 4px;
            line-height: 1.4;
        }

        .notification-time {
            font-size: 0.75rem;
            color: #747d8c;
        }

        .notification-empty {
            padding: 30px 20px;
            text-align: center;
            color: #747d8c;
        }

        .notification-empty i {
            font-size: 2.5rem;
            margin-bottom: 10px;
            opacity: 0.5;
        }

        .mark-all-read {
            padding: 10px 15px;
            border-top: 1px solid #f1f2f6;
            text-align: center;
            cursor: pointer;
            background-color: #f8f9fa;
            font-weight: 500;
            color: #6a11cb;
            transition: background-color 0.2s;
            border-bottom-left-radius: 10px;
            border-bottom-right-radius: 10px;
        }

        .mark-all-read:hover {
            background-color: #e9ecef;
        }

        .notification-actions {
            display: flex;
            gap: 10px;
            margin-top: 8px;
        }

        .notification-action-btn {
            font-size: 0.75rem;
            padding: 2px 8px;
            border-radius: 4px;
            cursor: pointer;
        }

        .mark-as-read-btn {
            background-color: #6a11cb;
            color: white;
            border: none;
        }

        .mark-as-read-btn:hover {
            background-color: #5a0fb8;
        }

        .blink {
            animation: blink 2s infinite;
        }

        @keyframes blink {
            0% {
                opacity: 1;
            }

            50% {
                opacity: 0.5;
            }

            100% {
                opacity: 1;
            }
        }

        @media (max-width: 575.98px) {
            .notification-dropdown {
                width: 300px;
                margin-left: -100px;
            }
        }

        .nav-item.dropdown:hover .dropdown-menu {
            display: block;
            margin-top: 0;
        }

        .notification-dropdown.show {
            display: block;
            opacity: 1;
            transform: translateY(0);
        }
    </style>

