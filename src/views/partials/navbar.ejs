    unreadCount=0; for (var i=0; i < safeNotifications.length; i++) { var notif=safeNotifications[i]; if (notif &&
    notif.read===false) { unreadCount++; } } // --- Avatar URL --- var avatarUrl='' ; if (safeUserAvatar) { var
    startsHttp=false; if (safeUserAvatar.indexOf('http://')===0) { startsHttp=true; } else if
