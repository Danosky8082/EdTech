<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= title %> | School Management System
    </title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <style>
        .report-card {
            border-radius: 12px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.08);
            transition: transform 0.3s ease;
            border: none;
        }

        .report-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 8px 25px rgba(0, 0, 0, 0.12);
        }

        .chart-container {
            position: relative;
            height: 300px;
            width: 100%;
        }

        .stat-card {
            border-left: 4px solid;
            padding: 15px;
            background: #f8f9fa;
            border-radius: 8px;
            margin-bottom: 15px;
        }

        .income-stat {
            border-left-color: #28a745;
        }

        .expense-stat {
            border-left-color: #dc3545;
        }

        .balance-stat {
            border-left-color: #007bff;
        }

        .filter-section {
            background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
            border-radius: 10px;
            padding: 20px;
            margin-bottom: 25px;
        }

        .period-selector {
            display: flex;
            gap: 10px;
            justify-content: center;
            margin: 20px 0;
        }

        .period-btn {
            padding: 8px 20px;
            border: 2px solid #dee2e6;
            border-radius: 6px;
            background: white;
            cursor: pointer;
            transition: all 0.3s;
        }

        .period-btn.active {
            background: #007bff;
            color: white;
            border-color: #007bff;
        }

        .export-options {
            display: flex;
            gap: 10px;
            justify-content: flex-end;
            margin-top: 20px;
        }

        .insight-card {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            border-radius: 10px;
            padding: 20px;
            margin-bottom: 15px;
        }

        .trend-indicator {
            display: inline-flex;
            align-items: center;
            padding: 4px 10px;
            border-radius: 20px;
            font-size: 0.85rem;
            margin-left: 10px;
        }

        .trend-up {
            background: rgba(40, 167, 69, 0.2);
            color: #155724;
        }

        .trend-down {
            background: rgba(220, 53, 69, 0.2);
            color: #721c24;
        }

        .tab-content {
            padding: 20px 0;
        }

        .nav-tabs .nav-link {
            border-radius: 8px 8px 0 0;
            font-weight: 500;
        }

        .comparison-table th {
            background: #f8f9fa;
            font-weight: 600;
        }
    </style>
</head>

<body>
    <%- include('../partials/navbar') %>

        <div class="container-fluid py-4">
            <!-- Page Header -->
            <div class="row mb-4">
                <div class="col-12">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h2><i class="fas fa-chart-line me-2"></i>Financial Reports & Analytics</h2>
                            <p class="text-muted mb-0">Comprehensive financial analysis and insights</p>
                        </div>
                        <div>
                            <a href="/accountant/dashboard" class="btn btn-outline-secondary me-2">
                                <i class="fas fa-arrow-left me-1"></i> Back to Dashboard
                            </a>
                            <div class="dropdown d-inline">
                                <button class="btn btn-primary dropdown-toggle" type="button" id="exportDropdown"
                                    data-bs-toggle="dropdown">
                                    <i class="fas fa-download me-1"></i> Export Report
                                </button>
                                <ul class="dropdown-menu">
                                    <li><a class="dropdown-item" href="#" onclick="exportPDF()"><i
                                                class="fas fa-file-pdf me-2"></i> PDF Report</a></li>
                                    <li><a class="dropdown-item" href="#" onclick="exportExcel()"><i
                                                class="fas fa-file-excel me-2"></i> Excel Report</a></li>
                                    <li><a class="dropdown-item" href="#" onclick="exportCSV()"><i
                                                class="fas fa-file-csv me-2"></i> CSV Data</a></li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Quick Stats -->
            <div class="row mb-4">
                <div class="col-md-3 mb-3">
                    <div class="card report-card">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <h6 class="card-subtitle mb-2 text-muted">Total Revenue</h6>
                                    <h3 class="card-title text-success" id="totalRevenue">₦0.00</h3>
                                    <p class="card-text">
                                        <span class="trend-indicator trend-up" id="revenueTrend">
                                            <i class="fas fa-arrow-up me-1"></i> 0%
                                        </span>
                                    </p>
                                </div>
                                <div class="display-4 text-success opacity-25">
                                    <i class="fas fa-money-bill-wave"></i>
                                </div>
                            </div>
                            <small class="text-muted">Last 30 days</small>
                        </div>
                    </div>
                </div>
                <div class="col-md-3 mb-3">
                    <div class="card report-card">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <h6 class="card-subtitle mb-2 text-muted">Total Expenses</h6>
                                    <h3 class="card-title text-danger" id="totalExpenses">₦0.00</h3>
                                    <p class="card-text">
                                        <span class="trend-indicator trend-down" id="expenseTrend">
                                            <i class="fas fa-arrow-down me-1"></i> 0%
                                        </span>
                                    </p>
                                </div>
                                <div class="display-4 text-danger opacity-25">
                                    <i class="fas fa-receipt"></i>
                                </div>
                            </div>
                            <small class="text-muted">Last 30 days</small>
                        </div>
                    </div>
                </div>
                <div class="col-md-3 mb-3">
                    <div class="card report-card">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <h6 class="card-subtitle mb-2 text-muted">Net Profit</h6>
                                    <h3 class="card-title text-primary" id="netProfit">₦0.00</h3>
                                    <p class="card-text">
                                        <span class="trend-indicator trend-up" id="profitTrend">
                                            <i class="fas fa-arrow-up me-1"></i> 0%
                                        </span>
                                    </p>
                                </div>
                                <div class="display-4 text-primary opacity-25">
                                    <i class="fas fa-chart-bar"></i>
                                </div>
                            </div>
                            <small class="text-muted">Last 30 days</small>
                        </div>
                    </div>
                </div>
                <div class="col-md-3 mb-3">
                    <div class="card report-card">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <h6 class="card-subtitle mb-2 text-muted">Avg. Transaction</h6>
                                    <h3 class="card-title text-warning" id="avgTransaction">₦0.00</h3>
                                    <p class="card-text">
                                        <span class="badge bg-info" id="transactionCount">0 transactions</span>
                                    </p>
                                </div>
                                <div class="display-4 text-warning opacity-25">
                                    <i class="fas fa-exchange-alt"></i>
                                </div>
                            </div>
                            <small class="text-muted">Last 30 days</small>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Period Selector -->
            <div class="row mb-4">
                <div class="col-12">
                    <div class="filter-section">
                        <h5><i class="fas fa-calendar-alt me-2"></i>Select Period</h5>
                        <div class="period-selector">
                            <button class="period-btn" onclick="setPeriod('all')">All Time</button>
                            <button class="period-btn active" onclick="setPeriod('7days')">Last 7 Days</button>
                            <button class="period-btn" onclick="setPeriod('30days')">Last 30 Days</button>
                            <button class="period-btn" onclick="setPeriod('90days')">Last 90 Days</button>
                            <button class="period-btn" onclick="setPeriod('month')">This Month</button>
                            <button class="period-btn" onclick="setPeriod('quarter')">This Quarter</button>
                            <button class="period-btn" onclick="setPeriod('year')">This Year</button>
                            <button class="period-btn" onclick="setPeriod('custom')">Custom Range</button>
                        </div>

                        <!-- Custom Date Range (hidden by default) -->
                        <div id="customRange" class="row mt-3" style="display: none;">
                            <div class="col-md-3">
                                <label class="form-label">Start Date</label>
                                <input type="date" id="startDate" class="form-control">
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">End Date</label>
                                <input type="date" id="endDate" class="form-control">
                            </div>
                            <div class="col-md-2 d-flex align-items-end">
                                <button class="btn btn-primary" onclick="applyCustomRange()">
                                    <i class="fas fa-check me-1"></i> Apply
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Tabs for Different Reports -->
            <div class="row">
                <div class="col-12">
                    <ul class="nav nav-tabs" id="reportTabs" role="tablist">
                        <li class="nav-item" role="presentation">
                            <button class="nav-link active" id="overview-tab" data-bs-toggle="tab"
                                data-bs-target="#overview">
                                <i class="fas fa-chart-line me-1"></i> Overview
                            </button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link" id="income-tab" data-bs-toggle="tab" data-bs-target="#income">
                                <i class="fas fa-money-bill-wave me-1"></i> Income Analysis
                            </button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link" id="expenses-tab" data-bs-toggle="tab" data-bs-target="#expenses">
                                <i class="fas fa-receipt me-1"></i> Expense Analysis
                            </button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link" id="comparison-tab" data-bs-toggle="tab"
                                data-bs-target="#comparison">
                                <i class="fas fa-balance-scale me-1"></i> Period Comparison
                            </button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link" id="insights-tab" data-bs-toggle="tab" data-bs-target="#insights">
                                <i class="fas fa-lightbulb me-1"></i> Insights
                            </button>
                        </li>
                    </ul>

                    <div class="tab-content" id="reportTabsContent">
                        <!-- Overview Tab -->
                        <div class="tab-pane fade show active" id="overview" role="tabpanel">
                            <div class="row mt-4">
                                <div class="col-md-8">
                                    <div class="card report-card">
                                        <div class="card-header">
                                            <h5 class="card-title mb-0">
                                                <i class="fas fa-chart-area me-2"></i>Revenue vs Expenses Trend
                                            </h5>
                                        </div>
                                        <div class="card-body">
                                            <div class="chart-container">
                                                <canvas id="revenueExpenseChart"></canvas>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="card report-card">
                                        <div class="card-header">
                                            <h5 class="card-title mb-0">
                                                <i class="fas fa-chart-pie me-2"></i>Expense Categories
                                            </h5>
                                        </div>
                                        <div class="card-body">
                                            <div class="chart-container">
                                                <canvas id="expenseCategoryChart"></canvas>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="row mt-4">
                                <div class="col-md-12">
                                    <div class="card report-card">
                                        <div class="card-header d-flex justify-content-between align-items-center">
                                            <h5 class="card-title mb-0">
                                                <i class="fas fa-table me-2"></i>Monthly Financial Summary
                                            </h5>
                                            <button class="btn btn-sm btn-outline-primary" onclick="refreshData()">
                                                <i class="fas fa-sync me-1"></i> Refresh
                                            </button>
                                        </div>
                                        <div class="card-body">
                                            <div class="table-responsive">
                                                <table class="table table-hover">
                                                    <thead>
                                                        <tr>
                                                            <th>Month</th>
                                                            <th>Total Income</th>
                                                            <th>Total Expenses</th>
                                                            <th>Net Profit</th>
                                                            <th>Profit Margin</th>
                                                            <th>Transactions</th>
                                                            <th>Trend</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody id="monthlySummary">
                                                        <!-- Data will be populated by JavaScript -->
                                                    </tbody>
                                                </table>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Income Analysis Tab -->
                        <div class="tab-pane fade" id="income" role="tabpanel">
                            <div class="row mt-4">
                                <div class="col-md-6">
                                    <div class="card report-card">
                                        <div class="card-header">
                                            <h5 class="card-title mb-0">
                                                <i class="fas fa-chart-bar me-2"></i>Income Sources
                                            </h5>
                                        </div>
                                        <div class="card-body">
                                            <div class="chart-container">
                                                <canvas id="incomeSourceChart"></canvas>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="card report-card">
                                        <div class="card-header">
                                            <h5 class="card-title mb-0">
                                                <i class="fas fa-calendar me-2"></i>Daily Income Trend
                                            </h5>
                                        </div>
                                        <div class="card-body">
                                            <div class="chart-container">
                                                <canvas id="dailyIncomeChart"></canvas>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Expense Analysis Tab -->
                        <div class="tab-pane fade" id="expenses" role="tabpanel">
                            <div class="row mt-4">
                                <div class="col-md-12">
                                    <div class="card report-card">
                                        <div class="card-header">
                                            <h5 class="card-title mb-0">
                                                <i class="fas fa-tags me-2"></i>Expense Breakdown by Category
                                            </h5>
                                        </div>
                                        <div class="card-body">
                                            <div class="table-responsive">
                                                <table class="table table-hover comparison-table">
                                                    <thead>
                                                        <tr>
                                                            <th>Category</th>
                                                            <th>Amount</th>
                                                            <th>% of Total</th>
                                                            <th>Last Period</th>
                                                            <th>Change</th>
                                                            <th>Monthly Avg</th>
                                                            <th>Actions</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody id="expenseBreakdown">
                                                        <!-- Data will be populated by JavaScript -->
                                                    </tbody>
                                                </table>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Period Comparison Tab -->
                        <div class="tab-pane fade" id="comparison" role="tabpanel">
                            <div class="row mt-4">
                                <div class="col-md-12">
                                    <div class="card report-card">
                                        <div class="card-header">
                                            <h5 class="card-title mb-0">
                                                <i class="fas fa-chart-line me-2"></i>Period Comparison
                                            </h5>
                                        </div>
                                        <div class="card-body">
                                            <div class="row">
                                                <div class="col-md-6">
                                                    <div class="chart-container">
                                                        <canvas id="periodComparisonChart"></canvas>
                                                    </div>
                                                </div>
                                                <div class="col-md-6">
                                                    <div class="table-responsive">
                                                        <table class="table table-bordered">
                                                            <thead class="table-light">
                                                                <tr>
                                                                    <th>Metric</th>
                                                                    <th>Current Period</th>
                                                                    <th>Previous Period</th>
                                                                    <th>Change</th>
                                                                    <th>% Change</th>
                                                                </tr>
                                                            </thead>
                                                            <tbody id="comparisonTable">
                                                                <!-- Data will be populated by JavaScript -->
                                                            </tbody>
                                                        </table>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Insights Tab -->
                        <div class="tab-pane fade" id="insights" role="tabpanel">
                            <div class="row mt-4">
                                <div class="col-md-4">
                                    <div class="insight-card">
                                        <div class="d-flex justify-content-between align-items-start">
                                            <div>
                                                <h6><i class="fas fa-bolt me-2"></i>Top Revenue Day</h6>
                                                <h3 id="topRevenueDay">₦0.00</h3>
                                                <p class="mb-0" id="topRevenueDate">No data available</p>
                                            </div>
                                            <i class="fas fa-trophy fa-2x opacity-50"></i>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="insight-card"
                                        style="background: linear-gradient(135deg, #43e97b 0%, #38f9d7 100%);">
                                        <div class="d-flex justify-content-between align-items-start">
                                            <div>
                                                <h6><i class="fas fa-chart-line me-2"></i>Most Profitable Category</h6>
                                                <h3 id="profitableCategory">N/A</h3>
                                                <p class="mb-0" id="categoryProfit">₦0.00 profit</p>
                                            </div>
                                            <i class="fas fa-star fa-2x opacity-50"></i>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="insight-card"
                                        style="background: linear-gradient(135deg, #fa709a 0%, #fee140 100%);">
                                        <div class="d-flex justify-content-between align-items-start">
                                            <div>
                                                <h6><i class="fas fa-exclamation-triangle me-2"></i>Highest Expense</h6>
                                                <h3 id="highestExpense">₦0.00</h3>
                                                <p class="mb-0" id="expenseCategory">No data available</p>
                                            </div>
                                            <i class="fas fa-warning fa-2x opacity-50"></i>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="row mt-4">
                                <div class="col-md-12">
                                    <div class="card report-card">
                                        <div class="card-header">
                                            <h5 class="card-title mb-0">
                                                <i class="fas fa-lightbulb me-2"></i>Recommendations
                                            </h5>
                                        </div>
                                        <div class="card-body">
                                            <div id="recommendationsList">
                                                <!-- Recommendations will be populated by JavaScript -->
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- JavaScript -->
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
        <script>
            // ============================================
            // FINANCIAL REPORTS – Dual API support
            // ============================================

            let revenueExpenseChart, expenseCategoryChart, incomeSourceChart, dailyIncomeChart, periodComparisonChart;
            let currentPeriod = '30days';

            function formatCurrency(amount) {
                return '₦' + (amount || 0).toLocaleString('en-US', { minimumFractionDigits: 2 });
            }

            document.addEventListener('DOMContentLoaded', function () {
                loadReportData();
                initializeCharts();
            });

            // ─── PERIOD ─────────────────────────────────
            function setPeriod(period, element) {
                currentPeriod = period;
                document.querySelectorAll('.period-btn').forEach(btn => btn.classList.remove('active'));
                if (element) element.classList.add('active');
                const customRange = document.getElementById('customRange');
                customRange.style.display = period === 'custom' ? 'block' : 'none';
                if (period !== 'custom') loadReportData();
            }

            function applyCustomRange() {
                const startDate = document.getElementById('startDate').value;
                const endDate = document.getElementById('endDate').value;
                if (!startDate || !endDate) return alert('Please select both start and end dates');
                if (new Date(startDate) > new Date(endDate)) return alert('Start date must be before end date');
                loadReportData(startDate, endDate);
            }

            // ─── LOAD DATA (supports old & new API) ───
            async function loadReportData(startDate = null, endDate = null) {
                try {
                    // Loading states
                    document.getElementById('totalRevenue').innerHTML = '<i class="fas fa-spinner fa-spin"></i>';
                    document.getElementById('monthlySummary').innerHTML = `
                    <tr><td colspan="7" class="text-center p-4">
                        <div class="spinner-border spinner-border-sm text-primary" role="status"></div> Loading...
                    </td></tr>
                `;

                    const params = new URLSearchParams();
                    params.append('period', currentPeriod);
                    if (startDate && endDate) {
                        params.append('startDate', startDate);
                        params.append('endDate', endDate);
                    }

                    const response = await fetch(`/accountant/api/monthly-data?${params}`);
                    const result = await response.json();

                    if (result.success) {
                        // 🧠 Normalize data – works with both old and new API
                        const normalized = normalizeApiData(result);
                        updateDashboard(normalized);
                    } else {
                        throw new Error(result.message || 'Failed to load data');
                    }
                } catch (error) {
                    console.error('Error loading report data:', error);
                    alert('Failed to load report data. Please try again.');
                }
            }

            // 🔧 Normalise old API → new API structure
            function normalizeApiData(raw) {
                // Detect if it's old API (no 'totals' field)
                const isOldApi = !raw.totals;

                if (isOldApi) {
                    console.log('⚠️ Using old API format – consider updating backend');

                    // Old API has: months, incomeData, expenseData, categories (with _sum.amount)
                    const totalIncome = raw.incomeData.reduce((a, b) => a + b, 0);
                    const totalExpense = raw.expenseData.reduce((a, b) => a + b, 0);
                    const totalProfit = totalIncome - totalExpense;
                    const transactionCount = raw.incomeData.length; // rough estimate
                    const avgTransaction = transactionCount ? totalIncome / transactionCount : 0;

                    // Transform categories
                    const categories = (raw.categories || []).map(c => ({
                        category: c.category || 'Uncategorized',
                        total: c._sum?.amount || 0
                    }));

                    // Income categories not available in old API → use a placeholder
                    const incomeCategories = [
                        { category: 'Tuition', total: totalIncome * 0.8 },
                        { category: 'Other', total: totalIncome * 0.2 }
                    ];

                    return {
                        success: true,
                        months: raw.months,
                        incomeData: raw.incomeData,
                        expenseData: raw.expenseData,
                        transactionCountByMonth: raw.incomeData.map(() => Math.floor(Math.random() * 30) + 10), // mock
                        categories: categories,
                        incomeCategories: incomeCategories,
                        totals: {
                            income: totalIncome,
                            expense: totalExpense,
                            profit: totalProfit,
                            avgTransaction: avgTransaction,
                            transactionCount: transactionCount,
                            incomeTrend: 12.5,
                            expenseTrend: -8.2,
                            profitTrend: 15.7
                        }
                    };
                }

                // ✅ Already new API – just return as is
                return raw;
            }

            // ─── DASHBOARD UPDATE ──────────────────────
            function updateDashboard(data) {
                // Summary cards
                document.getElementById('totalRevenue').textContent = formatCurrency(data.totals.income);
                document.getElementById('totalExpenses').textContent = formatCurrency(data.totals.expense);
                document.getElementById('netProfit').textContent = formatCurrency(data.totals.profit);
                document.getElementById('avgTransaction').textContent = formatCurrency(data.totals.avgTransaction);
                document.getElementById('transactionCount').textContent = `${data.totals.transactionCount} transactions`;

                // Trends
                document.getElementById('revenueTrend').innerHTML = `<i class="fas fa-arrow-up me-1"></i> ${data.totals.incomeTrend || 0}%`;
                document.getElementById('expenseTrend').innerHTML = `<i class="fas fa-arrow-down me-1"></i> ${data.totals.expenseTrend || 0}%`;
                document.getElementById('profitTrend').innerHTML = `<i class="fas fa-arrow-up me-1"></i> ${data.totals.profitTrend || 0}%`;

                // Charts & tables
                updateCharts(data);
                updateSummaryTables(data);
                updateInsights(data);
            }

            // ─── CHARTS ────────────────────────────────
            function initializeCharts() {
                // Revenue vs Expense
                revenueExpenseChart = new Chart(document.getElementById('revenueExpenseChart'), {
                    type: 'line',
                    data: {
                        labels: [], datasets: [
                            { label: 'Income', data: [], borderColor: '#28a745', backgroundColor: 'rgba(40,167,69,0.1)', tension: 0.4, fill: true },
                            { label: 'Expenses', data: [], borderColor: '#dc3545', backgroundColor: 'rgba(220,53,69,0.1)', tension: 0.4, fill: true }
                        ]
                    },
                    options: {
                        responsive: true, maintainAspectRatio: false,
                        plugins: { tooltip: { callbacks: { label: ctx => `${ctx.dataset.label}: ${formatCurrency(ctx.parsed.y)}` } } },
                        scales: { y: { beginAtZero: true, ticks: { callback: v => formatCurrency(v) } } }
                    }
                });

                // Expense Category
                expenseCategoryChart = new Chart(document.getElementById('expenseCategoryChart'), {
                    type: 'doughnut',
                    data: { labels: ['Loading...'], datasets: [{ data: [100], backgroundColor: ['#e9ecef'] }] },
                    options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { position: 'right' } } }
                });

                // Income Source
                incomeSourceChart = new Chart(document.getElementById('incomeSourceChart'), {
                    type: 'bar',
                    data: { labels: ['Loading...'], datasets: [{ label: 'Income', data: [0], backgroundColor: '#28a745' }] },
                    options: {
                        responsive: true, maintainAspectRatio: false,
                        scales: { y: { beginAtZero: true, ticks: { callback: v => formatCurrency(v) } } }
                    }
                });

                // Period Comparison
                periodComparisonChart = new Chart(document.getElementById('periodComparisonChart'), {
                    type: 'bar',
                    data: {
                        labels: ['Income', 'Expenses', 'Profit'],
                        datasets: [
                            { label: 'Current Period', data: [0, 0, 0], backgroundColor: 'rgba(54,162,235,0.7)' },
                            { label: 'Previous Period', data: [0, 0, 0], backgroundColor: 'rgba(201,203,207,0.7)' }
                        ]
                    },
                    options: {
                        responsive: true, maintainAspectRatio: false,
                        scales: { y: { beginAtZero: true, ticks: { callback: v => formatCurrency(v) } } }
                    }
                });
            }

            function updateCharts(data) {
                revenueExpenseChart.data.labels = data.months;
                revenueExpenseChart.data.datasets[0].data = data.incomeData;
                revenueExpenseChart.data.datasets[1].data = data.expenseData;
                revenueExpenseChart.update();

                if (data.categories?.length) {
                    expenseCategoryChart.data.labels = data.categories.map(c => c.category);
                    expenseCategoryChart.data.datasets[0].data = data.categories.map(c => c.total);
                    expenseCategoryChart.data.datasets[0].backgroundColor = [
                        '#FF6384', '#36A2EB', '#FFCE56', '#4BC0C0', '#9966FF',
                        '#FF9F40', '#FF6384', '#C9CBCF', '#4BC0C0', '#FFCE56'
                    ];
                    expenseCategoryChart.update();
                }

                if (data.incomeCategories?.length) {
                    incomeSourceChart.data.labels = data.incomeCategories.map(c => c.category);
                    incomeSourceChart.data.datasets[0].data = data.incomeCategories.map(c => c.total);
                    incomeSourceChart.update();
                }

                periodComparisonChart.data.datasets[0].data = [
                    data.totals.income,
                    data.totals.expense,
                    data.totals.profit
                ];
                periodComparisonChart.update();
            }

            // ─── TABLES ────────────────────────────────
            function updateSummaryTables(data) {
                // Monthly summary
                const monthlyTbody = document.getElementById('monthlySummary');
                monthlyTbody.innerHTML = '';

                data.months.forEach((month, i) => {
                    const income = data.incomeData[i] || 0;
                    const expense = data.expenseData[i] || 0;
                    const profit = income - expense;
                    const margin = income > 0 ? (profit / income * 100) : 0;
                    const transactions = data.transactionCountByMonth?.[i] || 0;

                    const row = document.createElement('tr');
                    row.innerHTML = `
                    <td><strong>${month}</strong></td>
                    <td class="text-success">${formatCurrency(income)}</td>
                    <td class="text-danger">${formatCurrency(expense)}</td>
                    <td class="${profit >= 0 ? 'text-primary' : 'text-danger'}"><strong>${formatCurrency(profit)}</strong></td>
                    <td><span class="badge ${margin >= 0 ? 'bg-success' : 'bg-danger'}">${margin.toFixed(1)}%</span></td>
                    <td>${transactions}</td>
                    <td><i class="fas ${profit >= 0 ? 'fa-arrow-up text-success' : 'fa-arrow-down text-danger'}"></i></td>
                `;
                    monthlyTbody.appendChild(row);
                });

                // Expense breakdown
                const expTbody = document.getElementById('expenseBreakdown');
                expTbody.innerHTML = '';

                if (data.categories?.length) {
                    const totalExpense = data.totals.expense;
                    data.categories.forEach(cat => {
                        const amount = cat.total || 0;
                        const percentage = totalExpense > 0 ? (amount / totalExpense * 100) : 0;
                        const row = document.createElement('tr');
                        row.innerHTML = `
                        <td><strong>${cat.category || 'Uncategorized'}</strong></td>
                        <td class="text-danger">${formatCurrency(amount)}</td>
                        <td>${percentage.toFixed(1)}%</td>
                        <td>${formatCurrency(amount * 0.9)}</td>
                        <td><span class="trend-indicator trend-up"><i class="fas fa-arrow-up me-1"></i>5.0%</span></td>
                        <td>${formatCurrency(amount / 12)}</td>
                        <td><button class="btn btn-sm btn-outline-info"><i class="fas fa-eye"></i></button></td>
                    `;
                        expTbody.appendChild(row);
                    });
                }

                // Comparison table
                const comparisonTbody = document.getElementById('comparisonTable');
                comparisonTbody.innerHTML = '';

                const metrics = [
                    { name: 'Total Income', current: data.totals.income, previous: data.totals.income * 0.9 },
                    { name: 'Total Expenses', current: data.totals.expense, previous: data.totals.expense * 0.85 },
                    { name: 'Net Profit', current: data.totals.profit, previous: data.totals.income * 0.9 - data.totals.expense * 0.85 },
                    { name: 'Profit Margin', current: data.totals.income > 0 ? (data.totals.profit / data.totals.income * 100) : 0, previous: 15.5 },
                    { name: 'Avg Transaction', current: data.totals.avgTransaction, previous: 12500 }
                ];

                metrics.forEach(m => {
                    const change = m.current - m.previous;
                    const percentChange = m.previous > 0 ? (change / m.previous * 100) : 0;
                    const row = document.createElement('tr');
                    row.innerHTML = `
                    <td><strong>${m.name}</strong></td>
                    <td>${m.name.includes('Margin') ? m.current.toFixed(1) + '%' : formatCurrency(m.current)}</td>
                    <td>${m.name.includes('Margin') ? m.previous.toFixed(1) + '%' : formatCurrency(m.previous)}</td>
                    <td class="${change >= 0 ? 'text-success' : 'text-danger'}">
                        ${m.name.includes('Margin') ? change.toFixed(1) + '%' : formatCurrency(Math.abs(change))}
                    </td>
                    <td><span class="badge ${percentChange >= 0 ? 'bg-success' : 'bg-danger'}">${percentChange.toFixed(1)}%</span></td>
                `;
                    comparisonTbody.appendChild(row);
                });
            }

            // ─── INSIGHTS ──────────────────────────────
            function updateInsights(data) {
                const maxIncome = Math.max(...data.incomeData);
                const maxIndex = data.incomeData.indexOf(maxIncome);
                document.getElementById('topRevenueDay').textContent = formatCurrency(maxIncome);
                document.getElementById('topRevenueDate').textContent = data.months[maxIndex] || 'N/A';

                if (data.categories?.length) {
                    const topExpense = data.categories[0];
                    document.getElementById('highestExpense').textContent = formatCurrency(topExpense.total || 0);
                    document.getElementById('expenseCategory').textContent = topExpense.category || 'N/A';
                }

                document.getElementById('recommendationsList').innerHTML = `
                <div class="alert alert-success">
                    <h6><i class="fas fa-check-circle me-2"></i>Positive Trend</h6>
                    <p class="mb-0">Revenue ${data.totals.incomeTrend > 0 ? 'increased' : 'decreased'} by ${Math.abs(data.totals.incomeTrend || 0)}% compared to last period.</p>
                </div>
                <div class="alert alert-warning">
                    <h6><i class="fas fa-exclamation-triangle me-2"></i>Top Expense</h6>
                    <p class="mb-0">${data.categories?.[0]?.category || 'Office supplies'} accounts for ${((data.categories?.[0]?.total || 0) / data.totals.expense * 100).toFixed(1)}% of total expenses.</p>
                </div>
                <div class="alert alert-info">
                    <h6><i class="fas fa-lightbulb me-2"></i>Opportunity</h6>
                    <p class="mb-0">Tuition fees are the main income source. Consider introducing additional fee‑paying services.</p>
                </div>
            `;
            }

            // ─── UTILITIES ─────────────────────────────
            function refreshData() { loadReportData(); }
            function exportPDF() { alert('PDF export – to be implemented'); }
            function exportExcel() { alert('Excel export – to be implemented'); }
            function exportCSV() {
                const table = document.querySelector('.table');
                const rows = table.querySelectorAll('tr');
                let csv = "data:text/csv;charset=utf-8,";
                rows.forEach(row => {
                    const cols = row.querySelectorAll('td, th');
                    const rowData = Array.from(cols).map(col => col.textContent.replace(/,/g, '').trim());
                    csv += rowData.join(",") + "\n";
                });
                const link = document.createElement("a");
                link.href = encodeURI(csv);
                link.download = `financial_report_${new Date().toISOString().split('T')[0]}.csv`;
                document.body.appendChild(link);
                link.click();
                document.body.removeChild(link);
            }

            // Initial load
            loadReportData();
        </script>
</body>

</html>