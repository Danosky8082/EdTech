<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= title %>
    </title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
</head>

<body>
<%- include('../partials/navbar') %>

    <div class="container mt-4">
        <h2>Attendance Records</h2>

        <!-- Filters -->
        <div class="card mb-4">
            <div class="card-body">
                <form method="GET" class="row g-3">
                    <div class="col-md-3">
                        <label class="form-label">Class</label>
                        <select name="classId" class="form-select">
                            <option value="">All Classes</option>
                            <% classes.forEach(c=> { %>
                                <option value="<%= c.id %>" <%=filters.classId===c.id ? 'selected' : '' %>>
                                    <%= c.name %>
                                </option>
                                <% }) %>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Student</label>
                        <select name="studentId" class="form-select">
                            <option value="">All Students</option>
                            <% students.forEach(s=> { %>
                                <option value="<%= s.id %>" <%=filters.studentId===s.id ? 'selected' : '' %>>
                                    <%= s.user.firstName %>
                                        <%= s.user.lastName %>
                                </option>
                                <% }) %>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Date From</label>
                        <input type="date" name="dateFrom" class="form-control" value="<%= filters.dateFrom || '' %>">
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Date To</label>
                        <input type="date" name="dateTo" class="form-control" value="<%= filters.dateTo || '' %>">
                    </div>
                    <div class="col-12">
                        <button type="submit" class="btn btn-primary"><i class="fas fa-filter"></i> Apply</button>
                        <a href="/admin/attendance" class="btn btn-secondary"><i class="fas fa-redo"></i> Reset</a>
                    </div>
                </form>
            </div>
        </div>

        <!-- Table -->
        <div class="card">
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Date</th>
                                <th>Student</th>
                                <th>Class</th>
                                <th>Status</th>
                                <th>Recorded By</th>
                                <th>Notes</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (attendances && attendances.length> 0) { %>
                                <% attendances.forEach(a=> { %>
                                    <tr>
                                        <td>
                                            <%= new Date(a.date).toLocaleDateString() %>
                                        </td>
                                        <td>
                                            <%= a.student.user.firstName %>
                                                <%= a.student.user.lastName %>
                                        </td>
                                        <td>
                                            <%= a.class ? a.class.name : 'N/A' %>
                                        </td>
                                        <td><span
                                                class="badge bg-<%= a.status === 'present' ? 'success' : a.status === 'late' ? 'warning' : 'danger' %>">
                                                <%= a.status %>
                                            </span></td>
                                        <td>
                                            <%= a.recorder ? a.recorder.firstName + ' ' + a.recorder.lastName : '-' %>
                                        </td>
                                        <td>
                                            <%= a.notes || '-' %>
                                        </td>
                                    </tr>
                                    <% }) %>
                                        <% } else { %>
                                            <tr>
                                                <td colspan="6" class="text-center">No attendance records found.</td>
                                            </tr>
                                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>