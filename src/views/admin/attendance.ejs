<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= title %>
    </title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <style>
        body {
            background: #f8f9fa;
        }

        .card {
            border: none;
            box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075);
            border-radius: 10px;
        }

        .card-header {
            background: linear-gradient(135deg, #6a11cb 0%, #2575fc 100%);
            color: white;
            border-radius: 10px 10px 0 0;
            padding: 12px 20px;
        }

        .table thead th {
            background: #f1f2f6;
            color: #2d3436;
            font-weight: 600;
            border-bottom: 2px solid #6a11cb;
        }

        .table tbody tr:hover {
            background-color: #f8f9fa;
        }

        .badge {
            font-size: 0.8rem;
            padding: 5px 12px;
            border-radius: 20px;
        }

        .btn-clear {
            background: #ff4757;
            color: white;
            border: none;
        }

        .btn-clear:hover {
            background: #ff2f46;
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(255, 71, 87, 0.4);
        }

        .btn-reset-all {
            background: #e17055;
            color: white;
            border: none;
        }

        .btn-reset-all:hover {
            background: #d63031;
            transform: translateY(-2px);
        }

        .filter-section {
            background: white;
            padding: 15px;
            border-radius: 10px;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
            margin-bottom: 20px;
        }

        .page-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 1.5rem;
            flex-wrap: wrap;
        }

        .page-header h2 {
            font-weight: 700;
            color: #2d3436;
        }

        .page-header h2 i {
            color: #6a11cb;
            margin-right: 10px;
        }

        .status-present {
            background: #00b894;
        }

        .status-late {
            background: #fdcb6e;
            color: #2d3436;
        }

        .status-absent {
            background: #ff7675;
        }

        .status-auto-absent {
            background: #dfe6e9;
            color: #2d3436;
            font-style: italic;
        }
    </style>
</head>

<body>

    <%- include('../partials/navbar') %>

        <div class="container mt-4">

            <div class="page-header">
                <h2><i class="fas fa-clipboard-list"></i> Attendance Records</h2>
                <div>
                    <% if (isSuperAdmin || userRole==='admin' ) { %>
                        <button class="btn btn-clear" onclick="clearToday()">
                            <i class="fas fa-trash-alt me-1"></i> Clear Today
                        </button>
                        <button class="btn btn-reset-all ms-2" onclick="resetAll()">
                            <i class="fas fa-database me-1"></i> Reset All
                        </button>
                        <% } %>
                            <a href="/admin/attendance-report" class="btn btn-info ms-2">
                                <i class="fas fa-chart-bar me-1"></i> Monthly Report
                            </a>
                </div>
            </div>

            <div class="filter-section">
                <form method="GET" class="row g-3">
                    <div class="col-md-3">
                        <label class="form-label"><i class="fas fa-chalkboard me-1"></i> Class</label>
                        <select name="classId" class="form-select">
                            <option value="">All Classes</option>
                            <% classes.forEach(c=> { %>
                                <option value="<%= c.id %>" <%=filters.classId===c.id ? 'selected' : '' %>><%= c.name %>
                                </option>
                                <% }) %>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label"><i class="fas fa-user-graduate me-1"></i> Student</label>
                        <select name="studentId" class="form-select">
                            <option value="">All Students</option>
                            <% students.forEach(s=> { %>
                                <option value="<%= s.id %>" <%=filters.studentId===s.id ? 'selected' : '' %>>
                                    <%= s.user.firstName %>
                                        <%= s.user.lastName %>
                                </option>
                                <% }) %>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label"><i class="fas fa-calendar-day me-1"></i> Date From</label>
                        <input type="date" name="dateFrom" class="form-control" value="<%= filters.dateFrom || '' %>">
                    </div>
                    <div class="col-md-3">
                        <label class="form-label"><i class="fas fa-calendar-day me-1"></i> Date To</label>
                        <input type="date" name="dateTo" class="form-control" value="<%= filters.dateTo || '' %>">
                    </div>
                    <div class="col-12">
                        <button type="submit" class="btn btn-primary"><i class="fas fa-filter me-1"></i> Apply
                            Filters</button>
                        <a href="/admin/attendance" class="btn btn-secondary"><i class="fas fa-redo me-1"></i> Reset</a>
                    </div>
                </form>
            </div>

            <div class="card">
                <div class="card-header">
                    <i class="fas fa-table me-2"></i> Attendance Records
                    <span class="badge bg-light text-dark ms-2">
                        <%= attendances ? attendances.length : 0 %> entries
                    </span>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-striped mb-0">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>Date</th>
                                    <th>Student</th>
                                    <th>Class</th>
                                    <th>Status</th>
                                    <th>Recorded By</th>
                                    <th>Notes</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% if (attendances && attendances.length> 0) { %>
                                    <% attendances.forEach((a, index)=> { %>
                                        <tr>
                                            <td>
                                                <%= index+1 %>
                                            </td>
                                            <td>
                                                <%= new Date(a.date).toLocaleDateString('en-US', { weekday:'short',
                                                    year:'numeric', month:'short', day:'numeric' }) %>
                                            </td>
                                            <td><strong>
                                                    <%= a.student.user.firstName %>
                                                        <%= a.student.user.lastName %>
                                                </strong><br><small class="text-muted">
                                                    <%= a.student.user.idNumber %>
                                                </small></td>
                                            <td>
                                                <%= a.class ? a.class.name : 'N/A' %>
                                            </td>
                                            <td>
                                                <% let badgeClass='' ; let statusText=a.status; if (a.status==='present'
                                                    ) badgeClass='status-present' ; else if (a.status==='late' )
                                                    badgeClass='status-late' ; else if (a.status==='absent' ) { if
                                                    (a.notes && a.notes.includes('Auto-absent')) {
                                                    badgeClass='status-auto-absent' ; statusText='Auto-absent' ; } else
                                                    { badgeClass='status-absent' ; } } else { badgeClass='status-absent'
                                                    ; } %>
                                                    <span class="badge <%= badgeClass %>">
                                                        <i
                                                            class="fas <%= a.status === 'present' ? 'fa-check-circle' : a.status === 'late' ? 'fa-clock' : 'fa-times-circle' %> me-1"></i>
                                                        <%= statusText.charAt(0).toUpperCase() + statusText.slice(1) %>
                                                    </span>
                                            </td>
                                            <td>
                                                <%= a.recorder ? a.recorder.firstName+' '+a.recorder.lastName : '
                                                    System' %>
                                            </td>
                                            <td>
                                                <%= a.notes || '-' %>
                                            </td>
                                        </tr>
                                        <% }) %>
                                            <% } else { %>
                                                <tr>
                                                    <td colspan="7" class="text-center py-4"><i
                                                            class="fas fa-inbox fa-2x text-muted d-block mb-2"></i>No
                                                        attendance records found.</td>
                                                </tr>
                                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
            <div class="mt-3 text-muted small text-center">
                <i class="fas fa-info-circle me-1"></i> Students without a record are shown as
                <strong>Auto-absent</strong> (absent by default).
            </div>
        </div>

        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
        <script>
            async function clearToday() {
                if (!confirm('⚠️ Delete ALL attendance records for TODAY?')) return;
                try {
                    const res = await fetch('/admin/attendance/clear-today', { method: 'POST' });
                    const data = await res.json();
                    if (data.success) { alert('✅ ' + data.message); location.reload(); }
                    else alert('❌ ' + data.message);
                } catch (e) { alert('❌ Error: ' + e.message); }
            }
            async function resetAll() {
                if (!confirm('⚠️ DELETE ALL attendance records (ALL dates)?')) return;
                try {
                    const res = await fetch('/admin/attendance/reset-all', { method: 'POST' });
                    const data = await res.json();
                    if (data.success) { alert('✅ ' + data.message); location.reload(); }
                    else alert('❌ ' + data.message);
                } catch (e) { alert('❌ Error: ' + e.message); }
            }
        </script>
</body>

</html>