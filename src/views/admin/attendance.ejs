<%- include('../partials/navbar') %>

    <div class="container mt-4">
        <div class="d-flex justify-content-between align-items-center">
            <h2>Attendance Records</h2>
            <div>
                <% if (isSuperAdmin || userRole==='admin' ) { %>
                    <button class="btn btn-danger btn-sm" onclick="clearToday()">
                        <i class="fas fa-trash me-1"></i> Clear Today's Attendance
                    </button>
                    <% } %>
            </div>
        </div>

        <!-- Filters -->
        <div class="card mb-4">
            <div class="card-body">
                <form method="GET" class="row g-3">
                    <div class="col-md-3">
                        <label class="form-label">Class</label>
                        <select name="classId" class="form-select">
                            <option value="">All Classes</option>
                            <% classes.forEach(c=> { %>
                                <option value="<%= c.id %>" <%=filters.classId===c.id ? 'selected' : '' %>>
                                    <%= c.name %>
                                </option>
                                <% }) %>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Student</label>
                        <select name="studentId" class="form-select">
                            <option value="">All Students</option>
                            <% students.forEach(s=> { %>
                                <option value="<%= s.id %>" <%=filters.studentId===s.id ? 'selected' : '' %>>
                                    <%= s.user.firstName %>
                                        <%= s.user.lastName %>
                                </option>
                                <% }) %>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Date From</label>
                        <input type="date" name="dateFrom" class="form-control" value="<%= filters.dateFrom || '' %>">
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Date To</label>
                        <input type="date" name="dateTo" class="form-control" value="<%= filters.dateTo || '' %>">
                    </div>
                    <div class="col-12">
                        <button type="submit" class="btn btn-primary"><i class="fas fa-filter"></i> Apply</button>
                        <a href="/admin/attendance" class="btn btn-secondary"><i class="fas fa-redo"></i> Reset</a>
                    </div>
                </form>
            </div>
        </div>

        <!-- Table -->
        <div class="card">
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Date</th>
                                <th>Student</th>
                                <th>Class</th>
                                <th>Status</th>
                                <th>Recorded By</th>
                                <th>Notes</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (attendances && attendances.length> 0) { %>
                                <% attendances.forEach(a=> { %>
                                    <tr>
                                        <td>
                                            <%= new Date(a.date).toLocaleDateString() %>
                                        </td>
                                        <td>
                                            <%= a.student.user.firstName %>
                                                <%= a.student.user.lastName %>
                                        </td>
                                        <td>
                                            <%= a.class ? a.class.name : 'N/A' %>
                                        </td>
                                        <td><span
                                                class="badge bg-<%= a.status === 'present' ? 'success' : a.status === 'late' ? 'warning' : 'danger' %>">
                                                <%= a.status %>
                                            </span></td>
                                        <td>
                                            <%= a.recorder ? a.recorder.firstName + ' ' + a.recorder.lastName : '-' %>
                                        </td>
                                        <td>
                                            <%= a.notes || '-' %>
                                        </td>
                                    </tr>
                                    <% }) %>
                                        <% } else { %>
                                            <tr>
                                                <td colspan="6" class="text-center">No attendance records found.</td>
                                            </tr>
                                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <script>
        async function clearToday() {
            if (!confirm('⚠️ This will delete ALL attendance records for TODAY. Are you sure?')) return;
            try {
                const res = await fetch('/admin/attendance/clear-today', { method: 'POST' });
                const data = await res.json();
                if (data.success) {
                    alert('✅ Today\'s attendance cleared. Refresh the page.');
                    location.reload();
                } else {
                    alert('❌ ' + data.message);
                }
            } catch (e) {
                alert('❌ Error: ' + e.message);
            }
        }
    </script>