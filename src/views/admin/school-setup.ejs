<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>School ID Setup</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>

<body>
    <%- include('../partials/navbar') %>
        <div class="container mt-5">
            <h2>ID Format Setup for <strong>
                    <%= school %>
                </strong></h2>
            <p>Configure how user IDs (for students, teachers, etc.) will be generated automatically.</p>
            <form id="setupForm" method="post">
                <div class="mb-3">
                    <label class="form-label">ID Prefix *</label>
                    <input type="text" class="form-control" name="prefix"
                        value="<%= settings ? settings.idPrefix : 'STU' %>" required placeholder="e.g., STU, TCH, EMP">
                    <div class="form-text">This prefix will be used for all users of this school.</div>
                </div>
                <div class="mb-3">
                    <label class="form-label">Separator</label>
                    <input type="text" class="form-control" name="separator"
                        value="<%= settings ? settings.idSeparator : '-' %>" placeholder="e.g., - or /">
                </div>
                <div class="mb-3 form-check">
                    <input type="checkbox" class="form-check-input" name="includeYear" id="includeYear" <%=(settings &&
                        settings.includeYear !==undefined) ? (settings.includeYear ? 'checked' : '' ) : 'checked' %>>
                    <label class="form-check-label" for="includeYear">Include current year in ID (e.g.,
                        STU-2025-001)</label>
                </div>
                <div class="mb-3">
                    <label class="form-label">Starting Counter (optional, default 1)</label>
                    <input type="number" class="form-control" name="startingCounter"
                        value="<%= settings ? settings.idCounter : 1 %>" min="1">
                    <div class="form-text">The first number to use for the next ID.</div>
                </div>
                <button type="submit" class="btn btn-primary">Save Settings</button>
                <a href="/admin/users" class="btn btn-secondary">Skip (Manual ID only)</a>
            </form>
            <hr>
            <div id="preview" class="mt-3">
                <h5>Preview Next ID:</h5>
                <p><code id="previewId">Not configured</code></p>
            </div>
        </div>
        <script>
            document.addEventListener('DOMContentLoaded', function () {
                const form = document.getElementById('setupForm');
                const prefixInput = document.querySelector('input[name="prefix"]');
                const separatorInput = document.querySelector('input[name="separator"]');
                const includeYearCheck = document.getElementById('includeYear');
                const counterInput = document.querySelector('input[name="startingCounter"]');

                function updatePreview() {
                    const prefix = prefixInput.value || 'STU';
                    const separator = separatorInput.value || '-';
                    const includeYear = includeYearCheck.checked;
                    const counter = parseInt(counterInput.value) || 1;
                    const year = new Date().getFullYear();
                    let preview = prefix + separator + (includeYear ? year + separator : '') + String(counter).padStart(3, '0');
                    document.getElementById('previewId').textContent = preview;
                }

                [prefixInput, separatorInput, includeYearCheck, counterInput].forEach(el => {
                    el.addEventListener('input', updatePreview);
                    el.addEventListener('change', updatePreview);
                });
                updatePreview();

                form.addEventListener('submit', async function (e) {
                    e.preventDefault();
                    const formData = new FormData(this);
                    const data = Object.fromEntries(formData.entries());
                    try {
                        const response = await fetch('/admin/school-setup', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify(data)
                        });
                        const result = await response.json();
                        if (result.success) {
                            alert('Settings saved successfully!');
                            window.location.href = '/admin/users';
                        } else {
                            alert('Error: ' + result.message);
                        }
                    } catch (error) {
                        alert('Server error');
                    }
                });
            });
        </script>
</body>

</html>