<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= title %>
    </title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <style>
        body {
            background: #f8f9fa;
        }

        .card {
            border: none;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
            border-radius: 10px;
        }

        .card-header {
            background: linear-gradient(135deg, #6a11cb 0%, #2575fc 100%);
            color: white;
            border-radius: 10px 10px 0 0;
            padding: 12px 20px;
        }

        .progress {
            height: 25px;
            border-radius: 20px;
            background-color: #f1f2f6;
        }

        .progress-bar {
            font-size: 0.85rem;
            font-weight: 500;
            line-height: 25px;
        }

        .summary-box {
            background: #f8f9fa;
            border-radius: 8px;
            padding: 15px;
            margin-bottom: 15px;
        }

        .filter-section {
            background: white;
            padding: 15px;
            border-radius: 10px;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
            margin-bottom: 20px;
        }

        .table thead th {
            background: #f1f2f6;
            color: #2d3436;
            font-weight: 600;
            border-bottom: 2px solid #6a11cb;
        }
    </style>
</head>

<body>
    <%- include('../partials/navbar') %>

        <div class="container mt-4">
            <div class="d-flex justify-content-between align-items-center">
                <h2><i class="fas fa-calendar-alt me-2" style="color:#6a11cb;"></i>Monthly Attendance Report</h2>
                <a href="/admin/attendance" class="btn btn-secondary"><i class="fas fa-arrow-left me-1"></i> Back to
                    Attendance</a>
            </div>

            <div class="filter-section">
                <form id="reportForm" class="row g-3">
                    <div class="col-md-3">
                        <label class="form-label"><i class="fas fa-calendar-month me-1"></i> Month</label>
                        <input type="number" name="month" class="form-control" min="1" max="12" id="monthInput"
                            value="<%= filters.month || new Date().getMonth()+1 %>">
                    </div>
                    <div class="col-md-3">
                        <label class="form-label"><i class="fas fa-calendar-year me-1"></i> Year</label>
                        <input type="number" name="year" class="form-control" min="2020" id="yearInput"
                            value="<%= filters.year || new Date().getFullYear() %>">
                    </div>
                    <div class="col-md-3">
                        <label class="form-label"><i class="fas fa-chalkboard me-1"></i> Class</label>
                        <select name="classId" class="form-select" id="classSelect">
                            <option value="">All Classes</option>
                            <% classes.forEach(c=> { %>
                                <option value="<%= c.id %>" <%=filters.classId==c.id ? 'selected' : '' %>><%= c.name %>
                                </option>
                                <% }) %>
                        </select>
                    </div>
                    <div class="col-md-3 d-flex align-items-end">
                        <button type="submit" class="btn btn-primary w-100"><i class="fas fa-chart-bar me-1"></i>
                            Generate</button>
                    </div>
                </form>
            </div>

            <div id="reportResults">
                <div class="alert alert-info">Select a month and year, then click Generate.</div>
            </div>
        </div>

        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
        <script>
            document.getElementById('reportForm').addEventListener('submit', function (e) {
                e.preventDefault();
                const month = document.getElementById('monthInput').value;
                const year = document.getElementById('yearInput').value;
                const classId = document.getElementById('classSelect').value;
                if (!month || !year) { alert('Please enter both month and year.'); return; }
                let url = `/admin/attendance/report?month=${month}&year=${year}`;
                if (classId) url += `&classId=${classId}`;
                fetch(url)
                    .then(res => res.json())
                    .then(data => {
                        if (data.success) renderReport(data);
                        else document.getElementById('reportResults').innerHTML = `<div class="alert alert-danger">Error: ${data.message}</div>`;
                    })
                    .catch(err => document.getElementById('reportResults').innerHTML = `<div class="alert alert-danger">Network error: ${err.message}</div>`);
            });

            function renderReport(data) {
                const results = data.results;
                let html = '';
                if (!results || results.length === 0) {
                    html = `<div class="alert alert-warning">No students found for the selected filters.</div>`;
                } else {
                    html += `<div class="summary-box mb-3"><strong>Month:</strong> ${data.month} &nbsp;|&nbsp; <strong>Total Students:</strong> ${data.totalStudents}</div>`;
                    html += `<div class="table-responsive"><table class="table table-striped table-hover"><thead class="table-dark"><tr><th>#</th><th>Student</th><th>Grade/Section</th><th>Present</th><th>Absent</th><th>Total Days</th><th>Attendance Rate</th></tr></thead><tbody>`;
                    results.forEach((r, i) => {
                        const rate = parseFloat(r.attendanceRate);
                        let barColor = rate >= 80 ? 'bg-success' : rate >= 60 ? 'bg-warning' : 'bg-danger';
                        html += `<tr><td>${i + 1}</td><td>${r.studentName}</td><td>${r.grade}-${r.section}</td><td><span class="badge bg-success">${r.presentDays}</span></td><td><span class="badge bg-danger">${r.absentDays}</span></td><td>${r.totalDays}</td><td><div class="progress"><div class="progress-bar ${barColor}" role="progressbar" style="width: ${rate}%;" aria-valuenow="${rate}" aria-valuemin="0" aria-valuemax="100">${rate}%</div></div></td></tr>`;
                    });
                    html += `</tbody></table></div>`;
                }
                document.getElementById('reportResults').innerHTML = html;
            }

            // Auto‑run if filters already in URL
            window.addEventListener('DOMContentLoaded', function () {
                const month = document.getElementById('monthInput').value;
                const year = document.getElementById('yearInput').value;
                if (month && year) document.getElementById('reportForm').dispatchEvent(new Event('submit'));
            });
        </script>
</body>

</html>