                                // ============================================================
                                // 7. PROCESS FEE PAYMENT (unchanged)
                                // ============================================================
                                async function processFeePayment() {
                                    const amount = document.getElementById('paymentAmount').value;
                                    const method = document.getElementById('paymentMethod').value;
                                    const feeType = document.getElementById('feeType').value;
                                    const description = document.getElementById('paymentDescription').value;
                                    const walletBalance = <%= wallet ?wallet.balance: 0 %>;

                                    if (!amount || amount <= 0) {
                                        alert('Please enter a valid amount');
                                        return;
                                    }

                                    if (method === 'wallet' && parseFloat(amount) > walletBalance) {
                                        alert('Insufficient wallet balance. Current balance: =N=' + walletBalance.toFixed(2));
                                        return;
                                    }

                                    try {
                                        const button = document.querySelector('#feePaymentModal .btn-success');
                                        const originalText = button.innerHTML;
                                        button.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i>Processing...';
                                        button.disabled = true;

                                        const response = await fetchWithTimeout('/parent/payment', {
                                            method: 'POST',
                                            headers: {
                                                'Content-Type': 'application/json',
                                            },
                                            body: JSON.stringify({
                                                studentId: currentStudentId,
                                                amount: parseFloat(amount),
                                                paymentMethod: method,
                                                feeType: feeType,
                                                description: description || `${feeType} fee payment`
                                            })
                                        });

                                        const result = await parseJSONResponse(response);

                                        if (result.success) {
                                            const modal = bootstrap.Modal.getInstance(document.getElementById('feePaymentModal'));
                                            modal.hide();

                                            showPaymentReceiptModal(result.receiptNumber, amount, feeType, 'pending');
                                            loadTransactionHistory();
                                            loadRecentActivity();
                                            loadPendingPayments();
                                        } else {
                                            alert('Error: ' + result.message);
                                        }
                                    } catch (error) {
                                        console.error('Error:', error);
                                        if (error.name === 'AbortError') {
                                            alert('Request timeout. Please try again.');
                                        } else {
                                            alert('An error occurred while processing payment: ' + error.message);
                                        }
                                    } finally {
                                        const button = document.querySelector('#feePaymentModal .btn-success');
                                        button.innerHTML = '<i class="fas fa-lock me-2"></i>Proceed to Pay';
                                        button.disabled = false;
                                    }
                                }

                                function showPaymentReceiptModal(receiptNumber, amount, feeType, status) {
                                    const modal = document.createElement('div');
                                    modal.className = 'modal fade';
                                    modal.id = 'paymentReceiptModal';

                                    const feeTypeNames = {
                                        tuition: 'Tuition Fee',
                                        exam: 'Exam Fee',
                                        pta: 'PTA Fee',
                                        library: 'Library Fee',
                                        sports: 'Sports Fee',
                                        activity: 'Activity Fee',
                                        uniform: 'Uniform Fee',
                                        other: 'Other Fee'
                                    };

                                    modal.innerHTML = `
                <div class="modal-dialog modal-sm">
                    <div class="modal-content">
                        <div class="modal-header bg-success text-white">
                            <h5 class="modal-title">
                                <i class="fas fa-receipt me-2"></i>Payment Submitted
                            </h5>
                            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                        </div>
                        <div class="modal-body text-center">
                            <div class="mb-3">
                                <i class="fas fa-check-circle fa-3x text-success mb-3"></i>
                                <h4>Payment Submitted</h4>
                            </div>
                            <div class="mb-3">
                                <p class="mb-1">Receipt Number</p>
                                <h5 class="fw-bold">${receiptNumber}</h5>
                            </div>
                            <div class="mb-3">
                                <p class="mb-1">Fee Type</p>
                                <h6 class="text-primary">${feeTypeNames[feeType] || feeType}</h6>
                            </div>
                            <div class="mb-3">
                                <p class="mb-1">Amount</p>
                                <h4 class="text-success">=N=${parseFloat(amount).toFixed(2)}</h4>
                            </div>
                            <div class="mb-3">
                                <p class="mb-1">Status</p>
                                <span class="badge bg-${status === 'pending' ? 'warning' : 'success'}">
                                    ${status === 'pending' ? 'Pending Confirmation' : 'Confirmed'}
                                </span>
                            </div>
                            <div class="alert alert-info">
                                <i class="fas fa-info-circle me-2"></i>
                                Your ${feeTypeNames[feeType] || feeType} payment is awaiting cashier confirmation.
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                            <button type="button" class="btn btn-success" onclick="printReceipt()">
                                <i class="fas fa-print me-2"></i>Print Receipt
                            </button>
                        </div>
                    </div>
                </div>
            `;

                                    document.body.appendChild(modal);
                                    const bsModal = new bootstrap.Modal(modal);
                                    bsModal.show();

                                    modal.addEventListener('hidden.bs.modal', function () {
                                        document.body.removeChild(modal);
                                    });
