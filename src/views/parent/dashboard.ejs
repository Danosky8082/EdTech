<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>EdTech - Parent Dashboard</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
    <style>
        .dashboard-card {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            border-radius: 15px;
            border: none;
            transition: transform 0.3s ease;
        }

        .dashboard-card:hover {
            transform: translateY(-5px);
        }

        .student-card {
            border-left: 4px solid #0d6efd;
            transition: all 0.3s ease;
        }

        .student-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
        }

        .progress-bar {
            background: linear-gradient(90deg, #4facfe 0%, #00f2fe 100%);
        }

        .wallet-balance {
            font-size: 2em;
            font-weight: bold;
            color: #28a745;
        }

        .savings-card {
            border-left: 4px solid #ff6b6b;
        }

        .savings-progress {
            height: 10px;
            border-radius: 5px;
        }

        .nav-tabs .nav-link.active {
            border-bottom: 3px solid #0d6efd;
            font-weight: bold;
        }

        .subject-progress {
            height: 8px;
            border-radius: 4px;
        }

        .wallet-card {
            border-left: 4px solid #28a745;
        }

        .transaction-item {
            border-left: 3px solid #007bff;
            padding-left: 15px;
        }

        .deposit-amount {
            color: #28a745;
            font-weight: bold;
        }

        .payment-amount {
            color: #dc3545;
            font-weight: bold;
        }

        .loading-spinner {
            display: inline-block;
            width: 1rem;
            height: 1rem;
            border: 2px solid currentColor;
            border-right-color: transparent;
            border-radius: 50%;
            animation: spinner-border 0.75s linear infinite;
        }

        @keyframes spinner-border {
            to {
                transform: rotate(360deg);
            }
        }

        .transaction-history-card {
            border-left: 4px solid #6f42c1;
        }

        .savings-goal-card {
            transition: all 0.3s ease;
        }

        .savings-goal-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
        }

        .school-header {
            background-color: #f8f9fa;
            padding: 0.75rem 1rem;
            border-radius: 8px;
            margin-bottom: 1rem;
            border-left: 4px solid #0d6efd;
        }
    </style>
    
</head>

<body>
    <%- include('../partials/navbar') %>

        <!-- Flash Messages -->
        <div class="container-fluid">
            <% if (typeof messages !=='undefined' ) { %>
                <% if (messages.error) { %>
                    <div class="alert alert-danger alert-dismissible fade show mt-3" role="alert">
                        <i class="fas fa-exclamation-triangle me-2"></i>
                        <%= messages.error %>
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                    <% } %>

                        <% if (messages.success) { %>
                            <div class="alert alert-success alert-dismissible fade show mt-3" role="alert">
                                <i class="fas fa-check-circle me-2"></i>
                                <%= messages.success %>
                                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                            </div>
                            <% } %>

                                <% if (messages.warning) { %>
                                    <div class="alert alert-warning alert-dismissible fade show mt-3" role="alert">
                                        <i class="fas fa-exclamation-circle me-2"></i>
                                        <%= messages.warning %>
                                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                                    </div>
                                    <% } %>
                                        <% } %>
        </div>

        <div class="container-fluid py-4">
            <!-- Header Section -->
            <div class="row mb-4">
                <div class="col-12">
                    <div class="card dashboard-card">
                        <div class="card-body">
                            <div class="row align-items-center">
                                <div class="col-md-8">
                                    <h2 class="card-title mb-1">
                                        <i class="fas fa-user-tie me-2"></i>Welcome, <%= user.firstName %>!
                                    </h2>
                                    <p class="card-text mb-0">Parent Dashboard - Monitor your children's progress and
                                        manage payments</p>
                                </div>
                                <div class="col-md-4 text-end">
                                    <div class="wallet-balance">
                                        =N=<%= wallet ? wallet.balance.toFixed(2) : '0.00' %>
                                    </div>
                                    <small class="text-light">Wallet Balance</small>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Quick Stats -->
            <div class="row mb-4">
                <div class="col-md-3 mb-3">
                    <div class="card text-white bg-primary">
                        <div class="card-body">
                            <div class="d-flex justify-content-between">
                                <div>
                                    <h4>
                                        <% let totalStudents=0; if (studentsBySchool) {
                                            Object.keys(studentsBySchool).forEach(school=> {
                                            totalStudents += studentsBySchool[school].length;
                                            });
                                            }
                                            %>
                                            <%= totalStudents %>
                                    </h4>
                                    <p>Linked Students</p>
                                </div>
                                <div class="align-self-center">
                                    <i class="fas fa-users fa-2x"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-3 mb-3">
                    <div class="card text-white bg-success">
                        <div class="card-body">
                            <div class="d-flex justify-content-between">
                                <div>
                                    <h4>=N=<%= totalSavings ? totalSavings.toFixed(2) : '0.00' %>
                                    </h4>
                                    <p>Total Savings</p>
                                </div>
                                <div class="align-self-center">
                                    <i class="fas fa-piggy-bank fa-2x"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-3 mb-3">
                    <div class="card text-white bg-warning">
                        <div class="card-body">
                            <div class="d-flex justify-content-between">
                                <div>
                                    <h4>
                                        <%= pendingPayments ? pendingPayments.length : 0 %>
                                    </h4>
                                    <p>Pending Payments</p>
                                </div>
                                <div class="align-self-center">
                                    <i class="fas fa-clock fa-2x"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-3 mb-3">
                    <div class="card text-white bg-info">
                        <div class="card-body">
                            <div class="d-flex justify-content-between">
                                <div>
                                    <h4>
                                        <%= savingsGoals ? savingsGoals.length : 0 %>
                                    </h4>
                                    <p>Active Goals</p>
                                </div>
                                <div class="align-self-center">
                                    <i class="fas fa-bullseye fa-2x"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Main Content -->
            <div class="row">
                <!-- Students List & Savings Goals -->
                <div class="col-lg-8">
                    <!-- Students List -->
                    <div class="card mb-4">
                        <div class="card-header">
                            <h5 class="card-title mb-0">
                                <i class="fas fa-graduation-cap me-2"></i>My Students
                            </h5>
                        </div>
                        <div class="card-body">
                            <% if (studentsBySchool) { %>
                                <% Object.keys(studentsBySchool).forEach(school=> { %>
                                    <div class="mb-4">
                                        <h6 class="mb-2 school-header">
                                            <i class="fas fa-school me-2"></i>
                                            <%= school %>
                                        </h6>
                                        <div class="row">
                                            <% studentsBySchool[school].forEach(studentRel=> {
                                                const student = studentRel.student;
                                                const progress = studentRel.progress;
                                                %>
                                                <div class="col-md-6 mb-4">
                                                    <div class="card student-card h-100">
                                                        <div class="card-body">
                                                            <div
                                                                class="d-flex justify-content-between align-items-start mb-3">
                                                                <div>
                                                                    <h6 class="card-title mb-1">
                                                                        <%= student.user.firstName %>
                                                                            <%= student.user.lastName %>
                                                                    </h6>
                                                                    <p class="text-muted small mb-0">
                                                                        ID: <%= student.user.idNumber %> | Grade: <%=
                                                                                student.grade %> - <%= student.section
                                                                                    %>
                                                                    </p>
                                                                    <p class="text-muted small mb-0">
                                                                        <i class="fas fa-school me-1"></i>
                                                                        <%= student.user.school || 'Unknown School' %>
                                                                    </p>
                                                                </div>
                                                                <span class="badge bg-<%= 
                                                                student.tuitionStatus === 'paid' ? 'success' : 
                                                                student.tuitionStatus === 'partial' ? 'warning' : 'danger' 
                                                            %>">
                                                                    <%= student.tuitionStatus %>
                                                                </span>
                                                            </div>

                                                            <!-- Tuition Information -->
                                                            <div class="mb-3">
                                                                <small class="text-muted">Tuition Status</small>
                                                                <div
                                                                    class="d-flex justify-content-between align-items-center">
                                                                    <span>
                                                                        <%= student.tuitionStatus.toUpperCase() %>
                                                                    </span>
                                                                    <% if (student.tuitionPayments &&
                                                                        student.tuitionPayments.length> 0) { %>
                                                                        <span class="badge bg-info">
                                                                            <%= student.tuitionPayments.length %>
                                                                                payment(s)
                                                                        </span>
                                                                        <% } %>
                                                                </div>
                                                            </div>

                                                            <!-- Actions -->
                                                            <div class="d-grid gap-2">
                                                                <button class="btn btn-outline-primary btn-sm"
                                                                    onclick="viewStudentDetails('<%= student.id %>')">
                                                                    <i class="fas fa-eye me-1"></i>View Details
                                                                </button>
                                                                <button class="btn btn-success btn-sm"
                                                                    onclick="makePayment('<%= student.id %>')">
                                                                    <i class="fas fa-money-bill me-1"></i>
                                                                    <% if (student.tuitionStatus==='paid' ) { %>
                                                                        Make Additional Payment
                                                                        <% } else { %>
                                                                            Make Payment
                                                                            <% } %>
                                                                </button>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                                <% }); %>
                                        </div>
                                    </div>
                                    <% }); %>
                                        <% } else { %>
                                            <div class="text-center py-4">
                                                <i class="fas fa-users fa-3x text-muted mb-3"></i>
                                                <h5>No Students Linked</h5>
                                                <p class="text-muted">Contact your school administrator to link students
                                                    to your account.</p>
                                            </div>
                                            <% } %>
                        </div>
                    </div>

                    <!-- Savings Goals -->
                    <div class="card">
                        <div class="card-header">
                            <h5 class="card-title mb-0">
                                <i class="fas fa-bullseye me-2"></i>My Savings Goals
                            </h5>
                        </div>
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <span>Track your savings progress for school fees</span>
                                <button class="btn btn-primary btn-sm" onclick="showCreateGoalModal()">
                                    <i class="fas fa-plus me-1"></i>New Goal
                                </button>
                            </div>

                            <% if (savingsGoals && savingsGoals.length> 0) { %>
                                <div class="row">
                                    <% savingsGoals.forEach(goal=> {
                                        const progress = (goal.currentAmount / goal.targetAmount) * 100;
                                        %>
                                        <div class="col-md-6 mb-3">
                                            <div class="card savings-goal-card h-100">
                                                <div class="card-body">
                                                    <div class="d-flex justify-content-between align-items-start mb-2">
                                                        <h6 class="card-title mb-0">
                                                            <%= goal.name %>
                                                        </h6>
                                                        <span
                                                            class="badge bg-<%= goal.isActive ? 'success' : 'secondary' %>">
                                                            <%= goal.isActive ? 'Active' : 'Completed' %>
                                                        </span>
                                                    </div>

                                                    <div class="mb-2">
                                                        <div class="d-flex justify-content-between">
                                                            <small>Progress</small>
                                                            <small>
                                                                <%= progress.toFixed(1) %>%
                                                            </small>
                                                        </div>
                                                        <div class="progress savings-progress">
                                                            <div class="progress-bar bg-success" role="progressbar"
                                                                style="width: <%= progress %>%"></div>
                                                        </div>
                                                    </div>

                                                    <div class="d-flex justify-content-between text-sm mb-2">
                                                        <span>Saved: =N=<%= goal.currentAmount.toFixed(2) %></span>
                                                        <span>Target: =N=<%= goal.targetAmount.toFixed(2) %></span>
                                                    </div>

                                                    <% if (goal.isActive) { %>
                                                        <div class="d-grid gap-1">
                                                            <button class="btn btn-outline-success btn-sm"
                                                                onclick="addToSavings('<%= goal.id %>')">
                                                                <i class="fas fa-plus me-1"></i>Add Savings
                                                            </button>
                                                            <button class="btn btn-outline-primary btn-sm"
                                                                onclick="transferToWallet('<%= goal.id %>')">
                                                                <i class="fas fa-exchange-alt me-1"></i>Transfer to
                                                                Wallet
                                                            </button>
                                                        </div>
                                                        <% } %>
                                                </div>
                                            </div>
                                        </div>
                                        <% }); %>
                                </div>
                                <% } else { %>
                                    <div class="text-center py-4">
                                        <i class="fas fa-bullseye fa-3x text-muted mb-3"></i>
                                        <h5>No Savings Goals</h5>
                                        <p class="text-muted">Create your first savings goal to start saving for school
                                            fees.</p>
                                        <button class="btn btn-primary" onclick="showCreateGoalModal()">
                                            <i class="fas fa-plus me-1"></i>Create First Goal
                                        </button>
                                    </div>
                                    <% } %>
                        </div>
                    </div>
                </div>

                <!-- Sidebar -->
                <div class="col-lg-4">
                    <!-- Quick Actions -->
                    <div class="card mb-4">
                        <div class="card-header">
                            <h6 class="card-title mb-0">
                                <i class="fas fa-bolt me-2"></i>Quick Actions
                            </h6>
                        </div>
                        <div class="card-body">
                            <div class="mb-3 p-3 bg-light rounded">
                                <div class="d-flex justify-content-between align-items-center">
                                    <span class="fw-bold">Current Balance:</span>
                                    <span class="wallet-balance fs-5">=N=<%= wallet ? wallet.balance.toFixed(2) : '0.00'
                                            %></span>
                                </div>
                            </div>

                            <div class="d-grid gap-2">
                                <button class="btn btn-outline-primary" onclick="addFundsToWallet()">
                                    <i class="fas fa-wallet me-2"></i>Add Funds to Wallet
                                </button>
                                <button class="btn btn-outline-success" onclick="showCreateGoalModal()">
                                    <i class="fas fa-bullseye me-2"></i>Create Savings Goal
                                </button>
                                <a href="/parent/progress-reports" class="btn btn-outline-info">
                                    <i class="fas fa-chart-line me-2"></i>Progress Reports
                                </a>
                                <button class="btn btn-outline-warning" onclick="contactSchool()">
                                    <i class="fas fa-envelope me-2"></i>Contact School
                                </button>
                            </div>
                        </div>
                    </div>

                    <!-- Recent Activity -->
                    <div class="card">
                        <div class="card-header">
                            <h6 class="card-title mb-0">
                                <i class="fas fa-history me-2"></i>Recent Activity
                            </h6>
                        </div>
                        <div class="card-body">
                            <div id="recentActivityList">
                                <div class="text-center">
                                    <div class="loading-spinner text-primary me-2"></div>
                                    Loading activities...
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Transaction History Section -->
            <div class="row mt-4">
                <div class="col-12">
                    <div class="card transaction-history-card">
                        <div class="card-header">
                            <h5 class="card-title mb-0">
                                <i class="fas fa-history me-2"></i>Transaction History
                            </h5>
                        </div>
                        <div class="card-body">
                            <div class="table-responsive">
                                <table class="table table-striped">
                                    <thead>
                                        <tr>
                                            <th>Date</th>
                                            <th>Description</th>
                                            <th>Type</th>
                                            <th>Amount</th>
                                            <th>Status</th>
                                        </tr>
                                    </thead>
                                    <tbody id="transactionHistory">
                                        <tr>
                                            <td colspan="5" class="text-center">
                                                <div class="loading-spinner text-primary me-2"></div>
                                                Loading transactions...
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Modals -->
        <%- include('./modals/student-details-modal') %>
            <%- include('./modals/payment-modal') %>
                <%- include('./modals/add-funds-modal') %>
                    <%- include('./modals/savings-modals') %>
                        <%- include('./modals/contact-modal') %>

                            <script>
                                // ============================================================
                                // 1. AVATAR HELPER (same as used in admin)
                                // ============================================================
                                function cleanAvatarUrl(url) {
                                    if (!url) return null;
                                    if (url.startsWith('/https:/')) return url.replace('/https:/', 'https://');
                                    if (url.startsWith('/http:/')) return url.replace('/http:/', 'http://');
                                    if (url.startsWith('http://') || url.startsWith('https://')) return url;
                                    return '/' + url;
                                }

                                // ============================================================
                                // 2. GLOBAL VARIABLES
                                // ============================================================
                                let currentStudentId = null;
                                let currentSavingsGoalId = null;

                                // ============================================================
                                // 3. HELPER: Parse JSON safely
                                // ============================================================
                                async function parseJSONResponse(response) {
                                    const text = await response.text();
                                    try {
                                        return JSON.parse(text);
                                    } catch (error) {
                                        console.error('Failed to parse JSON:', text.substring(0, 200));
                                        return { success: false, message: 'Server returned an invalid response. Please try again.' };
                                    }
                                }

                                // ============================================================
                                // 4. HELPER: Fetch with timeout
                                // ============================================================
                                async function fetchWithTimeout(url, options, timeout = 30000) {
                                    const controller = new AbortController();
                                    const timeoutId = setTimeout(() => controller.abort(), timeout);

                                    try {
                                        const response = await fetch(url, {
                                            ...options,
                                            signal: controller.signal
                                        });
                                        clearTimeout(timeoutId);
                                        return response;
                                    } catch (error) {
                                        clearTimeout(timeoutId);
                                        throw error;
                                    }
                                }

                                // ============================================================
                                // 5. VIEW STUDENT DETAILS (with avatar fix)
                                // ============================================================
                                async function viewStudentDetails(studentId) {
                                    try {
                                        const response = await fetch(`/parent/student/${studentId}`);
                                        const result = await parseJSONResponse(response);

                                        if (result.success) {
                                            const student = result.student;
                                            const modalBody = document.getElementById('studentDetailsBody');

                                            // Build avatar using the helper
                                            const avatarClean = cleanAvatarUrl(student.user.avatar);
                                            const fallbackAvatar = `https://ui-avatars.com/api/?name=${encodeURIComponent(student.user.firstName + ' ' + student.user.lastName)}&background=6a11cb&color=fff&size=100`;

                                            modalBody.innerHTML = `
                        <div class="row">
                            <div class="col-md-4 text-center">
                                ${avatarClean ?
                                                    `<img src="${avatarClean}" alt="Avatar" class="rounded-circle" width="100" height="100" onerror="this.onerror=null; this.src='${fallbackAvatar}'">` :
                                                    `<img src="${fallbackAvatar}" alt="Avatar" class="rounded-circle" width="100" height="100">`
                                                }
                                <h5 class="mt-3">${student.user.firstName} ${student.user.lastName}</h5>
                                <p class="text-muted">${student.user.idNumber}</p>
                            </div>
                            <div class="col-md-8">
                                <div class="row">
                                    <div class="col-6 mb-3">
                                        <strong>Grade:</strong> ${student.grade}
                                    </div>
                                    <div class="col-6 mb-3">
                                        <strong>Section:</strong> ${student.section}
                                    </div>
                                    <div class="col-6 mb-3">
                                        <strong>Email:</strong> ${student.user.email || 'N/A'}
                                    </div>
                                    <div class="col-6 mb-3">
                                        <strong>Date of Birth:</strong> ${student.user.dateOfBirth ? new Date(student.user.dateOfBirth).toLocaleDateString() : 'N/A'}
                                    </div>
                                    <div class="col-12 mb-3">
                                        <strong>Tuition Status:</strong>
                                        <span class="badge bg-${student.tuitionStatus === 'paid' ? 'success' : student.tuitionStatus === 'partial' ? 'warning' : 'danger'}">
                                            ${student.tuitionStatus.toUpperCase()}
                                        </span>
                                    </div>
                                </div>

                                <!-- Payment History Section -->
                                <div class="card mt-3">
                                    <div class="card-header bg-light">
                                        <h6 class="mb-0"><i class="fas fa-history me-2"></i>Payment History</h6>
                                    </div>
                                    <div class="card-body p-0">
                                        ${student.parentPayments && student.parentPayments.length > 0 ? `
                                            <div class="table-responsive">
                                                <table class="table table-hover mb-0">
                                                    <thead class="table-light">
                                                        <tr>
                                                            <th>Date</th>
                                                            <th>Fee Type</th>
                                                            <th>Description</th>
                                                            <th>Amount</th>
                                                            <th>Status</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        ${student.parentPayments.map(payment => `
                                                            <tr>
                                                                <td>${new Date(payment.createdAt).toLocaleDateString()}</td>
                                                                <td>
                                                                    <span class="badge bg-info">
                                                                        ${payment.feeType ? payment.feeType.toUpperCase() : 'TUITION'}
                                                                    </span>
                                                                </td>
                                                                <td>
                                                                    <div class="text-wrap" style="min-width: 150px;">
                                                                        ${payment.description || `Payment for ${payment.feeType || 'tuition'}`}
                                                                        ${payment.reason ? `<br><small class="text-muted">Reason: ${payment.reason}</small>` : ''}
                                                                    </div>
                                                                </td>
                                                                <td class="fw-bold">=N=${payment.amount ? payment.amount.toFixed(2) : '0.00'}</td>
                                                                <td>
                                                                    <span class="badge bg-${payment.status === 'confirmed' ? 'success' :
                                                        payment.status === 'rejected' ? 'danger' :
                                                            payment.status === 'pending' ? 'warning' : 'secondary'}">
                                                                        ${payment.status}
                                                                    </span>
                                                                    ${payment.confirmedAt ? `<br><small class="text-muted">Confirmed: ${new Date(payment.confirmedAt).toLocaleDateString()}</small>` : ''}
                                                                </td>
                                                            </tr>
                                                        `).join('')}
                                                    </tbody>
                                                </table>
                                            </div>
                                        ` : `
                                            <div class="text-center py-5">
                                                <i class="fas fa-receipt fa-3x text-muted mb-3"></i>
                                                <h6>No Payment History</h6>
                                                <p class="text-muted small">No payments have been made for this student yet.</p>
                                            </div>
                                        `}
                                    </div>
                                    ${student.parentPayments && student.parentPayments.length > 0 ? `
                                        <div class="card-footer bg-light">
