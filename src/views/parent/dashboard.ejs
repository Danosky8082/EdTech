                                async function createSavingsGoal() {
                                    const name = document.getElementById('goalName').value;
                                    const targetAmount = document.getElementById('targetAmount').value;
                                    const targetDate = document.getElementById('targetDate').value;

                                    if (!name || !targetAmount || targetAmount <= 0) {
                                        alert('Please fill in all required fields with valid values');
                                        return;
                                    }

                                    try {
                                        const button = document.querySelector('#createGoalModal .btn-success');
                                        const originalText = button.innerHTML;
                                        button.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i>Creating...';
                                        button.disabled = true;

                                        const response = await fetchWithTimeout('/parent/savings/goals', {
                                            method: 'POST',
                                            headers: {
                                                'Content-Type': 'application/json',
                                            },
                                            body: JSON.stringify({
                                                name: name,
                                                targetAmount: parseFloat(targetAmount),
                                                targetDate: targetDate || null
                                            })
                                        });

                                        const result = await parseJSONResponse(response);

                                        if (result.success) {
                                            alert('Savings goal created successfully!');
                                            const modal = bootstrap.Modal.getInstance(document.getElementById('createGoalModal'));
                                            modal.hide();
                                            location.reload();
                                        } else {
                                            alert('Error: ' + result.message);
                                        }
                                    } catch (error) {
                                        console.error('Error creating goal:', error);
                                        alert('An error occurred while creating savings goal: ' + error.message);
                                    } finally {
                                        const button = document.querySelector('#createGoalModal .btn-success');
                                        button.innerHTML = '<i class="fas fa-plus me-2"></i>Create Goal';
                                        button.disabled = false;
                                    }
                                }

                                function addToSavings(goalId) {
                                    currentSavingsGoalId = goalId;
                                    const modal = new bootstrap.Modal(document.getElementById('addToSavingsModal'));
                                    document.getElementById('savingsAmount').value = '';
                                    document.getElementById('savingsDescription').value = 'Savings deposit';
                                    modal.show();
                                }

                                async function processAddToSavings() {
                                    const amount = document.getElementById('savingsAmount').value;
                                    const description = document.getElementById('savingsDescription').value;

                                    if (!amount || amount <= 0) {
                                        alert('Please enter a valid amount');
                                        return;
                                    }

                                    if (!currentSavingsGoalId) {
                                        alert('Error: No savings goal selected');
                                        return;
                                    }

                                    try {
                                        const button = document.querySelector('#addToSavingsModal .btn-success');
                                        if (!button) {
                                            alert('Error: Could not find the submit button');
                                            return;
                                        }

                                        const originalText = button.innerHTML;
                                        button.innerHTML = '<i class="fas fa-spinner fa-spin me-1"></i>Processing...';
                                        button.disabled = true;

                                        const response = await fetchWithTimeout('/parent/savings/deposit', {
                                            method: 'POST',
                                            headers: {
                                                'Content-Type': 'application/json',
                                            },
                                            body: JSON.stringify({
                                                goalId: currentSavingsGoalId,
                                                amount: parseFloat(amount),
                                                description: description || 'Savings deposit'
                                            })
                                        });

                                        const result = await parseJSONResponse(response);

                                        if (result.success) {
                                            alert(result.message || 'Savings added successfully!');
                                            const modal = bootstrap.Modal.getInstance(document.getElementById('addToSavingsModal'));
                                            if (modal) modal.hide();
                                            location.reload();
                                        } else {
                                            alert('Error: ' + result.message);
                                            button.innerHTML = originalText;
                                            button.disabled = false;
                                        }
                                    } catch (error) {
                                        console.error('Error adding to savings:', error);
                                        alert('An error occurred while adding to savings: ' + error.message);
                                        const button = document.querySelector('#addToSavingsModal .btn-success');
                                        if (button) {
                                            button.innerHTML = '<i class="fas fa-plus me-1"></i>Add to Savings';
                                            button.disabled = false;
                                        }
                                    }
                                }

                                async function transferToWallet(goalId) {
                                    console.log('🔄 Transfer to Wallet - goalId:', goalId);

                                    try {
                                        const goalResponse = await fetchWithTimeout(`/parent/savings/goal/${goalId}`);

                                        if (!goalResponse.ok) {
                                            throw new Error(`Server error: ${goalResponse.status} ${goalResponse.statusText}`);
                                        }

                                        const goalResult = await parseJSONResponse(goalResponse);

                                        if (!goalResult.success) {
                                            alert('Error: ' + goalResult.message);
                                            return;
                                        }

                                        const goal = goalResult.goal;

                                        if (!goal.currentAmount || goal.currentAmount <= 0) {
                                            alert(`Cannot transfer: Current savings is =N=${goal.currentAmount ? goal.currentAmount.toFixed(2) : '0.00'}. Please add savings first.`);
                                            return;
                                        }

                                        if (!confirm(`Are you sure you want to transfer =N=${goal.currentAmount.toFixed(2)} from "${goal.name}" to your wallet? This will close the goal.`)) {
                                            return;
                                        }

                                        const requestBody = { goalId: goalId };

                                        const buttons = document.querySelectorAll(`button[onclick*="${goalId}"]`);
                                        let transferButton = null;

                                        buttons.forEach(btn => {
                                            if (btn.innerHTML.includes('Transfer to Wallet')) {
                                                transferButton = btn;
                                                const originalText = btn.innerHTML;
                                                btn.innerHTML = '<i class="fas fa-spinner fa-spin me-1"></i>Transferring...';
                                                btn.disabled = true;
                                            }
                                        });

                                        const response = await fetchWithTimeout('/parent/savings/transfer-to-wallet', {
                                            method: 'POST',
                                            headers: {
                                                'Content-Type': 'application/json',
                                            },
                                            body: JSON.stringify(requestBody)
                                        });

                                        if (!response.ok) {
                                            throw new Error(`Server error: ${response.status} ${response.statusText}`);
                                        }

                                        const result = await parseJSONResponse(response);

                                        if (result.success) {
                                            alert(result.message || 'Savings transferred to wallet successfully!');
                                            location.reload();
                                        } else {
                                            alert('Error: ' + result.message);
                                            if (transferButton) {
                                                transferButton.innerHTML = '<i class="fas fa-exchange-alt me-1"></i>Transfer to Wallet';
                                                transferButton.disabled = false;
                                            }
                                        }
                                    } catch (error) {
                                        console.error('Error transferring savings:', error);
                                        alert('An error occurred while transferring savings. Please check the console for details. Error: ' + error.message);
                                        const buttons = document.querySelectorAll('button');
                                        buttons.forEach(btn => {
                                            if (btn.innerHTML.includes('Transferring...')) {
                                                btn.innerHTML = '<i class="fas fa-exchange-alt me-1"></i>Transfer to Wallet';
                                                btn.disabled = false;
                                            }
                                        });
                                    }
                                }

                                // ============================================================
                                // 10. LOAD TRANSACTION HISTORY
                                // ============================================================
                                async function loadTransactionHistory() {
                                    try {
                                        const response = await fetchWithTimeout('/parent/transactions');
                                        const result = await parseJSONResponse(response);

                                        if (result.success) {
                                            const tbody = document.getElementById('transactionHistory');

                                            if (result.transactions.length === 0) {
                                                tbody.innerHTML = '<tr><td colspan="5" class="text-center">No transactions found</td></tr>';
                                                return;
                                            }

                                            tbody.innerHTML = result.transactions.map(transaction => `
                        <tr>
                            <td>${new Date(transaction.createdAt).toLocaleDateString()}</td>
                            <td>${transaction.description}</td>
                            <td>
                                <span class="badge bg-${getTransactionBadgeColor(transaction.type)}">
                                    ${transaction.type.replace('_', ' ').toUpperCase()}
                                </span>
                            </td>
                            <td class="${transaction.amount >= 0 ? 'text-success' : 'text-danger'}">
                                =N=${Math.abs(transaction.amount).toFixed(2)}
                            </td>
                            <td>
                                <span class="badge bg-${transaction.status === 'completed' ? 'success' : transaction.status === 'pending' ? 'warning' : 'secondary'}">
                                    ${transaction.status}
                                </span>
                            </td>
                        </tr>
                    `).join('');
                                        } else {
                                            const tbody = document.getElementById('transactionHistory');
                                            tbody.innerHTML = '<tr><td colspan="5" class="text-center text-danger">Error loading transactions: ' + result.message + '</td></tr>';
                                        }
                                    } catch (error) {
                                        console.error('Error loading transaction history:', error);
                                        const tbody = document.getElementById('transactionHistory');
                                        tbody.innerHTML = '<tr><td colspan="5" class="text-center text-danger">Error loading transactions: ' + error.message + '</td></tr>';
                                    }
                                }

                                // ============================================================
                                // 11. LOAD RECENT ACTIVITY
                                // ============================================================
                                async function loadRecentActivity() {
                                    try {
                                        const response = await fetchWithTimeout('/parent/recent-activity');
                                        const result = await parseJSONResponse(response);

                                        if (result.success) {
                                            const activityList = document.getElementById('recentActivityList');

                                            if (result.activities.length === 0) {
                                                activityList.innerHTML = '<p class="text-muted text-center">No recent activity</p>';
                                                return;
                                            }

                                            activityList.innerHTML = result.activities.map(activity => `
                        <div class="list-group-item px-0">
                            <div class="d-flex w-100 justify-content-between">
                                <h6 class="mb-1">${activity.title}</h6>
                                <small class="text-muted">${new Date(activity.timestamp).toLocaleDateString()}</small>
                            </div>
                            <p class="mb-1">${activity.description}</p>
                            <small class="text-muted">${activity.type}</small>
                        </div>
                    `).join('');
                                        } else {
                                            document.getElementById('recentActivityList').innerHTML = '<p class="text-muted text-center">Error loading activities: ' + result.message + '</p>';
                                        }
                                    } catch (error) {
                                        console.error('Error loading recent activity:', error);
                                        document.getElementById('recentActivityList').innerHTML = '<p class="text-muted text-center">Error loading activities: ' + error.message + '</p>';
                                    }
                                }

                                // ============================================================
                                // 12. LOAD PENDING PAYMENTS
                                // ============================================================
                                async function loadPendingPayments() {
                                    try {
                                        const response = await fetch('/parent/pending-payments');
                                        const result = await parseJSONResponse(response);

                                        if (result.success) {
                                            const pendingBadge = document.querySelector('.badge.bg-warning');
                                            if (pendingBadge && result.payments.length > 0) {
                                                pendingBadge.textContent = result.payments.length;
                                            }
                                            displayPendingPayments(result.payments);
                                        }
                                    } catch (error) {
                                        console.error('Error loading pending payments:', error);
                                    }
                                }

                                function displayPendingPayments(payments) {
                                    const tbody = document.getElementById('transactionHistory');
                                    if (!tbody) return;

                                    payments.forEach(payment => {
                                        const row = document.createElement('tr');
                                        row.innerHTML = `
                    <td>${new Date(payment.createdAt).toLocaleDateString()}</td>
                    <td>${payment.description || 'Tuition Payment'}</td>
                    <td>
                        <span class="badge bg-warning">
                            PAYMENT PENDING
                        </span>
                    </td>
                    <td class="text-danger">
                        =N=${payment.amount.toFixed(2)}
                    </td>
                    <td>
                        <span class="badge bg-warning">
                            <i class="fas fa-clock me-1"></i>Pending
                        </span>
                        <br>
                        <small class="text-muted">Receipt: ${payment.receiptNumber}</small>
                    </td>
                `;
                                        tbody.prepend(row);
                                    });
                                }

                                // ============================================================
                                // 13. UTILITY FUNCTIONS
                                // ============================================================
                                function getTransactionBadgeColor(type) {
                                    const colors = {
                                        'deposit': 'success',
                                        'withdrawal': 'danger',
                                        'payment': 'primary',
                                        'savings_deposit': 'info',
                                        'savings_transfer': 'warning'
                                    };
                                    return colors[type] || 'secondary';
                                }

                                function contactSchool() {
                                    const modal = new bootstrap.Modal(document.getElementById('contactModal'));
                                    modal.show();
                                }

                                async function sendContactMessage() {
                                    const subject = document.getElementById('contactSubject').value;
                                    const message = document.getElementById('contactMessage').value;
                                    const studentId = document.getElementById('contactStudent').value;

                                    if (!subject || !message) {
                                        alert('Please fill in all required fields');
                                        return;
                                    }

                                    try {
                                        const button = document.querySelector('#contactModal .btn-primary');
                                        const originalText = button.innerHTML;
                                        button.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i>Sending...';
                                        button.disabled = true;

                                        const response = await fetchWithTimeout('/parent/contact-school', {
                                            method: 'POST',
                                            headers: {
                                                'Content-Type': 'application/json',
                                            },
                                            body: JSON.stringify({
                                                subject: subject,
                                                message: message,
                                                studentId: studentId
                                            })
                                        });

                                        const result = await parseJSONResponse(response);

                                        if (result.success) {
                                            alert('Your message has been sent to the school. We will get back to you soon!');
                                            const modal = bootstrap.Modal.getInstance(document.getElementById('contactModal'));
                                            modal.hide();
                                        } else {
                                            alert('Error: ' + result.message);
                                        }
                                    } catch (error) {
                                        console.error('Error sending message:', error);
                                        alert('An error occurred while sending your message: ' + error.message);
                                    } finally {
                                        const button = document.querySelector('#contactModal .btn-primary');
                                        button.innerHTML = '<i class="fas fa-paper-plane me-2"></i>Send Message';
                                        button.disabled = false;
                                    }
                                }

                                function printReceipt() {
                                    window.print();
                                }

                                // ============================================================
                                // 14. DOM CONTENT LOADED
                                // ============================================================
                                document.addEventListener('DOMContentLoaded', function () {
                                    loadTransactionHistory();
                                    loadRecentActivity();
                                    loadPendingPayments();

                                    setInterval(() => {
                                        loadPendingPayments();
                                        loadTransactionHistory();
                                    }, 30000);
                                });
                            </script>
</body>

</html>