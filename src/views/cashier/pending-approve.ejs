<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Pending Approvals | School Management System</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>

<body>
    <%- include('../partials/navbar') %>

        <div class="container mt-4">
            <%- include('../partials/alerts') %>

                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h1>Pending Payments for Approval</h1>
                    <a href="/cashier/dashboard" class="btn btn-primary">Back to Dashboard</a>
                </div>

                <% if (pendingPayments && pendingPayments.length> 0) { %>
                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead>
                                <tr>
                                    <th>Date</th>
                                    <th>Parent</th>
                                    <th>Student</th>
                                    <th>Amount</th>
                                    <th>Description</th>
                                    <th>Method</th>
                                    <th>Receipt</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% pendingPayments.forEach(payment=> { %>
                                    <tr>
                                        <td>
                                            <%= new Date(payment.createdAt).toLocaleDateString() %>
                                        </td>
                                        <td>
                                            <%= payment.parent.user.firstName %>
                                                <%= payment.parent.user.lastName %>
                                        </td>
                                        <td>
                                            <%= payment.student.user.firstName %>
                                                <%= payment.student.user.lastName %>
                                        </td>
                                        <td>₦<%= payment.amount.toFixed(2) %>
                                        </td>
                                        <td>
                                            <%= payment.description || 'No description' %>
                                        </td>
                                        <td>
                                            <%= payment.paymentMethod %>
                                        </td>
                                        <td><code><%= payment.receiptNumber %></code></td>
                                        <td>
                                            <form action="/cashier/approve-payment/<%= payment.id %>" method="POST"
                                                class="d-inline">
                                                <button type="submit" class="btn btn-success btn-sm">Approve</button>
                                            </form>
                                            <a href="/cashier/payment/<%= payment.id %>"
                                                class="btn btn-info btn-sm ms-1">View</a>
                                        </td>
                                    </tr>
                                    <% }) %>
                            </tbody>
                        </table>
                    </div>
                    <% } else { %>
                        <div class="alert alert-info">
                            No pending payments found.
                        </div>
                        <% } %>
        </div>

        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>