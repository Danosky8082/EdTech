<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Payment Details | Cashier</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
</head>

<body>
    <%- include('../partials/navbar') %>

        <div class="container mt-4">
            <div class="row">
                <div class="col-12">
                    <div class="card">
                        <div class="card-header">
                            <h4 class="card-title mb-0">
                                <i class="fas fa-receipt me-2"></i>Payment Details
                            </h4>
                        </div>
                        <div class="card-body">
                            <% if (payment) { %>
                                <div class="row">
                                    <div class="col-md-6">
                                        <h6>Payment Information</h6>
                                        <table class="table table-sm">
                                            <tr>
                                                <th>Receipt Number:</th>
                                                <td><strong>
                                                        <%= payment.receiptNumber %>
                                                    </strong></td>
                                            </tr>
                                            <tr>
                                                <th>Amount:</th>
                                                <td class="text-success"><strong>₦<%= payment.amount.toFixed(2) %>
                                                            </strong></td>
                                            </tr>
                                            <tr>
                                                <th>Payment Type:</th>
                                                <td>
                                                    <span class="badge bg-info">
                                                        <%= payment.paymentType || 'tuition' %>
                                                    </span>
                                                </td>
                                            </tr>
                                            <tr>
                                                <th>Payment Method:</th>
                                                <td>
                                                    <%= payment.paymentMethod %>
                                                </td>
                                            </tr>
                                            <tr>
                                                <th>Status:</th>
                                                <td>
                                                    <% if (payment.status==='pending' ) { %>
                                                        <span class="badge bg-warning">Pending</span>
                                                        <% } else if (payment.status==='completed' ) { %>
                                                            <span class="badge bg-success">Confirmed</span>
                                                            <% } else { %>
                                                                <span class="badge bg-secondary">
                                                                    <%= payment.status %>
                                                                </span>
                                                                <% } %>
                                                </td>
                                            </tr>
                                            <tr>
                                                <th>Description:</th>
                                                <td>
                                                    <%= payment.description || 'No description' %>
                                                </td>
                                            </tr>
                                        </table>
                                    </div>
                                    <div class="col-md-6">
                                        <h6>Student Information</h6>
                                        <table class="table table-sm">
                                            <tr>
                                                <th>Student Name:</th>
                                                <td>
                                                    <%= payment.student.user.firstName %>
                                                        <%= payment.student.user.lastName %>
                                                </td>
                                            </tr>
                                            <tr>
                                                <th>Grade/Section:</th>
                                                <td>
                                                    <%= payment.student.grade %> - <%= payment.student.section %>
                                                </td>
                                            </tr>
                                            <tr>
                                                <th>Current Tuition Status:</th>
                                                <td>
                                                    <span
                                                        class="badge bg-<%= payment.student.tuitionStatus === 'paid' ? 'success' : payment.student.tuitionStatus === 'partial' ? 'warning' : 'danger' %>">
                                                        <%= payment.student.tuitionStatus %>
                                                    </span>
                                                </td>
                                            </tr>
                                        </table>

                                        <h6 class="mt-4">Parent Information</h6>
                                        <table class="table table-sm">
                                            <tr>
                                                <th>Parent Name:</th>
                                                <td>
                                                    <%= payment.parent.user.firstName %>
                                                        <%= payment.parent.user.lastName %>
                                                </td>
                                            </tr>
                                            <tr>
                                                <th>Email:</th>
                                                <td>
                                                    <%= payment.parent.user.email || 'N/A' %>
                                                </td>
                                            </tr>
                                            <tr>
                                                <th>Phone:</th>
                                                <td>
                                                    <%= payment.parent.user.phone || 'N/A' %>
                                                </td>
                                            </tr>
                                        </table>
                                    </div>
                                </div>

                                <div class="row mt-4">
                                    <div class="col-12">
                                        <div class="d-flex justify-content-between">
                                            <% if (payment.status==='pending' ) { %>
                                                <div>
                                                    <button class="btn btn-success"
                                                        onclick="approvePayment('<%= payment.id %>')">
                                                        <i class="fas fa-check me-2"></i>Approve Payment
                                                    </button>
                                                    <button class="btn btn-danger ms-2" data-bs-toggle="modal"
                                                        data-bs-target="#rejectModal">
                                                        <i class="fas fa-times me-2"></i>Reject Payment
                                                    </button>
                                                </div>
                                                <% } %>
                                                    <a href="/cashier/pending-payments" class="btn btn-secondary">
                                                        <i class="fas fa-arrow-left me-2"></i>Back to List
                                                    </a>
                                        </div>
                                    </div>
                                </div>
                                <% } else { %>
                                    <div class="alert alert-danger">
                                        Payment not found
                                    </div>
                                    <% } %>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Reject Modal -->
        <div class="modal fade" id="rejectModal" tabindex="-1">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Reject Payment</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <div class="mb-3">
                            <label class="form-label">Reason for Rejection</label>
                            <textarea class="form-control" id="rejectReason" rows="3"
                                placeholder="Enter reason for rejecting this payment"></textarea>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="button" class="btn btn-danger" onclick="rejectPayment('<%= payment.id %>')">Reject
                            Payment</button>
                    </div>
                </div>
            </div>
        </div>

        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
        <script>
            async function approvePayment(paymentId) {
                if (!confirm('Are you sure you want to approve this payment?')) return;

                try {
                    const response = await fetch(`/cashier/approve-payment/${paymentId}`, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json'
                        }
                    });

                    const result = await response.json();

                    if (result.success) {
                        alert('Payment approved successfully!');
                        window.location.href = '/cashier/pending-payments';
                    } else {
                        alert('Error: ' + result.message);
                    }
                } catch (error) {
                    console.error('Error:', error);
                    alert('An error occurred while approving payment');
                }
            }

            async function rejectPayment(paymentId) {
                const reason = document.getElementById('rejectReason').value;

                if (!reason.trim()) {
                    alert('Please provide a reason for rejection');
                    return;
                }

                if (!confirm('Are you sure you want to reject this payment?')) return;

                try {
                    const response = await fetch(`/cashier/payment/${paymentId}/reject`, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json'
                        },
                        body: JSON.stringify({ reason: reason })
                    });

                    const result = await response.json();

                    if (result.success) {
                        alert('Payment rejected successfully!');
                        window.location.href = '/cashier/pending-payments';
                    } else {
                        alert('Error: ' + result.message);
                    }
                } catch (error) {
                    console.error('Error:', error);
                    alert('An error occurred while rejecting payment');
                }
            }
        </script>
</body>

</html>