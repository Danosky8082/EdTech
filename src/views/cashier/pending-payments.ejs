<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= title %> | School Management System
    </title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>

<body>

    <%- include('../partials/navbar') %>
    
        <div class="container mt-4">
            <%- include('../partials/alerts') %>
    <div class="container mt-4">
        <h1>
            <%= title %>
        </h1>
        <a href="/cashier/dashboard" class="btn btn-primary mb-3">Back to Dashboard</a>

        <% if (pendingPayments && pendingPayments.length> 0) { %>
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Parent</th>
                            <th>Student</th>
                            <th>Fee Type</th>
                            <th>Amount</th>
                            <th>Description</th>
                            <th>Method</th>
                            <th>Receipt</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% pendingPayments.forEach(payment=> { %>
                            <tr>
                                <td>
                                    <%= new Date(payment.createdAt).toLocaleDateString() %>
                                </td>
                                <td>
                                    <%= payment.parent.user.firstName %>
                                        <%= payment.parent.user.lastName %>
                                </td>
                                <td>
                                    <%= payment.student.user.firstName %>
                                        <%= payment.student.user.lastName %>
                                </td>
                                <td>
                                    <!-- <span class="badge bg-${getFeeTypeBadgeColor(payment.feeType)}"> -->
                                        <%= payment.feeType %>
                                        <!-- //${formatFeeType(payment.feeType)} -->
                                    </span>
                                </td>
                                <td>₦<%= payment.amount.toFixed(2) %>
                                </td>
                                <td>
                                    <%= payment.description || 'No description' %>
                                </td>
                                <td>
                                    <%= payment.paymentMethod %>
                                </td>
                                <td><code><%= payment.receiptNumber %></code></td>
                                <td>
                                    <form action="/cashier/approve-payment/<%= payment.id %>" method="POST"
                                        class="d-inline">
                                        <button type="submit" class="btn btn-success btn-sm">Approve</button>
                                    </form>
                                </td>
                                <!-- <td>
                                    <a href="/cashier/payment/<%= payment.id %>" class="btn btn-success btn-sm">
                                        <i class="fas fa-eye me-1"></i>View & Process
                                    </a>
                                </td> -->
                            </tr>
                            <% }) %>
                    </tbody>
                </table>
            </div>
            <% } else { %>
                <div class="alert alert-info">
                    No pending payments found.
                </div>
                <% } %>
    </div>
</body>



</html>